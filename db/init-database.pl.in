use strict;

our $launched_db = 0;
# All files should be installed in $DESTDIR provided through the command line.
our $destdir = @ARGV[0];
our $datadir = "$destdir@mysql_datadir@";
our $socket = "$destdir@mysql_socket@";
our $pidfile = "$destdir@mysql_pid@";
our $tmpdir = "$destdir@mysql_tmpdir@";
our $confdir = "$destdir@confdir@";
our $secfile = "$destdir@mysql_secfile@";

sub launch_daemon
{
  return 0 if -e $pidfile;
  system (
    "@MYSQLD_SAFE_BIN@ --skip-networking "
    . "--socket=$socket --pid-file=$pidfile --tmpdir=$tmpdir "
    . "--secure-file-priv=$secfile --datadir=$datadir &"
  );
  sleep 1 until -e $pidfile;
  return 1;
}

sub init_datadir
{
  my @init_cmd;
  mkdir $secfile, 0700 unless -e $secfile;
  if (-e $datadir)
    {
      print "Note: $datadir exists; skipping SQL server data initialization.\n";
      return;
    }
  if ('@MYSQL_INSTALLDB_BIN@' ne '')
    {
      @init_cmd = ('@MYSQL_INSTALLDB_BIN@');
    }
  else
    {
      @init_cmd = ('@MYSQLD_BIN@', '--initialize-insecure');
      mkdir '@mysql_datadir@';
    }
  push @init_cmd,  ("--user=$ENV{'USER'}", "--datadir=$datadir");
  die "Failed to initialize datadir.\n" if system (@init_cmd);
}

sub mysql_cmd
{
  return '@MYSQL_BIN@ --user=@SV_DB_USER@ --password=@SV_DB_PASSWORD@ '
    . "--host=@SV_DB_HOST@ -S $socket @SV_DB_NAME@";
}

sub detect_db
{
  my $cmd = mysql_cmd ();
  return `echo SHOW DATABASES | $cmd` =~ /\n@SV_DB_NAME@\n/;
}

# List of arguments to try when creating SQL user and database.
# The requirements of database servers may vary.
sub arg_list_to_check
{
  my @db_user_list = ("", "-u $ENV{'USER'}", "-u root");
  my @host_arg_list = ("", "--host=@SV_DB_HOST@");
  my @ret = ();
  for my $user (@db_user_list)
    {
      for my $host (@host_arg_list)
        {
          push @ret, "$user $host";
        }
    }
  return @ret;
}

sub make_db
{
  my $cmd = "@MYSQL_BIN@ -S $socket < db/mk-db.sql";
  my $res;
  my $cmd_args;
  for $cmd_args (arg_list_to_check ())
    {
      return unless system ("$cmd $cmd_args");
    }
  die "Failed to create database.\n";
}

sub fill_db
{
  my $res = system (mysql_cmd () . " < @srcdir@/db/initial.sql");
  die "Failed to fill minimal database.\n" if $res;
  return 0 unless "@ADD_SAMPLE_DB@" eq "yes";
  $res = system (mysql_cmd () . " < @srcdir@/db/sample.sql");
  die "Failed to add sample database entries.\n" if $res;
}

sub make_launch_db_conf
{
  my $conf_file = "$confdir/launch-db.pl";
  my $query = 'SELECT @@session.sql_mode';
  my $cmd = "echo $query | " . mysql_cmd () . " --skip-column-names";
  my $mode = `$cmd`;
  chomp $mode;
  $mode =~ s/\b(STRICT_TRANS_TABLES)\b//g;
  $mode =~ s/(^|,),*/$1/g;
  $mode =~ s/,$//;
  die "Can't open $conf_file for writing: $!\n" unless open FH, '>', $conf_file;
  print FH "# Configuration file for sv_launch_db.pl\n";
  print FH '$sql_mode = "' . $mode . '"' . ";\n1;\n";
  close FH;
}

# Checking the exit status of this script proved insufficient since
# it may die with zero exit code; so we additionally use a db/init.stamp.
unlink ("db/init.stamp");
init_datadir ();
$launched_db = launch_daemon ();
if (detect_db ())
  {
    print "Note: database @SV_DB_NAME@ exists; skipping creation.\n";
  }
else
  {
    make_db ();
    fill_db ();
  }
make_launch_db_conf ();
system ("touch db/init.stamp");

END { kill 'TERM', `cat $pidfile` if $launched_db; }
