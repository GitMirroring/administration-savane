# Basic database routines.

package Savane::SQL;

use strict;
use DBI;
use Savane::Conf;
require Exporter;

our @ISA = qw (Exporter);
our @EXPORT = qw (
  sql_die_if_unconnected
  sql_last_insert_id
  sql_fetch_row
  sql_fetch_row_array
  sql_query
  $dbd
);

our $socket = "@mysql_socket@";
our $dbd;

sub db_source
{
  my $ret = 'DBI:mysql:database=' . GetConf ('sys_dbname');

  $ret .= ':host='. GetConf ('sys_dbhost');
  my $dbport = GetConf ('sys_dbport');
  $ret .= ":port=$dbport" if $dbport ne '';
  $ret .= ":mysql_socket=$socket" if GetConf ('sys_dbnetworking') eq 'no';
  $ret .= ':' . GetConf ('sys_dbparams');
  return $ret;
}

$dbd =
  DBI->connect (
    db_source (), GetConf ('sys_dbuser'), GetConf ('sys_dbpasswd'),
    {PrintError => 0, AutoCommit => 1}
  );

$dbd->{PrintError} = $dbd->{RaiseError} = 1 if $dbd;

sub sql_die_if_unconnected
{
  return if $dbd;
  die $DBI::errstr;
}

sub sql_last_insert_id
{
  return $dbd->last_insert_id ();
}

sub sql_query
{
  my $ret = $dbd->prepare (shift);
  $ret->execute (@_);
  return $ret;
}

sub sql_fetch_row_array
{
  my $res = shift;
  return $res->fetchrow_array ();
}

sub sql_fetch_row
{
  my $res = shift;
  return $res->fetchrow_hashref ();
}

return "true";
