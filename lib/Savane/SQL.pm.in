# Basic database routines.

use strict;
use DBI;
require Savane::Conf;
require Exporter;

our @ISA = qw (Exporter);
our @EXPORT = qw (
  db_die_if_unconnected
  db_last_insert_id
  sql_fetch_row
  sql_query
);

our $sys_dbname;
our $sys_dbhost;
our $sys_dbport;
our $sys_dbuser;
our $sys_dbpasswd;
our $sys_dbnetworking;
our $sys_dbparams;
our $dbd;
our $socket = "@mysql_socket@";

sub db_source
{
  my $ret = "DBI:mysql:database=$sys_dbname";

  $ret .= ":host=$sys_dbhost";
  $ret .= ":port=$sys_dbport" if $sys_dbport ne '';
  $ret .= ":mysql_socket=$socket" if $sys_dbnetworking eq 'no';
  $ret .= ":$sys_dbparams";
  return $ret;
}

$dbd =
  DBI->connect (
    db_source (), $sys_dbuser, $sys_dbpasswd,
    {PrintError => 0, AutoCommit => 1}
  );

$dbd->{PrintError} = $dbd->{RaiseError} = 1 if $dbd;

sub db_die_if_unconnected
{
  return if $dbd;
  die $DBI::errstr;
}

sub db_last_insert_id
{
  return $dbd->last_insert_id ();
}

sub sql_query
{
  my $ret = $dbd->prepare (shift);
  $ret->execute (@_);
  return $ret;
}

sub sql_fetch_row
{
  my $res = shift;
  return $res->fetchrow_array ();
}

return "true";
