# Send notifications.

use strict;
require Mail::Send;
require Savane::Version;
require Exporter;

our @ISA = qw (Exporter);
our @EXPORT = qw (MailSend);
our $version = 1;

sub format_message
{
  my $url = GetConf ("sys_default_domain") . GetConf ("sys_url_topdir");
  return "$_[0]\n\n-- \n"
    .  "Message sent by " . GetConf ("sys_name") . "\nhttps://$url\n";
}

sub get_headers
{
  my %ret;
  %ret = (
    "From" => GetConf ("sys_mail_replyto"),
    "X-Savane-Server" => GetConf ("sys_default_domain"),
    "X-Savane-Version" => GetVersion (1),
    "User-Agent" => "Savane::Mail.pm"
  );
  return %ret;
}

sub send_mail
{
  my ($to, $subject, $message) = @_;
  my $msg = new Mail::Send;
  my $fh;
  my %headers = get_headers ();

  $msg->to ($to);
  $msg->subject ($subject);
  foreach my $h (keys %headers)
    {
      $msg->add ($h, $headers{$h});
    }
  $fh = $msg->open;
  print $fh $message;
  $fh->close;
}

sub log_mail
{
  my ($to, $subject, $message) = @_;
  my $logdir = "@logdir@";
  my $log = "$logdir/sendmail.mbox";
  my %headers = get_headers ();
  die "Can't open $log for writing: $!\n" unless open FH, '>>', $log;
  print FH "From @PACKAGE@ " . `date`;
  print FH "To: $to\n";
  print FH "Subject: $subject\n";
  foreach my $h (keys %headers)
    {
      print FH "$h: $headers{$h}\n";
    }
  print FH "\n$message";
  close FH;
}

sub MailSend
{
  my ($to, $subj, $msg) = @_;
  $msg = format_message ($msg);
  return send_mail ($to, $subj, $msg) if @HAVE_SENDMAIL@;
  return log_mail ($to, $subj, $msg);
}

return 1;
