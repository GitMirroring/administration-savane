use strict;
use Savane::DB;
use Savane::Util;
use Savane::Test::PHP;
use Savane::Test::Log;
use WWW::Mechanize;
require Exporter;

our @ISA = qw (Exporter);
our @EXPORT = qw (
  clear_mbox get_mbox make_url unmake_url make_agent
  save_page save_text
  find_form
  log_in log_in_su log_out check_status_code check_inaccessibility get_user_id
  get_group_id run_cleanup check_request_status try_mkdir
  write_test_php rm_test_php select_root_url get_twin_idx
);

my $bindir = '@bindir@';
my $phpdir = '@frontenddir@/php';

sub try_mkdir
{
  my $dir = shift;
  my $exit_on_error = @_? shift: 1;
  print_test_log ("Creating $dir directory.");
  if (-d $dir)
    {
      print_test_result ("Directory $dir already exists.");
      return 0;
    }
  if (mkdir $dir)
    {
      print_test_result ("Successfully created $dir/.");
      return 0;
    }
  print_test_error ("Cannot create $dir directory: $!");
  exit (1) if $exit_on_error;
  return 1;
}

sub save_text
{
  my $text = shift;
  my $file = @_? shift: 'test.txt';
  my $error = @_? shift: 1;
  my $fd;
  print_test_result ("See $file.", $error);
  open ($fd, '>:encoding(UTF-8)', $file);
  print {$fd} $text;
  close ($fd);
}

sub save_page
{
  my $agent = shift;
  my $file = @_? shift: 'test.html';
  my $error = @_? shift: 1;
  save_text ($agent->content (raw => 1), $file, $error);
}

sub check_request_status
{
  my $agent = shift;
  my $page = @_? shift: undef;
  my $expected = @_? shift: 200;
  my $status = $agent->status ();
  if ($status eq $expected)
    {
      print_test_result ("Request status is $expected as expected.");
      return 0;
    }
  save_page ($agent, $page) if defined $page;
  print_test_error ("Unexpected request status $status.");
  return 1;
}

sub check_for_test_marker
{
  my @test = GetDBAsIs ("SHOW TABLES LIKE 'test_marker'");
  return 0 if $test[0] eq 'test_marker';
  print_test_error (
    "Cowardly refusing to run tests: the database isn't intended for that."
  );
  return 1;
}

my @root_url;
my $root_idx = 0;

sub init_root_url
{
  my ($php_port, $php_bin);
  $php_port = <>;
  chomp $php_port;
  $php_bin = <>;
  chomp $php_bin;
  my @hosts = (
    '@WWW_SERVER_HOST@', '@WWW_TWIN_SERVER_HOST@',
    '@FILE_SERVER_HOST@', '@FILE_TWIN_SERVER_HOST@'
  );
  push @root_url, "http://$_:$php_port/" foreach @hosts;
  print_test_log ("port $php_port, bin $php_bin");
  init_php ($php_port, $php_bin);
  select_root_url ('twin');
}

sub log_in_for_accessibility
{
  my ($agent, $user) = @_;
  return 0 unless defined $user;
  return log_in ($agent, $user) if $user !~ s/^[*]//;
  return log_in_su ($agent, $user);
}

sub check_status_code
{
  my $url = shift;
  my $expected = shift;
  my $user = @_? shift: undef;
  my $agent = defined ($_[0])? shift: make_agent (0);
  print_test_log ("Asserting status /^$expected\$/ for $url.");
  return 1 if log_in_for_accessibility ($agent, $user);
  $agent->get (make_url ($url));
  my $status = $agent->status ();
  unless ($status =~ /^$expected$/)
    {
      print_test_error ("Wrong $url status: $status.");
      save_page ($agent, "$status.html");
      return 1;
    }
  print_test_result ("$url status $status is like expected.");
  return 0;
}

sub check_inaccessibility
{
  my $url = shift;
  my $user = @_? shift: undef;
  my $agent = @_? shift: undef;
  return check_status_code ($url, '40\d', $user, $agent);
}

sub make_agent
{
  if (launch_php_server () < 0)
    {
      print_test_error ("Failed to launch PHP server.");
      return undef;
    }
  my $ret = WWW::Mechanize->new (autocheck => @_? shift: 1);
  print_test_error ('Cannot create WWW::Mechanize agent.') unless defined $ret;
  return $ret;
}

sub get_user_id
{
  my $user_name = shift;
  my $agent = make_agent (0);
  print_test_log ("Getting user Id for <$user_name>.");
  $agent->get (make_url ("users/$user_name"));
  return -1 if $agent->status () =~ /40\d/;
  my $html = $agent->content (raw => 1);
  unless ($html =~ /<td>Id: <\/td>\n<td><b>#(\d+)<\/b><\/td>/)
    {
      print_test_error ("Can't find user ID.");
      save_page ($agent, "no-user-$user_name.html");
      return -1;
    }
  print_test_result ("User Id is $1.");
  return $1;
}

sub get_group_id
{
  my $group = shift;
  my $agent = make_agent (0);
  print_test_log ("Getting group Id for <$group>.");
  return -1 if log_in_su ($agent);
  $agent->get (make_url ("projects/$group/"));
  return -1 if check_request_status ($agent);
  my $html = $agent->content (raw => 1);
  unless ($html =~ m,Group identification</h2>(.*?)>Id: <b>(\d+)</b>(.*?)<h2>,s)
    {
      print_test_error ("Cannot find group Id.");
      save_page ($agent, "no-group-id-$group.html");
      return -1;
    }
  print_test_result ("Group Id is $2.");
  log_out ($agent);
  return $2;
}

sub root_url_max_idx
{
  return $#root_url;
}

sub change_root
{
  my $idx = shift;
  return unless defined $idx;
  my $ret = $root_idx;
  my %host_names = ('www' => 0, 'twin' => 1, 'file' => 2, 'twin_file' => 3);
  if ($idx =~ /\d+/)
    {
      $root_idx = $idx if ($idx <= root_url_max_idx ());
      return;
    }
  return unless exists $host_names{$idx};
  $root_idx = $host_names{$idx};
}

sub get_twin_idx
{
  return shift ^ 1;
}

sub select_root_url
{
  my $idx = shift;
  my $ret = $root_idx;
  change_root ($idx);
  my ($url0, $url1) = ($root_url[$ret], $root_url[$root_idx]);
  print_test_log ("Changing root URL $ret ($url0) => $idx ($url1).") if defined $idx;
  return $ret;
}

sub make_url
{
  my $url = shift;
  my $idx = @_? shift: $root_idx;
  return $root_url[$idx] . $url;
}

sub unmake_url
{
  my $ret = shift;
  foreach (@root_url)
    {
      return $ret if $ret =~ s,^$_/?,,;
    }
  return $ret;
}

sub mbox_path
{
  return "@logdir@/sendmail.mbox";
}

sub clear_mbox
{
  my $silent = shift;
  my $path = mbox_path ();
  print_test_log ('Removing mbox file.');
  unless (-f $path)
    {
      print_test_result ("No mbox at $path", !$silent);
      return;
    }
  unlink ($path) or print_test_result ("Can't remove $path: $!.", !$silent);
}

sub get_mbox
{
  my ($clear, $silent) = @_;
  my $fd;
  my @ret;
  my $mp = mbox_path ();
  unless (open ($fd, '<', $mp))
    {
      print_test_error ("Can't open mbox $mp.") unless $silent;
      return '';
    }
  while (<$fd>)
    {
      push @ret, $_;
    }
  clear_mbox ($silent) if $clear;
  return join '', @ret;
}

sub find_su_link
{
  my $agent = shift;
  my $error_on_fail = @_? shift: 1;
  my $link = $agent->find_link (url_regex => qr,/account/su\.php[?],);
  print_test_log ('Looking for superuser link.');
  unless (defined $link)
    {
      print_test_result ('Cannot find superuser link.', $error_on_fail);
      save_page ($agent, 'no-su.html') if $error_on_fail;
      return undef;
    }
  print_test_result ("Found superuser link ". $link->url . ".");
  return $link;
}

sub become_su
{
  my $agent = shift;
  my $link = find_su_link ($agent);
  if ($link->url =~ /action=logout/)
    {
      print_test_result ('Already in superuser mode.');
      return 0;
    }
  unless ($link->url =~ /action=login/)
    {
      print_test_result ("Unexpected 'action' string.");
      return 1;
    }
  print_test_log ('Following superuser link.');
  $agent->get ($link->url);
  my $ret = check_request_status ($agent);
  print_test_result ('Acquired superuser privileges.') unless $ret;
  save_page ($agent, 'su-priv.html') if $ret;
  return $ret;
}

my %passphrases;

sub default_passphrase
{
  return '-';
}

sub lookup_passphrase
{
  my $login = shift;
  my $ret;
  print_test_log ("Looking for saved passphrase for <$login>.");
  if (exists $passphrases{$login})
    {
      $ret = $passphrases{$login};
      print_test_result ("Found passphrase: >$ret<.");
      return $ret;
    }
  $ret = default_passphrase ();
  print_test_result ("No passphrase found; using >$ret<.");
  return $ret;
}

sub save_passphrase
{
  my ($login, $passwd) = @_;
  return 0 if $passwd eq default_passphrase ();
  return 0 if (exists $passphrases{$login} && $passwd eq $passphrases{$login});
  print_test_log ("Saving passphrase >$passwd< for <$login>.");
  $passphrases{$login} = $passwd;
  return 0;
}

sub log_in_parse_args
{
  my $agent = shift;
  my $login = @_? shift: '-';
  my $passwd = shift;
  $passwd = lookup_passphrase ($login) unless defined $passwd;
  my $su = $login eq '*';
  print_test_log ("Logging in as <$login>, passphrase >$passwd<.");
  $login = '-' if $su;
  my $no_brother = shift;
  return ($agent, $login, $passwd, $su, $no_brother);
}

sub find_form
{
  my ($agent, $form_name, $page) = (shift, shift, shift);
  print_test_log ("Looking for $form_name form.");
  my $form = $agent->form_with_fields (@_);
  if (defined $form)
    {
      print_test_result ("Form found.");
      return $form;
    }
  print_test_error ("$form_name form not found.");
  save_page ($agent, $page);
  return undef;
}

sub find_log_in_form
{
  my ($agent, $login) = @_;
  print_test_log ('Looking for login form.');
  if (defined $agent->form_with_fields (qw (form_id form_pw)))
    {
      print_test_result ('Form found.');
      return 0;
    }
  print_test_error ("Form not found.");
  save_page ($agent, "no-login-$login.html");
  return 1;
}

sub check_link_by_regexp
{
  my ($agent, $regexp, $label, $should_fail) = @_;
  my $link = $agent->find_link (url_regex => $regexp);
  unless (defined $link)
    {
      print_test_result ("Cannot find $label link.", !$should_fail);
      save_page ($agent, "no-$label.html") unless $should_fail;
      return 1;
    }
  print_test_result ("Found $label link ". $link->url . ".", $should_fail);
  save_page ($agent, "found-$label.html") if $should_fail;
  return 0;
}

sub check_not_logged_in
{
  my $agent = shift;
  return check_link_by_regexp ($agent, qr,/account/login\.php[?],, 'login');
}

sub check_logged_in_status
{
  my $agent = shift;
  return check_not_logged_in ($agent) unless @_;
  return 1
    if check_link_by_regexp ($agent, qr,/account/logout\.php$,, 'logout');
  my $user = shift;
  my $text = 'Logged in as ';
  my $login = $agent->content (raw => 1);
  $login =~ s,</li><!-- end menutitle -->.*,,s;
  $login =~ s,.*<li class='menutitle'>$text,,s;
  if (lc ($login) eq $user)
    {
      print_test_result ("Found '$text$login'.");
      return 0;
    }
  print_test_error ("'$text$login' not found.");
  save_page ($agent, "no-logged-in-as-$user.html");
}

sub log_in
{
  my ($agent, $login, $passwd, $su, $no_brother) = log_in_parse_args (@_);
  print_test_log ('Visiting login page.');
  $agent->get (make_url ('account/login.php'));
  return 1 if check_request_status ($agent);
  return 1 if find_log_in_form ($agent, $login);
  $agent->set_fields ('form_loginname' => $login, 'form_pw' => $passwd);
  $agent->untick ('brotherhood', '1') if $no_brother;
  print_test_log ('Sending credentials.');
  $agent->click ('login');
  return 1 if check_request_status ($agent);
  return 1 if check_logged_in_status ($agent, $login);
  print_test_result ("Logged in as <$login>.");
  save_passphrase ($login, $passwd);
  return 0 unless $su;
  return become_su ($agent);
}

sub log_in_su
{
  my ($agent, $user) = @_;
  $user = '-' unless defined $user;
  $user = '-' if $user eq '';
  return 1 if log_in ($agent, $user);
  return become_su ($agent);
}
sub drop_privileges_if_su
{
  my $agent = shift;
  print_test_log ('Dropping superuser privileges (if any).');
  print_test_log ('Visiting a page accessible for all.');
  $agent->get ('/');
  return 1 if check_request_status ($agent);
  my $su_link = find_su_link ($agent, 0);
  return 0 unless defined $su_link;
  if ($su_link->url =~ /[?]action=login/)
    {
      print_test_result ("Already in non-superuser mode.");
      return 0;
    }
  print_test_log ('Following superuser link.');
  $agent->get ($su_link->url);
  my $ret = check_request_status ($agent);
  print_test_result ('Dropped privileges.') unless $ret;;
  return $ret;
}

sub log_out
{
  my $agent = shift;
  my $keep_su = shift;
  print_test_log ("Logging out.");
  drop_privileges_if_su ($agent) unless $keep_su;
  $agent->get (make_url ("account/logout.php"));
  my $ret = check_request_status ($agent);
  return 1 if check_logged_in_status ($agent);
  print_test_result ("Logged out.") unless $ret;
  return $ret;
}
sub run_cleanup
{
  print_test_log ('Clearing deleted things with sv_cleaner.');
  return 0
    unless system (
      "$bindir/sv_cleaner --big-cleanup --logfile=cleaner.log"
    );
  print_test_error ('Failed to run sv_cleaner.');
  return 1;
}

my %test_php_paths;

sub write_test_php
{
  my ($path, $text) = @_;
  my $fd;
  print_test_log ("Writing test PHP file to $path.");
  unless (open ($fd, '>', "$phpdir/$path"))
    {
      print_test_error ("Cannot write test PHP file: $!");
      return 1;
    }
  $test_php_paths{$path} = 1;
  print { $fd } $text;
  close ($fd);
  print_test_result ("Successfully written the test PHP file.");
  return 0;
}

sub rm_test_php
{
  my $f = shift;
  my $verbose = @_? shift: 0;
  print_test_log ("Removing test PHP file $f.") if $verbose > 0;
  delete %test_php_paths{$f} if exists $test_php_paths{$f};
  unless (-f "$phpdir/$f")
    {
      print_test_result ("No $phpdir/$f exists.") if $verbose > 1;
      return 0;
    }
  if (unlink ("$phpdir/$f"))
    {
      print_test_result ("Successfully removed $phpdir/$f.") if $verbose > 0;
      return 0;
    }
  print_test_error ("Cannot remove $phpdir/$f: $!.");
  return 1;
}

sub remove_test_php_files
{
  return 0 unless keys %test_php_paths;
  print_test_log ("Removing test PHP files.");
  my $ret = 0;
  foreach (keys %test_php_paths)
    {
      $ret = 1 if rm_test_php ("$phpdir/$_");
    }
  print_test_result ("Successfully removed test PHP files.")
    unless $ret;
  return $ret;
}

END
{
  remove_test_php_files ();
  close_test_log ();
}

init_test_log ();
exit (1) if check_for_test_marker ();
init_root_url ();
clear_mbox (1);

return "true";
