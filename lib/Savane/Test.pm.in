use strict;
use Savane::DB;
use Savane::Util;
use WWW::Mechanize;
require Exporter;

our @ISA = qw (Exporter);
our @EXPORT = qw (
  clear_mbox get_mbox make_url unmake_url make_agent
  print_test_log print_test_error print_test_result
  log_in log_in_su log_out check_inaccessibility get_user_id
  save_page append_savane_conf reset_savane_conf register_user remove_user
  speed_up_crypt
);

sub save_page
{
  my $agent = shift;
  my $file = @_? shift: 'test.html';
  my $error = $_? shift: 1;
  my $fd;
  print_test_result ("See $file.", $error);
  open ($fd, '>:encoding(UTF-8)', $file);
  print {$fd} $agent->content (raw => 1);
  close ($fd);
}

sub check_for_test_marker
{
  my @test = GetDBAsIs ("SHOW TABLES LIKE 'test_marker'");
  return 0 if $test[0] eq 'test_marker';
  print_test_error (
    "Cowardly refusing to run tests: the database isn't intended for that."
  );
  return 1;
}

my $root_url;

sub init_root_url
{
  my $host = "@WWW_SERVER_HOST@";
  my $port = <>;
  chomp $port;
  $root_url = "http://$host:$port/";
}

sub log_in_for_accessibility
{
  my ($agent, $user) = @_;
  return unless defined $user;
  if ($user eq '*')
    {
      log_in_su ($agent);
      return;
    }
  log_in ($agent, $user);
}

sub check_inaccessibility
{
  my $url = shift;
  my $user = @_? shift: undef;
  my $agent = make_agent (0);
  log_in_for_accessibility ($agent, $user);
  $agent->get (make_url ($url));
  my $status = $agent->status ();
  unless ($status =~ /^40\d$/)
    {
      print_test_error ("Wrong $url status: $status.");
      save_page ($agent, "$status.html");
      exit (1);
    }
  print_test_result ("$url confirmed to be absent (status $status).");
}

sub make_agent
{
  return WWW::Mechanize->new (autocheck => @_? shift: 1);
}

sub get_user_id
{
  my $user_name = shift;
  my $agent = make_agent (0);
  print_test_log ("Getting user Id for <$user_name>.");
  $agent->get (make_url ("users/$user_name"));
  return 0 if $agent->status () =~ /40\d/;
  my $html = $agent->content (raw => 1);
  unless ($html =~ /<td>Id: <\/td>\n<td><b>#(\d+)<\/b><\/td>/)
    {
      print_test_error ("Can't find user id; the page follows:\n$html\n");
      exit (1);
    }
  print_test_result ("User Id is $1.");
  return $1;
}

sub make_url
{
  return "$root_url$_[0]";
}

sub unmake_url
{
  my $ret = shift;
  $ret =~ s,^$root_url/?,,;
  return $ret;
}

my $log_fd;

sub print_test
{
  my ($str, $pref) = @_;
  $str =~ s,^,$pref,gm;
  $str =~ s,\n$,\n$pref,;
  print { $log_fd } "$str\n";
}

sub print_test_log
{
  my $str = shift;
  my $pref = '= ';
  $pref = '==' if ($str =~ s/^==//);
  print_test ($str, $pref);
}

sub print_test_error
{
  print_test (shift, '% ');
}

sub print_test_result
{
  my $str = shift;
  my $result = @_? shift: 0;
  if ($result)
    {
      print_test_error ($str);
      return;
    }
  print_test ($str, '- ');
}

sub script_name
{
  my $name = $0;
  $name =~ s,^[.]/,,;
  return $name;
}

sub init_log
{
  my $file = "test.log";
  my $name = script_name ();
  open ($log_fd, ">>:encoding(UTF-8)", $file)
    or die "$name: Can't open log file $file: $!";
  print_test_log ("== Test $name start.");
}
sub mbox_path
{
  return "@logdir@/sendmail.mbox";
}

sub clear_mbox
{
  my $path = mbox_path ();
  unlink ($path) if -f $path;
}

sub get_mbox
{
  my $clear = shift;
  my $fd;
  my @ret;
  my $mp = mbox_path ();
  unless (open ($fd, '<', $mp))
    {
      print_test_error ("Can't open mbox $mp.");
      return '';
    }
  while (<$fd>)
    {
      push @ret, $_;
    }
  clear_mbox () if $clear;
  return join '', @ret;
}

sub log_in
{
  my $agent = shift;
  my $login = @_? shift: '-';
  my $passwd = @_? shift: '-';
  print_test_log ("Logging in as <$login>, passphrase >$passwd<.");
  $agent->get (make_url ('account/login.php'));
  $agent->form_with_fields (qw (form_id));
  $agent->set_fields ('form_loginname' => $login, 'form_pw' => $passwd);
  $agent->click ('login');
  print_test_result ("Logged in as <$login>.");
}

sub log_in_su
{
  my $agent = shift;
  log_in ($agent, '-');
  $agent->follow_link (url_regex => qr,^/account/su\.php[?],);
  print_test_result ('Acquired superuser privileges.');
}

sub log_out
{
  my $agent = shift;
  print_test_log ("Logging out.");
  $agent->get (make_url ("account/logout.php"));
  print_test_result ("Logged out.");
}

sub get_password
{
  my $agent = shift;
  my $passwd = $agent->text ();
  $passwd =~ s/.*For instance: ([^.]*).*/$1/;
  $passwd = "merge&tragic-Maxim#$passwd^Detest2new*mutiny";
  print_test_result ("Password: $passwd");
  return $passwd;
}

sub request_account
{
  my $agent = shift;
  my $login = shift;
  my $name = @_? shift: $login;
  $agent->get (make_url ('account/register.php'));
  my $passwd = get_password ($agent);
  $agent->form_with_fields (qw (form_id));
  $agent->set_fields (
    'form_loginname' => $login, 'form_realname' => $name,
    'form_pw' => $passwd, 'form_pw2' => $passwd,
    'form_email' => $login . '@savane.test',
  );
  $agent->click ('update');
  print_test_result ("Account requested.");
  return $passwd;
}

sub get_confirmation_url
{
  my $url = get_mbox ();
  return make_url ('no-such-page') if $url eq '';
  clear_mbox ();
  $url =~ s/^.*?visit the following URL[^:]*:\n+//s;
  $url =~ s/\n.*$//s;
  print_test_result ("Confirmation URL: $url.");
  return $url;
}

sub confirm_account
{
  my ($agent, $login, $passwd) = @_;
  my $url = get_confirmation_url ();
  $agent->get ($url);
  $agent->form_with_fields (qw (form_id));
  $agent->set_fields ('form_loginname' => $login, 'form_pw' => $passwd);
  $agent->click ('update');
  print_test_result ("Account confirmed.");
}

sub register_user
{
  my ($agent, $login) = @_;
  print_test_log ("Checking for <$login> existence.");
  check_inaccessibility ("users/$login");
  my $passwd = request_account ($agent, $login);
  confirm_account ($agent, $login, $passwd);
  log_out ($agent);
  $agent->get (make_url ("users/$login"));
  print_test_result ("Account exists.");
  return $passwd;
}

sub request_user_removal
{
  my $agent = shift;
  $agent->get (make_url ('my/admin/change.php?item=delete'));
  $agent->form_with_fields (qw (form_id));
  $agent->tick ('newvalue', 'deletionconfirmed');
  $agent->click ('update');
  print_test_result ("Deletion requested.");
}

sub confirm_user_deletion
{
  my $agent = shift;
  my $url = get_confirmation_url ();
  $agent->get ($url);
  $agent->form_with_fields (qw (form_id));
  $agent->click ('update');
  print_test_result ("Deletion confirmed.");
}

sub remove_user
{
  my ($agent, $login, $passwd) = @_;
  log_in ($agent, $login, $passwd);
  request_user_removal ($agent);
  confirm_user_deletion ($agent);
  check_inaccessibility ("users/$login");
}

sub savane_conf_start_marker
{
  return "<?php # SAVANE TEST\n";
}

my $savane_conf_modified = 0;

sub append_savane_conf
{
  my $text = shift;
  my $fh;
  my $fname = '@confdir@/savane.conf.php';
  my $formatted = $text;
  my $ret = 0;
  $formatted =~ s,^,    ,gm;
  print_test_log ("Appending to savane.conf.php:\n$formatted");
  unless (open ($fh, '>>:encoding(UTF-8)', $fname))
    {
      print_test_error ("Can't open $fname: $!.");
      $ret = 1;
    }
  print { $fh } savane_conf_start_marker ();
  print { $fh } $text;
  print { $fh } "\n?>\n";
  $savane_conf_modified = 1;
  return $ret;
}

sub reset_savane_conf
{
  return unless $savane_conf_modified;
  my $fname = '@confdir@/savane.conf.php';
  my ($th, $tn) = open_tmp ('reset-sv-conf');
  my $fh;
  print_test_log ("Resetting savane.conf.php");
  unless (open ($fh, '<:encoding(UTF-8)', $fname))
    {
      print_test_error ("Can't open $fname: $!.");
      return;
    }
  while (!eof ($fh))
    {
      if (!defined ($_ = <$fh>))
        {
          print_test_error ("Error when reading $fname: $!");
          return;
        }
      last if $_ eq savane_conf_start_marker ();
      print { $th } $_;
    }
  close_and_move ($th, $tn, $fname);
}

# Set a low-cost crypt algorithm.
sub speed_up_crypt
{
  append_savane_conf (<<'  EOF');
    $sys_pw_prefix = '$6$';
    $sys_pw_rounds = 1000;
  EOF
}

END
{
  reset_savane_conf ();
  my $name = script_name ();
  print_test_log ("== Test $name end.");
}

init_log ();
exit (1) if check_for_test_marker ();
init_root_url ();
clear_mbox ();

return "true";
