use strict;
require Exporter;

our @ISA = qw (Exporter);
our @EXPORT = qw (mk_html_dir html_header);

sub html_header
{
  my $title = shift;
  my $header = <<"  EOF";
    <html>
    <head>
      <meta http-equiv='content-type'; content='text/html; charset=utf-8' />
      <title>$title</title>
    </head>
    <body>
  EOF
  $header =~ s,^ {4},,mg;
  return $header;
}

sub html_path
{
  my $pre = shift;
  my $aff = shift;
  $aff = "/$aff" if defined $aff;
  $aff = '' unless defined $aff;
  $pre .= '/html';
  return ("$pre$aff", $pre);
}

sub mk_html_dir
{
  my ($full, $pre) = html_path (@_);
  mkdir $pre;
  die qq{Can't create $pre directory: $!} unless -d $pre;
  mkdir $full;
  die qq{Can't create $full directory: $!} unless -d $full;
  return $full;
}

sub stat_field_label
{
  my @l = ('path', 'mirror', 'mirror country code', 'request country code');
  return '' if $_[0] - 1 > $#l;
  my $ret = $l[$_[0] - 1];
  return " by $ret";
}

sub default_dl_site_name
{
  return 'download.savannah.nongnu.org';
}
