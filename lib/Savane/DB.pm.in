# Any subs related to database access...
# Usually used in other subs.

use strict;
use DBI;
require Savane::Conf;
require Exporter;

our @ISA = qw (Exporter);
our @EXPORT = qw (DBSet GetDBDescribe GetDBSettings GetDBList GetDBAsIs GetDB
  GetDBAlt GetDBHash GetDBLists GetDBListsRef SetDBSettings DeleteDB InsertDB
  db_die_if_unconnected
);
our $version = 1;

our $sys_dbname;
our $sys_dbhost;
our $sys_dbport;
our $sys_dbuser;
our $sys_dbpasswd;
our $sys_dbnetworking;
our $sys_dbparams;
our $dbd;
our $socket = "@mysql_socket@";

sub db_source
{
  my $ret = "DBI:mysql:database=$sys_dbname";

  $ret .= ":host=$sys_dbhost";
  $ret .= ":port=$sys_dbport" if $sys_dbport ne '';
  $ret .= ":mysql_socket=$socket" if $sys_dbnetworking eq 'no';
  $ret .= ":$sys_dbparams";
  return $ret;
}

$dbd =
  DBI->connect (
    db_source (), $sys_dbuser, $sys_dbpasswd,
    {PrintError => 0, AutoCommit => 1}
  );

$dbd->{PrintError} = $dbd->{RaiseError} = 1 if $dbd;

sub db_die_if_unconnected
{
  return if $dbd;
  die $DBI::errstr;
}

# Return the name and type of every field of the table.
# arg0: table
sub GetDBDescribe
{
  return get_db_sql ("DESCRIBE $_[0]", ",");
}

# Format query string.
# arg0: table
# arg1: criterion
# arg2: fields to show (* for all)
sub parse_db_args
{
  my $table = $_[0];
  my $crit;
  my $fields = "*";

  $crit = " WHERE $_[1]" if $_[1];
  $fields = $_[2] if $_[2];
  return "SELECT $fields FROM $table$crit";
}

# Return all settings  for a group, user (a row).
sub GetDBSettings
{
  return $dbd->selectrow_array (parse_db_args (@_));
}

# Return a list of entries.
sub GetDBList
{
  my $list = $dbd->selectcol_arrayref (parse_db_args (@_));
  return @$list;
}

# Return a list of entries.
# arg0: SQL command
sub GetDBAsIs
{
  return get_db_sql ($_[0], ",");
}

sub get_db_sql
{
  my $sql = $_[0];
  my $sep = $_[1];
  my $hop;
  my @ret;

  $hop = $dbd->prepare ($sql);
  $hop->execute;
  while (my (@line) = $hop->fetchrow_array)
    {
      push (@ret, join ($sep, map {defined $_? $_: "0"} @line));
    }
  $hop->finish;
  return @ret;
}

sub get_db_separated
{
  return get_db_sql (parse_db_args (@_), $_[3]);
}

# Return a list of entries.
sub GetDB
{
  push (@_, 0) while $#_ < 2;
  push (@_, ",");
  return get_db_separated (@_);
}

# Return a list of entries like GetDB, but with an unusual separator.
sub GetDBAlt
{
  push (@_, 0) while $#_ < 2;
  push (@_, "------SPLIT------");
  return get_db_separated (@_);
}

# Return a hash of lists of entries.
sub GetDBHash
{
  my $hop;
  my %ret;

  $hop = $dbd->prepare (parse_db_args (@_));
  $hop->execute;
  my $count;
  while (my (@line) = $hop->fetchrow_array)
    {
      $ret{$count} = [@line];
      $count++;
    }
  $hop->finish;
  return %ret;
}

# Same purpose, but return true list.
sub GetDBLists
{
  return @{GetDBListsRef (@_)};
}

# This one is faster, since it returns a reference to the array and
# hence doesn't make a copy of the array. It is a bit less intuitive
# to manipulate on the calling side, and is not consistent with other
# GetDB* functions, so it is a separate function.
sub GetDBListsRef
{
  my $hop;
  my @ret;

  $hop = $dbd->prepare (parse_db_args (@_));
  $hop->execute;
  my $ret = $hop->fetchall_arrayref ();
  $hop->finish;

  # fetchall_arrayref does not reuse the data pointed by the
  # reference in later calls (unlike fetchrow_arrayref), so it is
  # safe to use it.
  return $ret;
}

# Update settings for a group, user.
sub SetDBSettings
{
  my ($table, $criterion, $value) = @_;
  return $dbd->do ("UPDATE $table SET $value WHERE $criterion");
}

# Delete entries in database.
# Use carefully.
sub DeleteDB
{
  my ($table, $criterion) = @_;
  return 0 unless ($table && $criterion);
  return $dbd->do ("DELETE FROM $table WHERE $criterion");
}

# Insert in database.
# Use carefully.
sub InsertDB
{
  my ($table, $fields, $values) = @_;
  return $dbd->do ("INSERT INTO $table ($fields) VALUES ($values)");
}

sub DBSet
{
  my ($var, $val) = @_;
  return $dbd->do ("SET $var = $val");
}
return "true";
