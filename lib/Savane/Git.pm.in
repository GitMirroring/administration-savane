# Init GIT repository.

use strict;
use warnings;

require Exporter;
require Savane::Conf;
require Savane::Util;
our @ISA = qw(Exporter);
our @EXPORT = qw(GitMakeArea);
our $version = 1;

sub make_receive_hook
{
  my ($dir_git, $git, $stage) = @_;
  my $path = "$dir_git/$stage-receive";
  return " Cannot open hooks/$stage-receive for writing: $!"
    unless open (HOOK, ">$path");
  my $hook = '@bindir@/sv_receive --' . $stage;
  my $msg = <<"  EOF";
    #! /bin/sh

    # Savane $stage-receive hook; if more hooks are needed,
    # they can be installed in savane.d/$stage-receive.d/.
    $hook
  EOF
  $msg =~ s/^ {4}//mg;
  return " Cannot write to hooks/$stage-receive."
    unless print HOOK $msg;
  close (HOOK);
  util_system ('chmod', 'a+x', $path);
  return '';
}

sub make_hooks
{
  my $dir_git = shift . '/hooks';
  my $w = '';
  my $git = configured_binary ('git');
  # Needed to make the repo accessible via bare HTTP.
  open (HOOK, ">$dir_git/post-update")
    or $w = " Cannot open hooks/post-update for writing: $!";
  print HOOK "#! /bin/sh\n";
  print HOOK "exec $git update-server-info\n";
  close (HOOK);
  util_system ('chmod', 'a+x', "$dir_git/post-update");
  $w .= make_receive_hook ($dir_git, $git, $_) foreach (qw /pre post/);
  return $w;
}

sub seal_hooks
{
  my $hooks = shift;
  util_system ('chown', '-R', 'root:', "$hooks") unless $>;
  util_system ('chmod', '-R', 'a-w', "$hooks");
  util_system ('chmod', 'a+rx', "$hooks");
}

sub config_git
{
  # 'git-cvsserver' support
  util_system ('git', 'config', 'gitcvs.pserver.enabled', 1);
  util_system ('git', 'config', 'gitcvs.ext.enabled', 0);
  util_system ('git', 'config', 'gitcvs.dbname', '%G/gitcvs-db/sqlite');
}

sub make_git_area
{
  my ($name, $dir_git, $is_public) = @_;
  my $w = '';
  $ENV{'GIT_DIR'} = $dir_git;

  # --shared sets g+s on directories
  util_system ('git', 'init', '-q', '--shared=all');

  util_system ('chgrp', '-R', $name, $dir_git) unless $>;
  util_system ('chmod', '-R', 'o=', $dir_git) unless $is_public;
  $w = make_hooks ($dir_git);
  util_system ('mkdir', '-p',  "$dir_git/hooks/savane.d/pre-receive.d");
  util_system ('mkdir', '-p',  "$dir_git/hooks/savane.d/post-receive.d");
  seal_hooks ("$dir_git/hooks");
  config_git ();
  my $sqlite_dir = "$dir_git/gitcvs-db";
  util_system ('mkdir', $sqlite_dir, '-m', '755');
  util_system ('chown', 'nobody', $sqlite_dir) unless $>;

  delete $ENV{'GIT_DIR'};
  return $w;
}

sub GitMakeArea
{
  my ($name, $dir_git, $is_public) = @_;
  return MakeDir (\&make_git_area, $name, $dir_git, $is_public);
}

return "true";
