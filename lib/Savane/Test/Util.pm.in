use strict;
use Cwd 'abs_path';
use Savane::Test::Log;

require Exporter;

our @ISA = qw (Exporter);
our @EXPORT = qw (
  try_mkdir try_chdir
);

sub try_mkdir
{
  my $dir = shift;
  my $exit_on_error = @_? shift: 1;
  print_test_log ("Creating $dir directory.");
  if (-d $dir)
    {
      print_test_result ("Directory $dir already exists.");
      return 0;
    }
  if (mkdir $dir)
    {
      print_test_result ("Successfully created $dir/.");
      return 0;
    }
  print_test_error ("Cannot create $dir directory: $!");
  exit (1) if $exit_on_error;
  return 1;
}

sub try_chdir
{
  my $dir = shift;
  return 0 if chdir ($dir);
  my $wd = abs_path ('.');
  print_test_error ("Cannot chdir '$dir' from '$wd'.");
  return 1;
}

return 1;
