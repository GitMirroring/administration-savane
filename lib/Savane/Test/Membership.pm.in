use strict;
use warnings;
use Savane::Test;
use WWW::Mechanize;
require Exporter;

my $default_group_name = 'administration';

our @ISA = qw (Exporter);
our @EXPORT = qw (
  group_admin_url group_user_perm_url group_default_name
  add_user_to_group remove_user_from_group quit_group
  user_id_is_removable request_inclusion approve_user
);

sub group_admin_url
{
  my $group_name = @_? shift: $default_group_name;
  return make_url ("project/admin/useradmin.php?group=$group_name");
}

sub group_default_name
{
  return $default_group_name;
}

sub group_user_perm_url
{
  my $group_name = @_? shift: $default_group_name;
  return make_url ("project/admin/userperms.php?group=$group_name");
}

sub find_input_in_form
{
  my ($form, $name) = @_;
  my $input = $form->find_input ($name);
  print_test_error ("Can't find $name.") unless defined $input;
  return $input;
}
sub find_forms
{
  my $agent = shift;
  my @ret = ();
  return $agent->all_forms_with_fields (@_)
    if (exists &WWW::Mechanize::all_forms_with_fields);
  foreach my $form ($agent->forms ())
    {
      my $vex = 0;
      foreach my $name (@_)
        {
          $vex = 1 unless defined $form->find_input ($name);
        }
      next if $vex;
      push @ret, $form;
    }
  return @ret;
}
sub find_list
{
  my ($agent, $action) = (shift, shift);
  my $empty_is_wrong = @_? shift: 1;
  for (find_forms ($agent, 'action', 'user_ids[]'))
    {
      my @vals = $_->param ('action');
      next unless @vals;
      return $_ if $vals[0] eq $action;
    }
  print_test_result ("Can't find list $action.", $empty_is_wrong);
  save_page ($agent, "find-list-$action.html") if $empty_is_wrong;
  return undef;
}
sub option_is_possible
{
  my ($agent, $input, $val) = (shift, shift, shift);
  my $error = @_? shift: 1;
  my @list = map {defined $_? $_: -1} $input->possible_values ();
  for (@list)
    {
      return 1 if "$val" eq "$_";
    }
  print_test_result (
    "Value $val isn't found in (" .  join (', ', @list) . ").", $error
  );
  save_page ($agent, 'option-possible.html', $error) if $error;
  return 0;
}
sub user_id_is_removable
{
  my $agent = shift;
  my $id = shift;
  print_test_log ("Check if #$id is removable.");
  my $form = find_list ($agent, 'remove_from_group', 0);
  return 0 unless defined $form;
  my $input = find_input_in_form ($form, 'user_ids[]', 0);
  return 0 unless defined $input;
  return 0 unless option_is_possible ($agent, $input, $id, 0);
  print_test_result ("User Id $id is offered for removal from group.");
  return 1;
}
sub remove_user_from_group
{
  my ($agent, $user, $id) = @_;
  print_test_log ("Removing <$user> from group.");
  my $form = find_list ($agent, 'remove_from_group');
  $form->param ('user_ids[]', $id);
  $agent->request ($form->click ());
  if (user_id_is_removable ($agent, $id))
    {
      print_test_error ("Can't remove: <$user> is still removable.");
      save_page ($agent, "removable-$user.html");
      return 1;
    }
  print_test_result ("Removed <$user> from group.");
  return 0;
}
sub check_request_subject
{
  my $headers = shift;
  return 0 if $headers =~ /\nSubject: Membership request/s;
  print_test_error ("Subject not found.");
  return 1;
}
sub check_apparently_from
{
  return 0 if $_[0] =~ /\nX-Apparently-From: Savane authenticated user $_[1]/s;
  print_test_error ("X-Apparently-From is missing.");
  return 1;
}
sub check_user_details
{
  my ($body, $user) = @_;
  return 0
    if $body =~ /\nUser Details:\n-+\nName: [^\n]*\nLogin:\s*$user\nEmail:/s;
  print_test_error ("User details not found in message body.");
}
sub run_request_email_checks
{
  my ($user, $headers, $body) = @_;
  my $result = 0;
  print_test_log ("Checking request message.");
  $result = 1 if check_request_subject ($headers);
  $result = 1 if check_apparently_from ($headers, $user);
  $result = 1 if check_user_details ($body, $user);
  return $result;
}
sub get_message
{
  my $mbox = get_mbox (1);
  if ($mbox !~ /(.*?)\n\n(.*)/s)
    {
      print_test_error ("No empty line is found in mbox:\n$mbox\n.");
      return (undef, undef, undef);
    }
  return ($1, $2, $mbox);
}
sub check_request_email
{
  my $user = shift;
  my ($headers, $body, $mbox) = get_message ();
  return 1 unless defined $headers;
  if (run_request_email_checks ($user, $headers, $body))
    {
      print_test_error ("The message found is:\n$mbox\n");
      return 1;
    }
  print_test_result ("Request message looks sane.");
  return 0;
}
sub request_inclusion
{
  my ($agent, $user) = (shift, shift);
  my $gname = @_? shift: 'administration';
  my $ret = 0;
  log_in ($agent, $user);
  print_test_log ("Visiting account membership page.");
  $agent->get (make_url ('my/groups.php'));
  print_test_log ("Looking for a group.");
  $agent->form_with_fields (qw (form_id searchgroup));
  $agent->set_fields ('words' => $gname);
  $agent->click ();
  print_test_log ("Requesting inclusion.");
  $agent->form_with_fields (qw (form_message));
  $agent->set_fields ('form_message' => 'Accept me please.');
  my $form = $agent->current_form ();
  $form->find_input (undef, 'checkbox')->check ();
  $agent->click ();
  $ret = check_request_email ($user);
  log_out ($agent);
  return $ret;
}
sub check_approval_subject
{
  return 0 if $_[0] =~ /\nSubject: Group membership approved\n/s;
  print_test_error ("Subject not found.");
  return 1;
}
sub check_approval_body
{
  return 0 if $_[0] =~ /^You've been approved/;
  print_test_error ("Expected string in body not found.");
  return 1;
}
sub check_approval_email
{
  my $user = shift;
  my ($headers, $body, $mbox) = get_message ();
  return 1 unless defined $headers;
  my $result = 0;
  print_test_log ("Checking approval message.");
  $result = 1 if check_approval_subject ($headers);
  $result = 1 if check_apparently_from ($headers, '-');
  $result = 1 if check_approval_body ($body);
  if ($result)
    {
      print_test_error ("The message found is:\n$mbox\n");
      return 1;
    }
  print_test_result ("Approval message looks sane.");
  return 0;
}
sub add_user_to_group
{
  my ($agent, $user) = @_;
  my $id = get_user_id ($user);
  remove_user_from_group ($agent, $user, $id)
    if user_id_is_removable ($agent, $id);

  print_test_log ("Looking for user <$user>.");
  $agent->form_with_fields (qw (action form_id words));
  $agent->set_fields ('words' => $user);
  $agent->click ();

  print_test_log ("Adding <$user> to group.");
  my $form = find_list ($agent, 'add_to_group');
  return -1 unless defined $form;
  my $input = find_input_in_form ($form, 'user_ids[]');
  return -1 unless defined $input;
  return -1 unless option_is_possible ($agent, $input, $id);
  $form->param ('user_ids[]', $id);
  $agent->request ($form->click ('update'));
  return -1 unless user_id_is_removable ($agent, $id);
  print_test_result ("User <$user> was successfully added.");
  return $id;
}
sub approve_user
{
  my ($agent, $user) = @_;
  my $id = get_user_id ($user);
  print_test_log ("Approving <$user> for group.");
  my $form = find_list ($agent, 'approve_for_group');
  my $input;
  return -1 unless defined $form;
  $input = find_input_in_form ($form, 'user_ids[]');
  return -1 unless defined $input;
  $form->param ('user_ids[]', $id);
  $agent->request ($form->click ('update'));
  return -1 unless user_id_is_removable ($agent, $id);
  print_test_result ("User <$user> was successfully approved.");
  return -1 if check_approval_email ($user);
  return $id;
}
sub quit_link_re
{
  my $group_id = shift;
  return qr,my/quitproject[.]php\b, if $group_id < 0;
  $group_id .= '$';
  return qr,my/quitproject[.]php[?]quitting_group_id=$group_id,
}
sub quit_cancel
{
  my ($agent, $link_re) = @_;
  print_test_log ('Following a quit link.');
  $agent->follow_link (url_regex => $link_re);
  $agent->form_with_fields (qw (form_id quitting_group_id));
  print_test_log ("Cancelling quit.");
  $agent->click ('cancel');
}
sub quit_group
{
  my ($agent, $user, $group) = @_;
  my $group_id = defined $group? get_group_id ($group): -1;
  log_in ($agent, $user);
  print_test_log ('Visiting my group page.');
  $agent->get (make_url ('my/groups.php'));
  my $link_re = quit_link_re ($group_id);
  quit_cancel ($agent, $link_re);
  print_test_log ('Following a quit link again.');
  $agent->follow_link (url_regex => $link_re);
  $agent->form_with_fields (qw (form_id quitting_group_id));
  print_test_log ("Confirming quit.");
  $agent->click ('confirm');
  if (defined $agent->find_link (url_regex => $link_re))
    {
      print_test_error ('Failed to quit.');
      return 1;
    }
  print_test_result ('Successfully quit.');
  return 0;
}

return "true";
