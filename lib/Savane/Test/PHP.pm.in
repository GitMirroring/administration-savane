use strict;
use WWW::Mechanize;
require Exporter;
our @ISA = qw (Exporter);
our @EXPORT = qw (launch_php_server restart_php_server kill_php_server);

my $sbindir = "@sbindir@";
my $host = "@WWW_SERVER_HOST@";
my $log_name = 'test-php.log';
my ($php_server_pid, $php_port, $php_bin);

sub print_log
{
  my $log_file;

  open ($log_file, '>>', $log_name) or die "Cannot open log file $log_name: $!";
  print {$log_file} shift . "\n" if defined $log_file;
  close ($log_file);
}

sub server_url
{
  return "http://$host:$php_port/";
}

sub server_return_code
{
  my $agent = WWW::Mechanize->new (autocheck => 0);
  return $agent->get (server_url ())->code ();
}

sub server_is_up
{
  my $code = @_? shift: server_return_code ();
  return $code ne '500';
}

sub server_is_alive
{
  return 1 if kill (0, $php_server_pid);
  print_log ("Process $php_server_pid is not running.");
  return 0;
}

sub wait_for_server
{
  my $wait_for_shutdown = @_? shift: 0;
  my $pid = "PID $php_server_pid";
  my $sd = $wait_for_shutdown? 'to shutdown': 'to start up';
  my $url = server_url ();
  print_log ("Waiting for $host:$php_port $sd, $pid.");
  for (my $i = 0; $i < 10; $i++)
    {
      return -2 if !($wait_for_shutdown || server_is_alive ());
      my $code = server_return_code ();
      my $vex = server_is_up ($code);
      $vex = !$vex if $wait_for_shutdown;
      return 0 if $vex;
      print_log ("Waiting for $pid $sd, $i - $code.");
      kill ('TERM', $php_server_pid) if $wait_for_shutdown;
      sleep 1;
    }
  print_log ("Time for $url $sd is out, $pid.");
  kill_php_server ();
  return -1;
}

sub exec_server
{
  setpgrp ();
  open (STDOUT, '>>', $log_name);
  open (STDERR, '>>', $log_name);
  exec (
    "$sbindir/sv_php_server.pl", '--port', $php_port, '--php-bin', $php_bin
  );
}

sub launch
{
  my $pid = fork ();
  die "Can't fork: $!" unless defined $pid;
  exec_server () unless ($pid);
  $php_server_pid = $pid;
  my $w = wait_for_server ();
  return $w if $w;
  print_log ("Launched $host:$php_port, PID $pid.");
  return $pid;
}

sub launch_php_server
{
  ($php_port, $php_bin) = @_;
  my $pid = -1;
  if (server_is_up ())
    {
      print_log ("Server $host:$php_port is already running.");
      return -1;
    }
  print_log ("Address $host:$php_port is not in use.");
  for (my $i = 0; $i < 7 && $pid < 0; $i++)
    {
      $pid = launch ();
      return $pid if $pid >= 0;
    }
  return -1;
}
sub kill_php_server
{
  return 0 unless defined $php_server_pid;
  return 0 unless server_is_alive ();
  my $exit_code = $?;
  if (kill ('TERM', $php_server_pid))
    {
      waitpid ($php_server_pid, 0);
      my $ret = wait_for_server (1);
      print_log ("Killed $php_server_pid.") unless $ret;
      undef $php_server_pid;
      $? = $exit_code;
      return $ret;
    }
  print_log ("Cannot kill PHP server $host:$php_port, PID $php_server_pid.");
  $? = 1;
  return 1;
}

sub restart_php_server
{
  kill_php_server ();
  return launch_php_server ($php_port, $php_bin) < 0;
}

END
{
  kill_php_server ();
}

use POSIX ":sys_wait_h";
$SIG{CHLD} = sub
{
  local ($!, $?);
  1 while (waitpid (-1, WNOHANG) > 0);
};

return "true";
