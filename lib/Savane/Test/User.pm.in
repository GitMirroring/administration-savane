use strict;
use Savane::Test;
use WWW::Mechanize;
require Exporter;

our @ISA = qw (Exporter);
our @EXPORT = qw (register_user remove_user set_email);

sub get_password
{
  my $agent = shift;
  my $passwd = $agent->text ();
  $passwd =~ s/.*For instance: ([^.]*).*/$1/;
  $passwd = "merge&tragic-Maxim#$passwd^Detest2new*mutiny";
  print_test_result ("Password: $passwd");
  return $passwd;
}

sub request_account
{
  my $agent = shift;
  my $login = shift;
  my $name = @_? shift: $login;
  $agent->get (make_url ('account/register.php'));
  my $passwd = get_password ($agent);
  $agent->form_with_fields (qw (form_id));
  $agent->set_fields (
    'form_loginname' => $login, 'form_realname' => $name,
    'form_pw' => $passwd, 'form_pw2' => $passwd,
    'form_email' => $login . '@savane.test',
  );
  $agent->click ('update');
  print_test_result ("Account requested.");
  return $passwd;
}

sub get_confirmation_url
{
  my $url = get_mbox ();
  return make_url ('no-such-page') if $url eq '';
  clear_mbox ();
  $url =~ s/^.*?visit the following URL[^:]*:\n+//s;
  $url =~ s/\n.*$//s;
  print_test_result ("Confirmation URL: $url.");
  return $url;
}

sub confirm_account
{
  my ($agent, $login, $passwd) = @_;
  my $url = get_confirmation_url ();
  $agent->get ($url);
  $agent->form_with_fields (qw (form_id));
  $agent->set_fields ('form_loginname' => $login, 'form_pw' => $passwd);
  $agent->click ('update');
  print_test_result ("Account confirmed.");
}

sub register_user
{
  my ($agent, $login) = @_;
  print_test_log ("Checking for <$login> existence.");
  return undef if check_inaccessibility ("users/$login");
  my $passwd = request_account ($agent, $login);
  confirm_account ($agent, $login, $passwd);
  log_out ($agent);
  $agent->get (make_url ("users/$login"));
  print_test_result ("Account exists.");
  return $passwd;
}

sub request_user_removal
{
  my $agent = shift;
  $agent->get (make_url ('my/admin/change.php?item=delete'));
  $agent->form_with_fields (qw (form_id));
  $agent->tick ('newvalue', 'deletionconfirmed');
  $agent->click ('update');
  print_test_result ("Deletion requested.");
}

sub confirm_user_deletion
{
  my $agent = shift;
  my $url = get_confirmation_url ();
  $agent->get ($url);
  $agent->form_with_fields (qw (form_id));
  $agent->click ('update');
  print_test_result ("Deletion confirmed.");
}

sub remove_user
{
  my ($agent, $login, $passwd) = @_;
  log_in ($agent, $login, $passwd);
  request_user_removal ($agent);
  confirm_user_deletion ($agent);
  return check_inaccessibility ("users/$login");
}

sub request_email_change
{
  my ($agent, $email) = @_;
  clear_mbox (1);
  $agent->get (make_url ('my/admin/change.php?item=email'));
  return 1 if check_request_status ($agent, 'requesting-change.html');
  $agent->form_with_fields (qw (form_id newvalue update));
  $agent->set_fields ('newvalue' => $email);
  $agent->click ('update');
  return 1 if check_request_status ($agent, 'request-change.html');
  my $txt = $agent->content (raw => 1);
  if ($txt =~ /Supplied string .* doesn't look like an email address/)
    {
      print_test_error ('Request seems rejected.');
      save_page ($agent, 'req-rejected.html');
      return 1;
    }
  print_test_result ('Successfully requested change.');
  return 0;
}

sub check_email
{
  my ($agent, $email) = @_;
  print_test_log ('Checking if the new email is correct.');
  print_test_log ('Visiting account configuration.');
  $agent->get (make_url ('my/admin/'));
  return 1 if check_request_status ($agent, 'cke-conf.html');
  my $text = $agent->content (raw => 1);
  $text =~ s#^.*?Mail Setup</div>##s;
  $text =~ s#^.*?<b>##s;
  $text =~ s#</b>.*##s;
  if ($text eq $email)
    {
      print_test_result ("New email is '$email' as expected.");
      return 0;
    }
  print_test_error ("New email is '$text', expected '$email'.");
  save_page ($agent, 'cke-res.html');
  return 1;
}

sub set_email
{
  my ($agent, $email) = @_;
  print_test_log ("Changing email to $email.");
  return 1 if request_email_change ($agent, $email);
  my $url = get_confirmation_url ();
  $url =~ s/step=discard$/step=confirm/;
  print_test_log ('Visiting confirmation URL.');
  $agent->get ($url);
  $agent->form_with_fields (qw (form_id confirm_hash step));
  print_test_log ('Confirming the change.');
  $agent->click ('update');
  return 1 if check_request_status ($agent, 'change-url.html');
  return 1 if check_email ($agent, $email);
  print_test_result ('Successfully changed email.');
  return 0;
}
