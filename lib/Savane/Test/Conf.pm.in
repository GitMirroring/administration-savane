use strict;
use Savane::Test::PHP;
use Savane::Test;

require Exporter;
our @ISA = qw (Exporter);
our @EXPORT = qw (append_savane_conf reset_savane_conf speed_up_crypt);

# Set a low-cost crypt algorithm.
sub speed_up_crypt
{
  append_savane_conf (<<'  EOF', shift, shift);
    $sys_pw_prefix = '$6$';
    $sys_pw_rounds = 1000;
  EOF
}

sub savane_conf_start_marker
{
  return "<?php # SAVANE TEST\n";
}

my $savane_conf_modified = 0;

sub savane_conf_name
{
  my $n = shift;
  $n = 'savane.conf.php' unless defined $n;
  return '@confdir@/' . $n;
}

sub append_savane_conf
{
  my $text = shift;
  my $fname = savane_conf_name (shift);
  my $skip_restart = shift;
  my $fh;
  my $formatted = $text;
  my $ret = 0;
  return 0 unless defined $text;
  $formatted =~ s,^,    ,gm;
  print_test_log ("Appending to savane.conf.php:\n$formatted");
  unless (open ($fh, '>>:encoding(UTF-8)', $fname))
    {
      print_test_error ("Can't open $fname: $!.");
      $ret = 1;
    }
  print { $fh } savane_conf_start_marker () . "$text\n?>\n";
  $savane_conf_modified = 1;
  return $ret if $skip_restart;
  print_test_log ('Restarting PHP server.');
  $ret = 1 if restart_php_server ();
  return $ret;
}

sub rewrite_conf
{
  my ($fh, $fname, $th) = @_;
  while (!eof ($fh))
    {
      if (!defined ($_ = <$fh>))
        {
          print_test_error ("Error when reading $fname: $!");
          return 1;
        }
      last if $_ eq savane_conf_start_marker ();
      print { $th } $_;
    }
  return 0;
}

sub reset_savane_conf
{
  my $skip_restart = shift;
  return unless $savane_conf_modified;
  $savane_conf_modified = 0;
  my $fname = '@confdir@/savane.conf.php';
  my ($th, $tn) = open_tmp ('reset-sv-conf');
  my $fh;
  print_test_log ("Resetting savane.conf.php");
  unless (open ($fh, '<:encoding(UTF-8)', $fname))
    {
      print_test_error ("Can't open $fname: $!.");
      return;
    }
  return if rewrite_conf ($fh, $fname, $th);
  close_and_move ($th, $tn, $fname);
  return 0 if $skip_restart;
  return restart_php_server ();
}

END
{
  reset_savane_conf (0);
}

return "true";
