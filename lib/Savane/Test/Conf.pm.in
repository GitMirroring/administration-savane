use strict;
use Savane::Test::PHP;
use Savane::Test::Log;
use Savane::Test::Util;
use Savane::Util;

require Exporter;
our @ISA = qw (Exporter);
our @EXPORT = qw (
  append_savane_conf reset_savane_conf speed_up_crypt
  add_savane_conf_pl clear_savane_conf_pl
);

# Set a low-cost crypt algorithm.
sub speed_up_crypt
{
  return append_savane_conf (<<'  EOF', shift, shift);
    $sys_pw_prefix = '$6$';
    $sys_pw_rounds = 1000;
  EOF
}

sub savane_conf_start_marker
{
  return "<?php # SAVANE TEST $$\n";
}

my $savane_conf_modified = 0;

sub savane_conf_name
{
  my $n = shift;
  $n = 'savane.conf.php' unless defined $n;
  return '@confdir@/' . $n;
}

sub append_savane_conf
{
  my $text = shift;
  my $fname = savane_conf_name (shift);
  my $skip_restart = shift;
  my $fh;
  my $formatted = $text;
  my $ret = 0;
  return 0 unless defined $text;
  $formatted =~ s,^,    ,gm;
  print_test_log ("Appending to savane.conf.php:\n$formatted");
  unless (open ($fh, '>>:encoding(UTF-8)', $fname))
    {
      print_test_error ("Can't open $fname: $!.");
      $ret = 1;
    }
  print { $fh } savane_conf_start_marker () . "$text\n?>\n";
  $savane_conf_modified = 1;
  return $ret if $skip_restart;
  print_test_log ('Restarting PHP server.');
  return $ret unless restart_php_server ();
  print_test_error ('Cannot restart PHP server.');
  return 1;
}

sub rewrite_conf
{
  my ($fh, $fname, $th) = @_;
  while (!eof ($fh))
    {
      if (!defined ($_ = <$fh>))
        {
          print_test_error ("Error when reading $fname: $!");
          return 1;
        }
      last if $_ eq savane_conf_start_marker ();
      print { $th } $_;
    }
  return 0;
}

sub reset_savane_conf
{
  my $skip_restart = shift;
  return unless $savane_conf_modified;
  $savane_conf_modified = 0;
  my $fname = '@confdir@/savane.conf.php';
  my ($th, $tn) = open_tmp ('reset-sv-conf');
  my $fh;
  print_test_log ("Resetting savane.conf.php");
  unless (open ($fh, '<:encoding(UTF-8)', $fname))
    {
      print_test_error ("Can't open $fname: $!.");
      return;
    }
  return if rewrite_conf ($fh, $fname, $th);
  close_and_move ($th, $tn, $fname);
  return 0 if $skip_restart;
  return 0 unless restart_php_server ();
  print_test_error ('Cannot restart PHP server.');
  return 1;
}

my @added_conf_pl_files;

sub clear_savane_conf_pl
{
  print_test_log ('Removing files installed in savane.conf.pl.d.');
  print_test_result ('No files have been installed.')
    unless @added_conf_pl_files;
  my $ret = 0;
  foreach (@added_conf_pl_files)
    {
      print_test_log ("Removing '$_'.");
      if (unlink ($_))
        {
          print_test_result ('Successfully removed.');
          next;
        }
       print_test_error ("Cannot remove: $!");
       $ret = 1;
    }
  return $ret;
}

sub add_savane_conf_pl
{
  my $conf_dir = '@sysconfdir@/savane/savane.conf.pl.d';
  return 1 if try_mkdir ($conf_dir);
  my ($text, $suff) = @_;
  $text .= "\nreturn 1;\n";
  $suff = (defined $suff)? "-$suff": '';
  my @entries = sort <$conf_dir>;
  my $path = sprintf ('%s/test-%3.3i%s', $conf_dir, $#entries + 1, $suff);
  my $formatted = $text;
  $formatted =~ s,^,    ,gm;
  print_test_log ("Writing to $path:\n$formatted");
  my $fh;
  unless (open ($fh, '>', $path))
    {
      print_test_error ("Cannot open '$path' for writing: $!");
      return 1;
    }
  my $res = print {$fh} $text;
  close ($fh);
  push @added_conf_pl_files, $path if -f $path;
  print_test_error ("Cannot write in '$path': $!") unless $res;
  return !$res;
}

END
{
  my $exit_code = $?;
  $exit_code = 1 if reset_savane_conf (0);
  $exit_code = 1 if clear_savane_conf_pl ();
  $? = $exit_code;
}

return "true";
