use strict;

require Exporter;
our @ISA = qw (Exporter);
our @EXPORT = qw (
  print_test_log print_test_error print_test_result init_test_log close_test_log
);

my $log_fd;

sub print_test
{
  my ($str, $pref) = @_;
  $str =~ s,^,$pref,gm;
  $str =~ s,\n$,\n$pref,;
  print { $log_fd } "$str\n";
}

sub print_test_log
{
  my $str = shift;
  my $pref = '= ';
  $pref = '==' if ($str =~ s/^==//);
  print_test ($str, $pref);
}

sub print_test_error
{
  print_test (shift, '% ');
  return unless @_;
  save_page (@_);
}

sub print_test_result
{
  my $str = shift;
  my $result = @_? shift: 0;
  if ($result)
    {
      print_test_error ($str);
      return;
    }
  print_test ($str, '- ');
}

sub script_name
{
  my $name = $0;
  $name =~ s,^[.]/,,;
  return $name;
}

my $prefix;

sub init_test_log
{
  my $file = "test.log";
  my $name = script_name ();
  $prefix = shift;
  $prefix = '==' unless defined $prefix;
  open ($log_fd, ">>:encoding(UTF-8)", $file)
    or die "$name: Can't open log file $file: $!";
  print_test_log ("$prefix $name start.");
}

sub close_test_log
{
  my $name = script_name ();
  print_test_log ("$prefix $name end.");
}

return "true";
