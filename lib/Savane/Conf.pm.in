use strict;
require Exporter;

our @ISA = qw(Exporter);
our @EXPORT = qw(GetConf get_server_url configured_binary);

my $conf_prefix = '@sysconfdir@/savane';
my $conf_file;
my $res;

# Default values for some variables.
our $sys_default_domain = '@WWW_SERVER_HOST@';
our $sys_www_server_port = '@WWW_SERVER_PORT@';
our $sys_mail_replyto = 'INVALID.NOREPLY';
our $sys_name = 'Savannah-dev';
our $sys_curl_bin = '/usr/bin/curl';
our $sys_server_default_protocol = 'http';
our %sys_binaries = ();

$conf_prefix = $ENV{'SAVANE_CONF'} if $ENV{'SAVANE_CONF'};

$conf_file = "$conf_prefix/savane.conf.pl";
die "Configuration file $conf_file not found" unless (-e $conf_file);

sub die_on_config
{
  my $conf_file = shift;
  my $err_msg;
  $err_msg = "Failed to run configuration file $conf_file\n";
  $err_msg = "Failed to compile configuration file $conf_file: $@\n" if $@;
  $err_msg = "Failed to read configuration file $conf_file: $!\n"
    unless ($@ || not $!);
  die $err_msg, "\nDied ";
}

$res = do $conf_file;
die_on_config ($conf_file) unless $res;
my $conf_dir = "$conf_prefix/savane.conf.pl.d";
if (-d $conf_dir)
  {
    foreach (sort <"$conf_dir/*">)
      {
        next unless -f $_;
        $res = do $_;
        die_on_config ($_) unless $res;
      }
  }

my %binaries = (
  'chgrp' => '@CHGRP@',
  'chmod' => '@CHMOD@',
  'chown' => '@CHOWN@',
  'bzr' => '@BZR@',
  'cvs' => '@CVS@',
  'git' => '@GIT@',
  'hg' => '@HG@',
  'svn' => '@SVN@',
  'svnadmin' => '@SVNADMIN@',
  'gpg' => '@GPG@',
);

foreach (keys %binaries)
  {
    $binaries{$_} = 'false' unless $binaries{$_} ne '';
  }

$binaries{$_} = $sys_binaries{$_} foreach keys %sys_binaries;

sub configured_binary
{
  my $bin = shift;
  $bin = $binaries{$bin} if exists $binaries{$bin};
  return $bin;
}

# Return a configured variable.
# In fact, they are usually accessed via our $sys_var;
sub GetConf
{
  my $val;
  no strict 'refs';
  $val = ${$_[0]} if defined ${$_[0]};
  use strict;
  return $val;
}

sub get_server_url
{
  my $ret = "$sys_server_default_protocol://$sys_default_domain";
  return $ret if $sys_www_server_port eq '';
  return $ret if $sys_www_server_port eq '80';
  return "$ret:$sys_www_server_port";
}

return 1;
