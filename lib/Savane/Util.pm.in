# Miscellaneous subs.

use strict;
require Exporter;
require Savane::Conf;
use POSIX qw (strftime);

our @ISA = qw (Exporter);
our @EXPORT = qw (
  SQLStringEscape
  MakeDir ExpandDirTemplate
  open_log print_log finalize_log
);
# Escape arg0 to be sent in a SQL string.
sub SQLStringEscape
{
  my $str = $_[0];
  $str =~ s/\\/\\\\/g;
  $str =~ s/\'/\'\'/g;
  $str =~ s/\n/\\n/g;
  return $str;
}

# Expand group area template.
sub ExpandDirTemplate
{
  our $sys_dir_prefix;
  my ($dir, $name) = @_;
  my $warning = " (The string \%PROJECT was not found in $dir, there may be "
    . "a serious misconfiguration in group type)";
  $warning = '' if $dir =~ s/\%PROJECT/$name/;
  $dir = "$sys_dir_prefix$dir" if defined ($sys_dir_prefix);
  return ($warning, $dir);
}

# Make a specific group area and apply $func to it unless it already exists.
sub MakeDir
{
  my ($func, $name, $dir, $is_public, $repo_type) = @_;
  my $warning;
  ($warning, $dir) = ExpandDirTemplate ($dir, $name);
  return 0 if -e $dir;
  $warning .= &$func ($name, $dir, $is_public, $repo_type);
  return " $dir$warning";
}

# Handle logs.
my ($util_log_fd, $log_script, $dry_run);

sub open_log
{
  my ($file, $script, $dr) = @_;
  $log_script = $script;
  $dry_run = $dr? ' (dry_run)': '';
  open ($util_log_fd, ">>:encoding(UTF-8)", $file)
    or die "$log_script: Can't open log file $file: $!";
  print_log ("start");
}

sub print_log
{
  my $timestamp = strftime "%c", localtime;
  print { $util_log_fd } "[$log_script] $timestamp$dry_run $_[0]\n";
}

sub finalize_log
{
  print_log ($_[0]) if (defined $_[0]);
  print_log ("------------------------------------------------------");
  close ($util_log_fd);
}

return "true";
