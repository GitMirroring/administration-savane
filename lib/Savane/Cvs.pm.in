# (Called Cvs instead of CVS to avoid confusion with /CVS)
#
# Currently, the location of the locks is hardcoded, as the anoncvs
# group.

use strict;
use warnings;

require Exporter;
require Savane::Util;
require Savane::Conf;
our @ISA = qw (Exporter);
our @EXPORT = qw (CvsMakeAreaSavannah
  WebCvsMakeAreaSavannahGNU WebCvsMakeAreaSavannahNonGNU
);
our $version = 1;
our $dbd;

sub new_sp_url
{
  return 'http://www.gnu.org/new-savannah-project/new.py';
}

# Compute the type argument for new-savannah-project/new.py.
# It is derived from the dir_type_homepage of the group_type table
# with the exception of 'www'.
sub CvsSavannahWebType
{
  my ($name) = @_;
  my $dir_type = GetGroupTypeSettings (
    GetGroupType ($name), 'dir_type_homepage'
  );
  return 'www' if $name eq 'www';
  # Return 'gnu' when $dir_type is 'savannah-gnu',
  # 'non-gnu' when $dir_type is 'savannah-nongnu',
  # else $dir_type (e.g. 'translations').
  if ($dir_type =~ s/^savannah-//)
    {
      $dir_type =~ s/^non/non-/;
    }
  return $dir_type;
}

sub check_spaces_in_dirs
{
  foreach my $dir (@_)
    {
      # Use POSIX [:space:] instead of \s for completeness
      # (check man perlre).
      return "A space in the dir name '$dir'" if $dir =~ /[[:space:]]/;
    }
  return '';
}

sub build_separate_diffs
{
  my ($diff_on, $emails_diff) = @_;
  return '--no-send-diff ' unless $diff_on == 1;
  my $ret = '--send-diff ';
  return $ret unless $emails_diff ne '';
  my @emails = split (',', $emails_diff);
  return $ret . join ('', map { "--separate-diffs $_ " } @emails);
}

sub get_hook_regexp
{
  my $match_type = shift;
  my @dirs = @_;
  my $regexp;
  return ($match_type, '')
    if ($match_type eq 'ALL' || $match_type eq 'DEFAULT');
  return ('', "Unknown match type: $match_type")
    unless ($match_type eq 'dir_list');
  return ('', 'Directory list is empty') if (scalar (@dirs) == 0);
  return ('^' . $dirs[0] . '\(/\|$\)', '') if (scalar (@dirs) == 1);
  return ('^\(' . join ('\|', @dirs) . '\)\(/\|$\)', '');
}

sub get_hook_config
{
  my $repo = shift;
  my $config_file = 'log_accum-web.config';
  $config_file = 'log_accum-sources.config' if $repo eq 'sources';
  return "--config @confdir@/$config_file %p %{sVv}\n";
}

# Build the loginfo and commitinfo configuration for a single hook.
sub BuildHooks
{
  my ($group, $repo, $match_type, $dir_list, $emails_notif,
    $diff_on, $emails_diff, $branches, $hook_id) = @_;
  my $log_accum = '';
  $dir_list = '' if (!defined ($dir_list));
  $emails_diff = '' if (!defined ($emails_diff));
  $branches = '' if (!defined ($branches));

  my @dirs = split (',', $dir_list);
  my $check = check_spaces_in_dirs (@dirs);
  return ('', '', $check) unless $check eq '';

  my ($regexp, $warning) = get_hook_regexp ($match_type, @dirs);
  return ('', '', $warning) unless $warning eq '';
  return ('', '', "No emails_notif - skipping...") if $emails_notif eq '';
  $log_accum .= $regexp . ' @bindir@/log_accum.pl ';
  my @emails = split (',', $emails_notif);
  $log_accum .= join ('', map { "--mail-to $_ " } @emails);
  $log_accum .= build_separate_diffs ($diff_on, $emails_diff);

  if ($branches ne '')
    {
      $log_accum .= join ('', map { "--only-tag $_ " } split (',', $branches));
    }

  # Give a unique prefix for temporary files for each line.
  # Some lines may run concurrently (e.g. when regexp='ALL').
  $log_accum .= '--file-prefix ' . $group . '_' . $hook_id . ' ';
  $log_accum .= get_hook_config ($repo);

  my $commit_prep = "$regexp @bindir@/commit_prep.pl ";
  $commit_prep .= '-T ' . $group . '_' . $hook_id . " %p\n";

  return ($log_accum, $commit_prep, '');
}

sub BasicWebHook
{
  my ($name) = @_;
  my $type = CvsSavannahWebType ($name);
  return "ALL echo 'Triggering webpages update...'; cat > /dev/null; "
    . GetConf ('sys_curl_bin') . ' ' . new_sp_url () . ' '
    . "-s -F type=$type -F project=`basename %r`\n"
}

sub load_file
{
  my $file = shift;
  my $fh;
  local $/;
  undef $/; # slurp mode
  return (" Cannot open $file for reading: $!.", '')
    unless (open ($fh, "< $file"));
  my $text = readline ($fh);
  close ($fh);
  return ('', $text);
}

sub line_diff
{
  my ($to_replace, $replace_string) = @_;
  my @old_lines = split ("\n", $to_replace);
  my @new_lines = split ("\n", $replace_string);
  my %line_hash;
  my $diff = '';
  foreach my $val (@old_lines)
    {
      $line_hash{$val} = 0;
    }
  foreach my $val (@new_lines)
    {
      $line_hash{$val} = 0;
    }
  foreach my $val (@old_lines)
    {
      $line_hash{$val}--;
    }
  foreach my $val (@new_lines)
    {
      $line_hash{$val}++;
    }
  while (each %line_hash)
    {
      $diff .= '+ ' . "$_\n" if ($line_hash{$_} > 0);
      $diff .= '- ' . "$_\n" if ($line_hash{$_} < 0);
    }
  return $diff;
}

sub update_info_file
{
  my ($file, $replace_string) = @_;
  my ($text, $err);
  my ($w, $prev_text) = load_file ($file);
  return $w unless $w eq '';
  $text = $prev_text;
  my ($ot, $ct) = ("#<savane>", "#</savane>");
  $text =~ s,^$ot\n[[:space:]]*.*^$ct($),$ot\n$replace_string$ct,sm;
  return '' if $prev_text eq $text;
  # Find lines present in $to_replace, but absent in current file,
  # and vice versa.
  my $to_replace = $prev_text;
  $to_replace =~ s,.*^$ot\n[[:space:]]*(.*)^$ct.*,$1,sm;
  my $diff = line_diff ($to_replace, $replace_string);
  return '' if $diff eq '';
  $w = "updating $file:\n$diff";
  $err = init_cvs_file ($file, $text);
  return $w if $err eq '';
  return "$w Cannot open $file for writing: $err.";
}

sub format_w
{
  my ($name, $repo, $w) = @_;
  return '' if $w eq '';
  return " ($name:$repo:$w)";
}

sub fetch_hooks
{
  my ($name, $repo) = @_;
  return $dbd->selectall_hashref ("
    SELECT groups.unix_group_name, cvs_hooks.*, cvs_hooks_log_accum.*
    FROM
      groups JOIN cvs_hooks ON groups.group_id = cvs_hooks.group_id
        JOIN cvs_hooks_log_accum ON cvs_hooks.id = cvs_hooks_log_accum.hook_id
    WHERE groups.unix_group_name = '$name' AND repo_name = '$repo'
    ORDER by hook_id", 'hook_id'
  );
}

sub compile_db_hooks
{
  my ($name, $repo) = @_;
  my ($warning, $loginfo, $commitinfo) = ("", "", "");
  my $hooks_ref = fetch_hooks ($name, $repo);
  foreach my $hook_id (keys %{$hooks_ref})
    {
      my ($log_accum, $commit_prep, $w) = BuildHooks (
        $hooks_ref->{$hook_id}->{'unix_group_name'},
        $hooks_ref->{$hook_id}->{'repo_name'},
        $hooks_ref->{$hook_id}->{'match_type'},
        $hooks_ref->{$hook_id}->{'dir_list'},
        $hooks_ref->{$hook_id}->{'emails_notif'},
        $hooks_ref->{$hook_id}->{'enable_diff'},
        $hooks_ref->{$hook_id}->{'emails_diff'},
        $hooks_ref->{$hook_id}->{'branches'},
        $hook_id
      );
      $loginfo .= $log_accum;
      $commitinfo .= $commit_prep;
      $warning .= format_w ($name, $repo, $w);
    }
  return ($warning, $loginfo, $commitinfo);
}

# Update email notification hooks in commitinfo if needed.
sub UpdateCvsNotifications
{
  my ($name, $dir_cvs, $repo) = @_;
  my ($warning, $loginfo, $commitinfo) = compile_db_hooks ($name, $repo);
  $loginfo .= BasicWebHook ($name) if $repo eq 'web';
  my $w = update_info_file ("$dir_cvs/CVSROOT/commitinfo", $commitinfo);
  $warning .= format_w ($name, $repo, $w);
  $w = update_info_file ("$dir_cvs/CVSROOT/loginfo", $loginfo);
  $warning .= format_w ($name, $repo, $w);
  return 0 if $warning eq '';
  return " $dir_cvs$warning";
}

sub make_cvs_directory
{
  my ($dir_cvs, $is_public) = @_;
  my $mode = $is_public? '2775': '2770';
  system ('mkdir', '-p', '-m', $mode, $dir_cvs);
  system ('cvs', '-d', "$dir_cvs", 'init');

  # Make the CVSROOT ro for anybody; doing otherwise is a major security hole:
  # ancient versions of pserver, if ran as root, can be set to give root
  # access using the CVSROOT/passwd file; you also basically give local
  # access if you allow people to modify the hooks.
  system ('chown', '-R', 'root:root', "$dir_cvs/CVSROOT") unless $>;
  system ('chmod', '755', "$dir_cvs/CVSROOT") unless $>;

  # Cleanup CVSROOT.
  while (glob ("$dir_cvs/CVSROOT/*,v"))
    {
      unlink;
    }
  while (glob ("$dir_cvs/CVSROOT/.\#*"))
    {
      unlink;
    }
}

sub init_cvs_file
{
  my ($file, $text) = @_;
  my $fh;
  my $ret = '';
  system ('chmod', 'u+w', $file) if ($> && -f $file);
  open ($fh, "> $file");
  print { $fh } $text or $ret = $!;
  close ($fh);
  system ('chmod', 'u-w', $file) if $>;
  return $ret;
}

sub make_cvs_config
{
  my ($dir_cvs, $repo_type, $name) = @_;
  my ($fh, $file);
  my $text = <<"  EOF";
    # Set this to "no" if pserver shouldn't check system users/passwords
    SystemAuth=no
    # Set also this to "no" under Debian for the same reason
    #PamAuth=no

    # Put CVS lock files in this directory rather than directly in the repository.
    LockDir=/var/lock/cvs/$repo_type/$name

    # Set `TopLevelAdmin' to `yes' to create a CVS directory at the top
    # level of the new working directory when using the `cvs checkout'
    # command.
    #TopLevelAdmin=no

    # Set `LogHistory' to `all' or `TOEFWUPCGMAR' to log all transactions to the
    # history file, or a subset as needed (ie `TMAR' logs all write operations)
    #LogHistory=TOEFWUPCGMAR
    # Cut down on disk I/O by only logging write operations
    LogHistory=TMAR

    # Set `RereadLogAfterVerify' to `always' (the default) to allow the verifymsg
    # script to change the log message.  Set it to `stat' to force CVS to verify
    # that the file has changed before reading it (this can take up to an extra
    # second per directory being committed, so it is not recommended for large
    # repositories.  Set it to `never' (the previous CVS behavior) to prevent
    # verifymsg scripts from changing the log message.
    #RereadLogAfterVerify=always

    # Set `UserAdminOptions' to the list of `cvs admin' commands (options)
    # that users not in the `cvsadmin' group are allowed to run.  This
    # defaults to `k', or only allowing the changing of the default
    # keyword expansion mode for files for users not in the `cvsadmin' group.
    # This value is ignored if the `cvsadmin' group does not exist.
    #
    # The following string would enable all `cvs admin' commands for all
    # users:
    #UserAdminOptions=aAbceIklLmnNostuU
    UserAdminOptions=k

    # Set `UseNewInfoFmtStrings' to `no' if you must support a legacy system by
    # enabling the deprecated old style info file command line format strings.
    # Be warned that these strings could be disabled in any new version of CVS.
    UseNewInfoFmtStrings=yes
  EOF
  $text =~ s,^ *,,mg;
  init_cvs_file ("$dir_cvs/CVSROOT/config", $text);
}

sub init_cvsroot_files
{
  my ($dir_cvs, $repo_type, $name) = @_;
  my $hook;
  $dir_cvs .= '/CVSROOT';

  init_cvs_file ("$dir_cvs/passwd", "anonymous::nobody\nanoncvs::nobody\n");
  init_cvs_file ("$dir_cvs/readers", "anonymous\nanoncvs\n");

  # Mark files for Savane hooks management.
  init_cvs_file ("$dir_cvs/commitinfo", "#<savane>\n#</savane>\n");
  $hook = "#<savane>\n";
  $hook .= BasicWebHook ($name) if $repo_type eq 'web';
  $hook .= "#</savane>\n";
  init_cvs_file ("$dir_cvs/loginfo", $hook);
  # If not present, pserver assumes write access for everybody
  # not in 'readers'.
  init_cvs_file ("$dir_cvs/writers", '');
}

sub chmod_if_exist
{
  my $mod = shift;
  foreach (@_)
    {
      chmod ($mod, $_) if -f $_;
    }
}

sub setup_cvs_permissions
{
  my ($dir_cvs, $repo_type, $name) = @_;
  my $root = "$dir_cvs/CVSROOT";

  chmod_if_exist (0644,
    "$root/config", "$root/passwd", "$root/readers", "$root/writers"
  );
  # Val-tags go world-writable.
  chmod_if_exist (0666, "$root/val-tags");

  # History is group-writable.
  system ('chgrp', $name, "$root/history") unless $>;
  chmod_if_exist (0664, "$root/history");

  # Create the default module.
  system ('mkdir', '-m', '2775', "$dir_cvs/$name");
  # Allow group access.
  system ('chgrp', $name, $dir_cvs, "$dir_cvs/$name") unless $>;

  # Build the locks.
  system ('mkdir', '-p', '-m', '777', "/var/lock/cvs/$repo_type/$name");

  # Seal CVSROOT dir.
  system ('chmod', 'a-w', "$root");
}

sub make_cvs_area
{
  my ($name, $dir_cvs, $is_public, $repo_type) = @_;
  make_cvs_directory ($dir_cvs, $is_public);
  make_cvs_config ($dir_cvs, $repo_type, $name);
  init_cvsroot_files ($dir_cvs, $repo_type, $name);
  setup_cvs_permissions ($dir_cvs, $repo_type, $name);
  return '';
}

sub finalize_cvs_area
{
  my ($dir, $name, $update_acl) = @_;
  my $ws_type = CvsSavannahWebType ($name);
  $update_acl = 0 if $<;

  if ($update_acl)
    {
      # Allow modifications from group 'www'.
      system ('setfacl', '-m', 'group:www:rwx', '-m', 'default:group:www:rwx',
        "$dir/$name"
      );
      system ('setfacl', '-m', 'group:www:rw', "$dir/CVSROOT/history");
    }
  # Perform an initial checkout so that updates happen:
  # (will also be done at commit time now).
  system (GetConf ('sys_curl_bin'), new_sp_url (),
    '-s', '-F', "type=$ws_type", '-F', "project=$name"
  );
  return '';
}

# Make a CVS area at Savannah, refresh hooks.
sub CvsMakeAreaSavannah
{
  my ($name, $dir_cvs, $is_public, $repo_type) = @_;
  my ($warning, $res);

  $repo_type = 'sources' unless defined ($repo_type);
  $res = MakeDir (\&make_cvs_area, $name, $dir_cvs, $is_public, $repo_type);
  return $res if $res ne 0;
  ($warning, $dir_cvs) = ExpandDirTemplate ($dir_cvs, $name);
  $res = UpdateCvsNotifications ($name, $dir_cvs, $repo_type);
  return $res unless $res eq 0;
  return "made $dir_cvs";
}

sub WebCvsMakeArea
{
  my ($name, $dir_cvs, $is_public, $update_acl) = @_;
  my ($warning, $dir) = ExpandDirTemplate ($dir_cvs, $name);
  return '' unless $dir_cvs =~ /\%PROJECT/;

  # Give CvsMakeAreaSavannah a chance to update hooks
  # before skipping the operations that are only needed for fresh repos.
  my $have_dir_cvs = -e $dir;
  my $w = CvsMakeAreaSavannah ($name, $dir_cvs, $is_public, 'web');
  return $w if $have_dir_cvs;
  $w .= finalize_cvs_area ($dir, $name, $update_acl);
  return $w;
}

# Make a gnu webcvs area at Savannah.
sub WebCvsMakeAreaSavannahGNU
{
  my ($name, $dir_cvs, $is_public) = @_;
  return WebCvsMakeArea ($name, $dir_cvs, $is_public, 1);
}

# Make a non-gnu webcvs area at Savannah.
# The difference from gnu webcvs is that no ACLs
# are updated for GNU webmasters access.
sub WebCvsMakeAreaSavannahNonGNU
{
  my ($name, $dir_cvs, $is_public) = @_;
  return WebCvsMakeArea ($name, $dir_cvs, $is_public, 0);
}

return "true";
