use strict;
require Exporter;

use Savane::Util;

our @ISA = qw(Exporter);
our @EXPORT = qw (GetUserSettings GetUserPrefs PrintUserSettings
  PrintUserPrefs SetUserSettings SetUserPrefs GetUserGroups GetUserList
  GetUserName PrintAliasesList
);
our $version = 1;

our $dbd;
our $qqch;
our $sys_homedir;
our $sys_homedir_subdirs;

# Return info, basic stuff.

# From the database.

# Get a setting for a user.
# arg0: user name
# arg1: setting
sub GetUserSettings
{
  GetDBSettings ("user",
    "user_name = '" . SQLStringEscape ($_[0]) . "'", $_[1]
  );
}

# Get a preference for a user.
# arg0: user id
# arg1: pref name
sub GetUserPrefs
{
  GetDBSettings ("user_preferences",
    "user_id = '" . GetUserSettings ($_[0], "user_id")
    . "' AND preference_name = '" . SQLStringEscape ($_[1]) . "'"
  );
}

# Show in a convenient way settings for a user.
# arg1: user name
sub PrintUserSettings
{
  print join " | ", GetUserSettings ($_[0]);
}

sub PrintUserPrefs
{
  print join " | ", GetUserPrefs ($_[0]);
}


# Update in a convenient way settings for a user.
# arg1: user name
# arg2: field
# arg3: new value
sub SetUserSettings
{
  SetDBSettings ("user", "user_name = '" . SQLStringEscape ($_[0]) . "'",
    "$_[1]='" . SQLStringEscape ($_[2]) . "'"
  );
}

# Set a pref for a user.
# arg1: user id
# arg2: preference name
# arg3: new value
sub SetUserPrefs
{
  SetDBSettings ("user_preferences",
    "user_id = '" . GetUserSettings ($_[0], "user_id")
    . "' AND preference_name = '" . SQLStringEscape ($_[1]) . "'",
    "preference_value = '" . SQLStringEscape ($_[2]) . "'"
  );
}


# Get list of groups for a user (contrary of GetGroupUsers.
# arg1 : which user name
sub GetUserGroups
{
  return GetDBList ("user_group",
    "user_id = '" . GetUserSettings ($_[0], "user_id") . "'", "group_id"
  );
}


# Query users.
# arg0: criterion
# arg1: field to be returned
sub GetUserList
{
  return GetDBList ("user", $_[0], $_[1]);
}


# In many case, we have to deal with user_id but I find
# easier to deal directly with user_name.
# arg1 : which user id
sub GetUserName
{
  return $dbd->selectrow_array (
    "SELECT user_name FROM user WHERE user_id = '" . $_[0] . "'"
  );
}

# Print a list of username:mail for users, for instance for /etc/aliases.
# arg1: output file handle
sub PrintAliasesList
{
  my $handle = *STDOUT;
  $handle = $_[0] if $_[0];

  my %email_by_uid;
  print $handle "# Users\n";
  foreach my $line (GetDBLists ("user",
    "status = 'A' ORDER BY user_name", "user_name, email, user_id")
  )
    {
      my ($user_name, $email, $user_id) = @$line;
      next unless $email;
      print $handle "$user_name: $email\n";
      $email_by_uid{$user_id} = $email;
    }

  print $handle "# Squads\n";
  foreach my $line (GetDBLists ("user",
    "status = 'SQD' ORDER BY user_name", "user_name, user_id")
  )
    {
      my ($squad_name, $squad_id) = @$line;
      my $email;
      foreach my $user_id
        (GetDB ("user_squad", "squad_id = '$squad_id'", "user_id"))
        {
          chomp ($user_id);

          # Get previously found email (if not found, it means
          # the squad contains non valid members that we will ignore)
          next unless $email_by_uid{$user_id};

          $email .= ", " if $email;
          $email .= $email_by_uid{$user_id};
        }
      # Skip the squad if it has no members.
      next unless $email;
      print $handle "$squad_name: $email\n";        
  }
}

return 1;
