# Report package version.

use strict;
use Getopt::Long qw (GetOptionsFromArray);
use File::Basename qw (basename);
require Exporter;

our @ISA = qw (Exporter);
our @EXPORT = qw (GetVersion PrintVersionOrHelp get_prog_name);

# Return Savane version.
sub GetVersion
{
  my $version = '@VERSION@';
  return $version unless $version =~ s/gamma.*//;
  return $version . substr ('@SV_GIT_COMMIT@', 0, 6);
}

sub print_copyright_notice
{
  my $line;
  my ($path, $fh) = @_;
  while ($line = <$fh>)
    {
      last if $line =~ m/Copyright/;
    }
  die "Copyright notice not found in $path"
    if $line !~ m/Copyright/;
  $line =~ s,^# ,,;
  print "\n$line";
  while ($line = <$fh>)
    {
      $line =~ s,^# ?,,;
      last if $line eq "\n";
      print $line;
    }
}

sub print_license_notice
{
  my $fh = shift;
  my $line;
  $line = <$fh>; # Skip "This file is " (or "isn't") " part of Savane".
  while ($line = <$fh>)
    {
      last if $line eq "\n";
      $line =~ s,^# ?,,;
      print $line;
    }
}

sub print_legal_notices
{
  my $external = shift;
  my $libdir = '@pkgdatadir@/lib';
  my ($line, $fh);
  my $path = "$libdir/Savane.pm";
  $path = $0 if $external;
  open ($fh, "<:encoding(UTF-8)", $path) or die $!;
  print_copyright_notice ($path, $fh);
  print_license_notice ($fh);
  close ($fh);
}

sub parse_argv
{
  my ($help, $version);
  my @my_argv = @ARGV;
  Getopt::Long::Configure ("pass_through");
  GetOptionsFromArray (\@my_argv, "help" => \$help, "version" => \$version);
  Getopt::Long::Configure ("no_pass_through");
  $version = 0 if $help;
  return ($help, $version);
}

sub get_prog_name
{
  chomp (my $name = `which "$0"`);
  $name = readlink ($name) while -l $name;
  return basename ($name);
}

sub substitute_help_string
{
  my $help_string = shift;
  my ($prog_escaped, $prog_name);
  $prog_name = get_prog_name ();
  ($prog_escaped = $0) =~ s,.,[$&],g;
  $prog_escaped =~ s/,/\\,/g;
  $help_string =~ s,(^|\W)$prog_escaped(\W|$),\1$prog_name\2,g;
  return $help_string;
}

sub print_intro
{
  my ($version, $external) = @_;
  my $prog_name = get_prog_name ();

  my $intro = $external?
    "isn't part of Savane, but is used with it.": "is part of Savane.";
  print "$prog_name $intro\n\n" if $version;
  print "Savane version: ". GetVersion () . "\n";
  print_legal_notices ($external) if $version;
}

sub die_on_init_errors
{
  if (defined $INC{'Savane/DB.pm'})
    {
      require Savane::DB;
      Savane::DB->import ('db_die_if_unconnected');
      db_die_if_unconnected ();
    }
}

# Parse command line, check if help or version options are present,
# print the requested info and exit; else die on init errors.

# $_[0] is help string.
# If $_[1], modify the output to say it isn't part of Savane,
# and extract the legal notices from $0 rather than Savane.pm.
sub PrintVersionOrHelp
{
  my ($help_string, $external) = @_;
  my ($help, $version) = parse_argv ();
  unless ($help || $version)
    {
      die_on_init_errors ();
      return;
    }
  $help_string = substitute_help_string ($help_string);
  print "$help_string\n\n" if $help;
  print_intro ($version, $external);
  exit (0);
}

return "true";
