use strict;
use warnings;
use Time::HiRes 'time';
use File::Temp 'tempfile';
use Geo::IP;
use Savane::Version;

my ($geoip_db, $geoip_db6);

my $help =
"Usage: $0 [OPTIONS]

A URL Mirror redirector for GNU Savannah \"dl\" and \"ftpmirror\" servers.

  -h, --help           show this help and exit
  -v, --version        show Savane version and exit

  Environment variables

GEOIP_DB: path to GeoIP.dat (use GeoIP library default when undefined);

GEOIP6_DB: path to GeoIP6.dat (use GeoIP library default when undefined);

LOG_DIR: path to log directory (no logs when undefined);

MIRROR_FILE: the mirror list to use.
  Suggested values:
  For mirroring 'dl.sv.gnu.org': /opt/mirror-lists/dl-mirrors.txt
  For mirroring ftpmirror.gnu.org: /opt/mirror-lists/gnu-ftpmirrors.txt

PATH_INFO: the relative path of the requested file from the topmost directory.
  It will be concatenated to the URL of the mirror.

REMOTE_ADDR: The IP of the user.

REQUEST_SCHEME: http or https.

TEST: output a test page instead of redirecting.

Running from the command line:

    REMOTE_ADDR=5.6.111.43 \
    REQUEST_SCHEME=http \
    MIRROR_FILE=mirrors.txt \
    LOG_DIR=log \
    PATH_INFO=/datamash/datamash-latest.tar.gz \
    ./mirror-redirect

From NGINX:

    location /releases-redirect {
        gzip off;
        fastcgi_split_path_info            ^(/releases-redirect)(/?.+)\$;
        fastcgi_param PATH_INFO            \$fastcgi_path_info;
        fastcgi_param MIRROR_FILE          /opt/mirror-lists/dl-mirrors.txt;
        fastcgi_param GEOIP_DB             /usr/share/GeoIP/GeoIP.dat;
        fastcgi_param GEOIP6_DB            /usr/share/GeoIP/GeoIPv6.dat;
        fastcgi_param LOG_DIR              /opt/mirror-lists/log/dl;
        fastcgi_param SCRIPT_FILENAME      /opt/cgi-bin/mirror-redirect;

        include fastcgi_params;
        fastcgi_pass unix:/var/run/fcgiwrap.socket;
    }";

PrintVersionOrHelp ($help, 1);

$geoip_db = $ENV{'GEOIP_DB'} if $ENV{'GEOIP_DB'};
$geoip_db6 = $ENV{'GEOIP6_DB'} if $ENV{'GEOIP6_DB'};

# Ensure we have a "REMOTE_ADDR" (this is a CGI script, after all).
my $remote_addr = $ENV{'REMOTE_ADDR'};
die "REMOTE_ADDR envvar not found or empty."
  . "If running from command-line, set REMOTE_ADDR=w.x.y.z "
    unless $remote_addr;
die "Invalid REMOTE_ADDR ($remote_addr)"
  unless $remote_addr =~ /^[0-9a-fA-F\.\:\/]+$/;
my $ip_v6 = $remote_addr =~ /:/;
$geoip_db = $geoip_db6 if $ip_v6;

my $scheme = $ENV{'REQUEST_SCHEME'};
die "REQUEST_SCHEME envvar not found or empty."
  . "If running from command-line, set REQUEST_SCHEME=https "
    unless $scheme;

# Ensure we have a "MIRROR_FILE" variable
# (should be set by the upstream webserver CGI configuration).
my $mirror_file = $ENV{'MIRROR_FILE'};
die "MIRROR_FILE envvar not found or empty."
  . "If running from command line, set MIRROR_FILE=/path/to/file.txt "
    unless $mirror_file;
die "MIRROR_FILE ($mirror_file) not found " unless -e $mirror_file;

# Ensure there is a PATH_INFO component.
my $path_info = $ENV{'PATH_INFO'};
die "PATH_INFO envvar not found or empty."
  . "If running from command line, set PATH_INFO=/path/to/file.txt "
    unless $path_info;
# Silently discard any funky character in the requested URL.
$path_info =~ s/[^\041-\177]//g;

# Make a pretty URL, without extra slashes.
$path_info = "/" . $path_info unless substr ($path_info, 0, 1) eq "/";

my $mirrors;
my $source_countries;

sub load_mirrors
{
  my $path = shift;
  open (my $txt, "<$path") or die qq{Cannot open $path: $!};
  # Lines have either tabs or spaces as separators.
  # Tabs separate source countries from request countries,
  # spaces separate mirrors from their countries.
  while (my $line = <$txt>)
    {
      if ($line =~ /(.*)\t(.*)/)
        {
          $source_countries->{$1} = $2;
          next;
        }
      next unless $line =~ /(.*) (.*)/;
      push @{$mirrors->{$2}}, $1;
    }
  close ($txt);
}

my $gi;
my $default_cc = 'us';

sub open_geoip
{
  my $db = shift;
  return Geo::IP->new (GEOIP_STANDARD) unless defined $db;
  return Geo::IP->open ($db, GEOIP_STANDARD);
}

sub remote_country
{
  my $remote_addr = shift;
  my $ret = ($ip_v6 && $gi->can ('country_code_by_addr_v6'))?
    $gi->country_code_by_addr_v6 ($remote_addr):
    $gi->country_code_by_addr ($remote_addr);
  return $ret unless defined $ret;
  return lc ($ret);
}

sub mk_subdirs
{
  my $d = '';
  while (my $s = shift)
    {
      $d .= "$s/";
      mkdir $d;
      die "can't create $d: $!" unless -d $d;
    }
  return $d;
}

sub log_request
{
  use integer;
  my $t = time ();
  my $hour = $t / 3600;
  my $min = sprintf ('%2.2i', ($t % 3600) / 60);
  unshift @_, $t;
  foreach my $field (@_)
    {
      return if $field =~ /\s/;
    }
  my $log_subdir = mk_subdirs ($ENV{'LOG_DIR'}, $hour, $min);
  return unless $log_subdir;
  my ($fh, $log_file) = tempfile (DIR => $log_subdir, UNLINK => 0);
  print $fh join ("\t", @_) . "\n";
  close ($fh);
}

load_mirrors ($mirror_file);

$gi = open_geoip ($geoip_db, $remote_addr)
  or die qq{Cannot open GeoIP database: $!};

my $remote_cc = remote_country ($remote_addr);
my $source_cc = $source_countries->{$remote_cc || $default_cc};
my @mirror_list = @{$mirrors->{$source_cc || $default_cc}};

my $fallback_mirror = "$scheme://download-mirror.savannah.gnu.org/releases";
# $fallback_mirror shouldn't be used.  That can't occur unless
# we have no mirrors in $default_cc.
my $mirror = $mirror_list[rand (1 + $#mirror_list)] || $fallback_mirror;
my $url;

$mirror =~ s|/*$||;
$url = "$mirror$path_info";

log_request ($path_info, $mirror, $source_cc || 'n/a', $remote_cc || 'n/a')
  if $ENV{'LOG_DIR'};

unless ($ENV{'TEST'})
  {
    print "HTTP/1.1 302 Found\r\nLocation: $url\r\n\r\n";
    exit (0);
  }

my $country = ($ip_v6 && $gi->can ('country_name_by_addr_v6'))?
  $gi->country_name_by_addr_v6 ($remote_addr):
  $gi->country_name_by_addr ($remote_addr);
$country ||= "(unknown)";

my $msg =<<"EOF";
  content-type: text/plain\r
  \r
  GNU Savannah - mirror check

  Detected remote address: $remote_addr [$remote_cc]
  Detected country: $country
  Suggested mirror: $mirror [$source_cc]

  (reload the page to see other mirrors for your country)
EOF
$msg =~ s,  ,,mg;
print $msg;

exit (0);
