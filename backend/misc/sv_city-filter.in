use strict;
use Getopt::Long;
use Savane::Version;

my $max_cities = 51;

my $help_msg =
"Usage: $0 [OPTIONS] < cities15000.txt > cities15000

Exclude excessive info from GeoNames cities15000.txt to reduce size.

  -h, --help           show this help and exit
  -v, --version        show Savane version and exit
      --max-cities     maximum number of cities per country [$max_cities]";

PrintVersionOrHelp ($help_msg);

GetOptions ("max-cities=i" => \$max_cities) or die ("Wrong command line.\n");

my $out_lines;
my $population;

while (<>)
  {
    if (/^\s*#/)
      {
        print;
        next;
      }
    chomp;
    my @a = split /\t/;
    # Cut lat and lon precision to 1/100 degree.
    $a[4] =~ s,(\...).*,$1,;
    $a[5] =~ s,(\...).*,$1,;
    $out_lines->{$a[8]}->{$a[0]} = "$a[4]\t$a[5]\t$a[8]\t$a[14]\n";
    $population->{$a[8]}->{$a[0]} = $a[14];
  }

my @codes = sort keys %{$out_lines};

foreach my $cc (@codes)
  {
    my %cities = %{$population->{$cc}};
    my @entries = sort { $cities{$a} <=> $cities{$b} } keys %cities;
    my $i = 0;
    foreach my $e (@entries)
      {
        last if (++$i > $max_cities && $max_cities > 0);
        print $out_lines->{$cc}->{$e};
      }
  }
exit (0);
