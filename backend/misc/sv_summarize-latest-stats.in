use strict;
use File::Copy 'move';
use Getopt::Long;
use Savane::Mirror;
use Savane::Version;

my $out_dir = '@mirror_stat_dir@';
my $site_name = default_dl_site_name ();

my $help_msg =
"Usage: $0 [OPTIONS]

Summarize latest requests collected from mirror-redirect.
Typically used indirectly from sv_collect-mirror-stats.

  -h, --help    show this help and exit
  -v, --version show Savane version and exit
  -d, --dir     working directory [$out_dir]
  -n, --name    website name [$site_name]";

PrintVersionOrHelp ($help_msg);

GetOptions ('d|dir=s' => \$out_dir, 'n|name=s' => \$site_name)
  or die ("Wrong command line");

sub format_date
{
  my $t = shift;
  $t =~ s/\.*//;
  $t = `date -d \@$t`;
  chomp $t;
  return $t;
}

sub format_period
{
  my ($t0, $t1) = @_;
  return undef unless defined $t0;
  return format_date ($t0) . " ... " . format_date ($t1);
}

sub parse_latest
{
  my $filename = shift;
  my ($counts, $period, $t, $t1, @vals);
  open (my $fh, "<$filename")
    or die qq{Can't open $filename for reading: $!};
  while (my $line = <$fh>)
    {
      chomp $line;
      ($t, @vals) = split "\t", $line;
      $t1 = $t unless defined $t1;
      my $i;
      for ($i = 0; $i <= $#vals; $i++)
        {
          $counts->{$i}->{$vals[$i]}++;
        }
    }
  close ($fh);
  return ($counts, format_period ($t, $t1));
}

sub output_html_header
{
  my ($fh, $total, $label, $period) = @_;
  print $fh html_header ("$site_name$label");
  print $fh "<h1>Numbers of latest requests$label</h1>\n";
  print $fh "<p>Website: $site_name</p>\n";
  print $fh "<p>Period: $period</p>\n" if defined $period;
  print $fh "<p>Total requests: $total</p>\n<dl>\n";
}

sub output_html
{
  my ($counts, $filename, $label, $period) = @_;
  my $total = 0;
  my @sorted =
    sort { $counts->{$b} <=> $counts->{$a} or $a cmp $b } keys %{$counts};
  foreach my $val (@sorted)
    {
      $total += $counts->{$val};
    }
  $filename .= ".html";
  open (my $fh, ">$filename")
    or die qq{Can't open $filename for writing: $!};
  output_html_header ($fh, $total, $label, $period);
  foreach my $val (@sorted)
    {
      print $fh "<dt>$val</dt><dd>$counts->{$val}</dd>\n";
    }
  print $fh "</dl>\n</body>\n</html>\n";
  close ($fh);
  return $filename;
}
my $filename = "$out_dir/latest-requests";
my $html_dir = mk_html_dir ($out_dir);
my ($counts, $period) = parse_latest ($filename);
foreach my $idx (keys %{$counts})
  {
    my $file = output_html (
      $counts->{$idx}, "$filename.$idx", stat_field_label ($idx + 1), $period
    );
    move ($file, $html_dir);
  }

exit (0);
