# This script should be used via a cronjob to clean up the system and
# the database.
#
# This script should run every hour at least.

use strict;
use Savane;
use Getopt::Long;
use Term::ANSIColor qw(:constants);
use POSIX qw(strftime);
use Time::Local;

our $dbd;
our $sys_banned_email_domains;

my $script = "sv_cleaner";
my $logfile = "/var/log/sv_cleaner.log";
my $help;
my $big_cleanup;
my $dry_run;
my $cron;
my @trackers = ("bugs", "support", "task", "patch", "cookbook");

$help =
"Usage: $0 [OPTIONS]

Clean up the database:

  * old form ids, sessions, lost password requests;
  * banned, idle and unconfirmed user accounts;

  (--big-cleanup)

  * groups marked for deletion, including tracker items, news &c.;
  * mailing lists marked for deletion;
  * news marked for deletion as well as unapproved for a long time;
  * orphan user data---bookmarks, sessions, preferences &c.

  -h, --help         show this help and exit
  -v, --version      show Savane version and exit
      --big-cleanup  take care of less frequent cases; typically runs monthly
      --cron         ignored
      --logfile      file for reports [$logfile]
      --dry-run      skip updating the database";

PrintVersionOrHelp ($help);

GetOptions (
  "cron" => \$cron, "big-cleanup" => \$big_cleanup, "dry-run" => \$dry_run,
  "logfile=s" => \$logfile
) or die ("Wrong command line.");

open (LOG, ">>$logfile") or die $!;
sub add_to_log
{
  print LOG strftime "[$script] %c $_[0]\n", localtime;
}

sub log_with_dr
{
  my $dr_str = $dry_run? " (dry run)": "";
  add_to_log ("---- $_[0]$dr_str");
}

sub log_result
{
  my ($msg, $result) = @_;
  log_with_dr ($msg) if $result > 0;
}

add_to_log ("- starting");

sub delete_db
{
  my ($table, $condition) = @_;
  return DeleteDB ($table, $condition) unless $dry_run;
  my @ret = GetDB ($table, $condition, "count(*)");
  return shift @ret;
}

sub delete_and_log
{
  my ($table, $condition, $msg) = @_;
  my $result = delete_db ($table, $condition);
  log_result ("deleted $result $msg", $result);
}

AcquireReplicationLock;

# Normal cleanup.

# Remove user account registration not confirmed after three days.
delete_and_log (
  "user",
  "status = 'P' AND TIMESTAMPDIFF(hour, FROM_UNIXTIME(add_date), NOW()) > 71",
  "unconfirmed user accounts"
);

delete_and_log ("groups", "status = 'D'", "deleted groups");

# Remove too old form_id, forms created more than one day ago an still
# not submitted.
delete_and_log (
  "form", "TIMESTAMPDIFF(hour, FROM_UNIXTIME(timestamp), now()) > 23",
  "outdated form ids"
);

# Remove session more than one year old.
delete_and_log (
  "session", "TIMESTAMPDIFF(day, FROM_UNIXTIME(time), now()) > 365",
  "sessions older than one year"
);

delete_and_log ("user_lostpw", "TIMESTAMPDIFF(hour, date, now()) > 23",
  "lost password requests"
);

sub send_notification
{
  my ($name, $email) = @_;
  my $input;
  open ($input, '|-', 'sendmail -t');
  print $input
    "From: <INVALID.NOREPLY\@gnu.org>\n"
    . "To: <$email>\n"
    . "Subject: Your Savannah account <$name>\n"
    . "\n"
    . "Your Savannah account <$name> is automatically\n"
    . "removed due to inactivity.\n"
    . "\n"
    . "For criteria of removing idle accounts, please check\n"
    . "https://savannah.gnu.org/maintenance/IdleAccounts/ .\n";
  close ($input);
}

my @user_tables = (
  "user_group", "user_squad",
  "user_bookmarks", "user_preferences", "user_votes", "session"
);

sub purge_account_aux_data
{
  my ($id) = @_;
  foreach my $t (@user_tables)
    {
      delete_and_log ($t, "user_id = $id", "#$id $t");
    }
}

sub purge_account
{
  my ($id, $name) = @_;
  my $result = delete_db ("user", "user_id = $id");
  log_result ("purged account #$id <$name>", $result);
}

sub suspend_account
{
  my ($id, $name, $email) = @_;
  log_with_dr ("suspended account #$id <$name>");
  return if $dry_run;
  $dbd->do ("UPDATE group_history"
    . " SET old_value = '_$id' WHERE old_value = '$name'"
  );
  $dbd->do (<<"  EOF");
    UPDATE user
    SET
      user_name = '_$id', user_pw = '!', realname = '-*-', status = 'S',
      email = 'idontexist\@example.net', confirm_hash = '',
      authorized_keys = '', people_view_skills = 0, people_resume = '',
      timezone = 'GMT', theme = '', gpg_key = '', email_new = ''
    WHERE user_id = $id
  EOF
}

sub domain_is_banned
{
  my ($email) = @_;
  return 0 if $sys_banned_email_domains eq "";
  return $email =~ /$sys_banned_email_domains/;
}

sub remove_account
{
  my ($id, $name, $email, $active) = @_;

  if ($active < 1)
    {
      purge_account ($id, $name);
    }
  else
    {
      suspend_account ($id, $name, $email);
    }
  purge_account_aux_data ($id);
  return if $dry_run;
  send_notification ($name, $email) unless domain_is_banned ($email);
}

sub account_has_tracker_history
{
  my ($id) = @_;

  foreach my $tracker (@trackers)
    {
      foreach my $line (GetDB ($tracker, "submitted_by = $id limit 1"))
        {
          return 1;
        }
      foreach my $line (GetDB ($tracker . "_history", "mod_by = $id limit 1"))
        {
          return 1;
        }
    }
  return 0;
}

sub account_has_group_history
{
  my ($name) = @_;
  my $active = 0;
  foreach my $line (
    GetDB ("group_history", "old_value = '$name'", "field_name")
  )
    {
      chomp ($line);
      if ($line eq 'User Requested Membership')
        {
          $active = 1;
        }
      return 2;
    }
  return $active;
}

sub account_belongs_groups
{
  my ($id) = @_;
  foreach my $line (
    GetDB ("user_group", "user_id = '$id' AND admin_flags != 'P' limit 1")
  )
    {
      return 1;
    }
  return 0;
}

sub account_is_active
{
  my ($id, $name) = @_;
  my $has_history;
  $has_history = account_has_tracker_history ($id);
  if ($has_history)
    {
      return 2;
    }
  $has_history = account_has_group_history ($name);
  return 2 if ($has_history > 1);
  return 2 if (account_belongs_groups ($id));
  return $has_history;
}

sub clean_account
{
  my ($user, $t0, $t1) = @_;
  my $active = 0;
  my ($id, $name, $realname, $email, $status, $da, $ut) = split (",", $user);

  return if ($ut > $t1 && !domain_is_banned ($email));
  $active = account_is_active ($id, $name);
  return if $active > 1;
  add_to_log ("---- removing $user: $active");
  remove_account ($id, $name, $email, $active);
}

sub clean_idle_accounts
{
  my $t1 = `date +%s` - 17 * 24 * 3600;
  my $t0 = $t1 - 24 * 3600;

  add_to_log ("---- clean idle; banned domains: ($sys_banned_email_domains)");
  foreach my $user (
    GetDB (
      "user", "status = 'A' AND add_date > $t0",
      "user_id, user_name, realname, email, status, "
      . "from_unixtime(add_date), add_date"
    )
  )
    {
      chomp ($user);
      clean_account ($user, $t0, $t1);
    }
}
clean_idle_accounts;

sub finish_work
{
  add_to_log ("- work finished");
  print LOG "[$script] ------------------------------------------------------\n";
  exit 0;
}

finish_work unless ($big_cleanup);

sub delete_news
{
  my ($message, $term, $is_approved) = @_;
  my $condition =
    "TIMESTAMPDIFF(day, FROM_UNIXTIME(date_last_edit), NOW()) > $term "
    . "AND is_approved = $is_approved";
  delete_and_log ("news_bytes", $condition, $message);
}

sub cleanup_news
{
  delete_news ("news unapproved for a year", 374, 5);
  delete_news ("news removed more than a month ago", 34, 4);
}
cleanup_news;

# Remove items from groups that no longer exists in the database.
# When a group is deleted, its items no longer make sense.
#
# It will also make sure that no configuration remains, or user associated
# with the group.

# First build an hash of valid group_id. We take as valid any group_id
# actually in the database. We want to remove items only if the group
# no longer exists in the database.
my @group_ids = GetGroupList ("1", "group_id");
my %group_exists;
for (@group_ids)
  {
    $group_exists{$_} = 1;
  }

# Browse each tracker item to found out if there are items to trash.
foreach my $tracker (@trackers)
  {
    my @items_to_delete;

    # Find items to delete in tracker-specific tables.
    foreach my $line (GetDB ($tracker, "1", "bug_id,group_id"))
      {
        chomp ($line);
        my ($item_id, $group_id) = split (",", $line);

        next if $group_exists{$group_id};
        push (@items_to_delete, $item_id);
        log_with_dr (
          "deleted $tracker #$item_id from dead group #$group_id"
        );
      }

    next if $dry_run;
    # Now do the cleanup on trackers.
    foreach my $item (@items_to_delete)
      {
        # Clean tables that are tracker-specific.
        DeleteDB ($tracker, "bug_id = '$item'");
        DeleteDB ($tracker . "_cc", "bug_id = '$item'");
        DeleteDB ($tracker . "_history", "bug_id = '$item'");
        DeleteDB ($tracker . "_dependencies",
          "item_id = '$item' OR (is_dependent_on_item_id = '$item' "
          . "AND is_dependent_on_item_id_artifact = '$tracker')");

        # Clean tables that are common to all trackers.
        DeleteDB ("trackers_file",
          "artifact = '$tracker' AND item_id = '$item'");
      }
  } # foreach my $tracker (@trackers)

# Now look in others tables to find if there was entries of deleted
# groups. To keep it simple and not too much rendudant, we first get
# all the dead group_id, and then we run simple delete on all table
# where these groups id exists.
my @dead_group_id;
my %dead_group_id_already_found;

my @tables = ("user_group", "groups_default_permissions", "group_preferences",
  "group_history", "news_bytes", "forum_group_list", "trackers_watcher"
);

# Find group ids of orphan items in table $_[0].
sub mark_dead_groups
{
  my $table = shift;
  foreach my $line (GetDB ($table, "1", "group_id"))
    {
      chomp ($line);
      my ($group_id) = split (",", $line);

      next if $group_exists{$group_id};
      next if $dead_group_id_already_found{$group_id};

      push (@dead_group_id, $group_id);
      $dead_group_id_already_found{$group_id} = 1;
    }
}

foreach my $table (@tables)
  {
    mark_dead_groups ($table);
  }

my @suffices = ("_report", "_field_usage", "_field_value");
# Find entries to delete in trackers query forms (don't bother removing
# the query forms in depth values, they won't be visible anyway
# since they refer to a query id that will be made bogus.
# Do exactly the same for group field values.
foreach my $tracker (@trackers)
  {
    foreach my $suf (@suffices)
      {
        mark_dead_groups ("$tracker$suf");
      }
  }
my @table_list = @tables;
foreach my $tracker (@trackers)
  {
    foreach my $suf (@suffices)
      {
        push (@table_list, "$tracker$suf");
      }
  }

foreach my $group_id (@dead_group_id)
  {
    die "Strange group id found for dead group, exiting" if $group_id eq "";
    log_with_dr (
      "delete anything else that belong in dead group #$group_id"
    );
    next if $dry_run;
    foreach my $table (@table_list)
      {
        DeleteDB ($table, "group_id = '$group_id'");
      }
  } # foreach my $group_id (@dead_group_id)

foreach my $table (@user_tables)
  {
    my @res = GetDB ("$table p LEFT JOIN user u ON p.user_id = u.user_id",
      "u.user_id IS NULL OR u.status = 'S' GROUP BY p.user_id", "p.user_id"
    );
    foreach my $line (@res)
      {
        chomp ($line);
        my ($uid) = split (",", $line);
        delete_and_log ($table, "user_id = $uid", "#$uid orphan $table");
      }
  }
finish_work;
