use strict;
use Savane;
use Savane::Util;
use Getopt::Long;
use Time::Local;
use Date::Calc qw(Add_Delta_YMD);

our $sys_name;
our $sys_https_host;
our $sys_default_domain;
our $sys_url_topdir;
our $dbd;

my $script = "sv_reminder";
my $logfile = "/var/log/sv_reminder.log";
my $help;
my $verbose;
my $dry_run;
my $max = "2000";
my $max_items = "50";
my $cron;
my @trackers  = ("bugs", "task", "support", "patch");

$help =
"Usage: $0 [OPTIONS]

Send reminders to users in some specific cases.

1. An item is about to start or finish, all people from the item
   notification list should be warned. (not implemented)

2. Users decided to receive a batch of open items assigned to
  them each x days, minimum priority 5.

This script is supposed to run twice a day.

  -h, --help       show this help and exit
  -v, --version    show Savane version and exit
      --cron       ignored
      --dry-run    don't send emails, log them instead
      --verbose    log extra information
      --max        maximum number of mails sent by the script; if that number
                     is reached, next mails are discarded and tagged as sent;
                     make sure this parameter fits your
                     number of users and servers possibilities [$max]
      --max-items  maximum number of items mentioned in a mail;
                     set it to avoid sending extremely big mails [$max_items]
      --logfile    file for reports [$logfile]";

PrintVersionOrHelp ($help);

GetOptions (
  "cron" => \$cron, "max=s" => \$max, "max-items=s" => \$max_items,
  "verbose" => \$verbose, "dry-run" => \$dry_run, "logfile=s" => \$logfile
) or die "Wrong command line";

$dbd->{mysql_enable_utf8} = 1;

open_log ($logfile, $script, $dry_run);

# Values for batch_frequency: 0 = none, 1 = daily, 2 = weekly, 3 = monthly.
sub decode_freq
{
  my $freq = $_[0];
  # $names[0] may not be correct English, but it shouldn't show up in output,
  # anyway.
  my @names = ("neverly", "daily", "weekly", "monthly");
  return 'unknown' unless $freq >= 0 && $freq <= $#names;
  return $names[$freq];
}

AcquireReplicationLock ();

# List of users supposed to receive a batch.
my %user;

# items{user} = ("bugs,54212", "patch,1321")
my %items;

# summary{"bugs,542"} = summary of the item.
my %summary;

# Determine the timestamp of one month ago, one week ago and one day ago.
# With these, we'll run only 3 SQL command and find out which users need
# to receive a bach.
my $date0 = time;
my $now = timelocal (localtime ($date0));

sub date_before
{
  my ($d0, $dd, $dm) = @_;
  my ($sec, $mi, $h, $d, $m, $y) = localtime ($d0);
  ($y, $m, $d) = Add_Delta_YMD ($y + 1900, $m + 1, $d, 0, -$dm, -$dd);
  return timelocal ($sec, $mi, $h, $d, $m - 1, $y - 1900);
}

$date0 += 289; # Allow for differences in script launch time.
my $daybefore = date_before ($date0, 1, 0);
my $weekbefore = date_before ($date0, 7, 0);
my $monthbefore = date_before ($date0, 0, 1);

print_log ("time before: day $daybefore, week $weekbefore; month $monthbefore")
  if $verbose;

print_log ("date before: day " . localtime ($daybefore)
  . ", week " . localtime ($weekbefore) . ", month " . localtime ($monthbefore)
) if $verbose;

my %user_frequency;
my %user_email;
my %user_names;
my %realnames;
my %last_sent;

# Find eligible users.
foreach my $line
  (
    GetDB (
      "user_preferences p, user u",
      "preference_name = 'batch_frequency' AND preference_value <> '0'
       AND u.user_id = p.user_id AND u.status = 'A'",
      "u.user_id, user_name, realname, email, preference_value"
    )
  )
  {
    chomp ($line);
    my ($user_id, $user_name, $realname, $email, $freq) = split (",", $line);
    $user_frequency{$user_id} = $freq;
    $realname =~ s/\://g;
    $realnames{$user_id} = $realname;
    $user_names{$user_id} = $user_name;
    $user_email{$user_id} = $email;
    print_log ("user #$user_id, frequency $freq: $realname <$email>")
      if $verbose;
}

sub period_expired
{
  my ($lastsent, $freq) = @_;

  return 0 unless $freq;
  return ($lastsent < $monthbefore) if $freq == 3;
  return ($lastsent < $weekbefore) if $freq == 2;
  return $lastsent < $daybefore;
}

sub delete_db
{
  my ($table, $condition) = @_;
  return DeleteDB ($table, $condition) unless $dry_run;
  my @ret = GetDB ($table, $condition, "count(*)");
  return shift @ret;
}

sub delete_and_log
{
  my ($table, $condition, $msg) = @_;
  my $result = delete_db ($table, $condition);
  print_log ("deleted $result $msg") if $verbose;
}

sub clear_preferences
{
  my $id = $_[0];
  delete_and_log (
    "user_preferences",
    "user_id = $id
     AND preference_name IN ('batch_frequency', 'batch_lastsent')",
    "preferences of user #$id"
  );
}

# Check if it's time to send a reminder; reset $user_frequency{$user_id}
# to zero for those who needn't reminders yet.
# When no batch_lastsent entry is found, assume the reminder is needed.
foreach my $line
  (
    GetDB (
      "user_preferences", "preference_name = 'batch_lastsent'",
      "user_id, preference_value"
    )
  )
  {
    chomp ($line);
    my ($id, $lastsent) = split (",", $line);
    $last_sent{$id} = $lastsent;
    print_log ("last sent (user #$id): " . localtime ($lastsent)) if $verbose;
    clear_preferences ($id)
      unless (exists $user_frequency{$id} && $user_frequency{$id});
    $user_frequency{$id} = 0
      unless period_expired ($lastsent, $user_frequency{$id});
  } # foreach my $line...

# Case 1: an item is about to start or finish, assignee should be warned.

# Not implemented yet.

# Case 2: users decided to receive a batch of open item assigned to them
# each x days.

my @user_case2;

# Get last sent timestamps.
foreach my $user_id (keys %user_names)
  {
    next unless $user_frequency{$user_id};
    my $lastsent = "never sent";
    my $batch = decode_freq ($user_frequency{$user_id});
    $lastsent = "last sent " . localtime $last_sent{$user_id}
      if exists $last_sent{$user_id};
    push (@user_case2, $user_id);
    print_log ("case2 for $batch batch: user #$user_id, $lastsent")
      if $verbose;
  } # foreach my $line...

# Look for open items assigned to users who want to receive a batch.
foreach my $tracker (@trackers)
  {
    foreach my $user_id (@user_case2)
      {
        my $no_items = 1;
        foreach my $line
          (
            GetDB (
              $tracker,
              "assigned_to='$user_id' AND status_id = '1' AND priority >= 5",
              "bug_id, summary"
            )
          )
          {
            chomp ($line);
            my ($item_id, $summary) = split (",", $line);
            print_log ("case2: $user_id, $tracker $item_id $summary")
              if $verbose;
            my $idx = "$tracker,$item_id";
            push (@{$items{$user_id}}, $idx);
            $summary{$idx} = $summary;
            $no_items = 0;
          }
        print_log ("case2: no items for user #$user_id")
          if ($verbose && $no_items);
      }
  }

my $count = 0;
my $basepath;

$sys_url_topdir .= "/" unless $sys_url_topdir =~ m,/$,;

if ($sys_https_host)
  {
    $basepath = "https://$sys_https_host$sys_url_topdir";
  }
else
  {
    $basepath = "http://$sys_default_domain$sys_url_topdir";
  }

foreach my $user_id (keys %items)
  {
    if (++$count > $max)
      {
        print_log ("mail count $max overflow");
        last;
      }

    next unless $user_id;
    next unless $user_email{$user_id};

    my $title = "$sys_name reminder";

    my $mail = <<"    EOF";
      Hello, $realnames{$user_id}!

      This reminder is sent to you because you requested it
      in your $sys_name account <$user_names{$user_id}> notification settings.

    EOF
    $mail =~ s/^      //gm;

    my $itemcount;
    foreach my $item (@{$items{$user_id}})
      {
        if (++$itemcount > $max_items)
          {
             $mail .=
               "\nThere are other items for you but we don't mention more\n"
               . "than $max_items items in a mail.\n";
             print_log ("item count $max_items overflow for user #$user_id");
             last;
          }

        my ($tracker, $item_id) = split (",", $item);
        $mail .= "- $tracker #$item_id: $summary{$item}\n    ";
        $mail .= "<$basepath$tracker/?$item_id>\n";
      }

    $mail .= <<"    EOF";

      You can change your personal notification settings at
      <${basepath}my/admin/change_notifications.php>
    EOF
    $mail =~ s/^      //gm;

    MailSend ($user_email{$user_id}, $title, $mail) unless $dry_run;
    next unless $verbose;
    print_log (
      "------------------------------------------------------------\n"
      . "To:     #$user_id $realnames{$user_id} <$user_email{$user_id}>\n"
      . "Subject: $title\n"
      . "$mail"
    );
  } # foreach my $user_id (keys %items)

sub reset_lastsent
{
  my ($prefix, $id) = @_;
  return unless $id;
  if ($dry_run || $verbose)
    {
      print_log ("resetting batch_lastsent for $prefix #$id");
      return;
    }
  InsertDB (
     "${prefix}_preferences",
     "${prefix}_id, preference_name, preference_value",
     "$id, 'batch_lastsent', 0"
  ) unless exists $last_sent{$id};
  SetDBSettings (
    "${prefix}_preferences",
    "${prefix}_id = '$id' AND preference_name = 'batch_lastsent'",
    "preference_value = '$now'"
  );
}

foreach my $user_id (@user_case2)
  {
    reset_lastsent ("user", $user_id);
  }

finalize_log ("mails sent: $count");
