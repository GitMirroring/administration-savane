# Run from dl:/etc/cron.d/sv-mirmon.
# See https://savannah.gnu.org/maintenance/Mirroring.
#
# Convert the plain text FTP file listing ftp.gnu.org mirrors into
# mirmon format.  Extract either just the http mirrors (used for
# the automatic redirect at ftpmirror.gnu.org) or all the
# mirrors (used by humans for checking).
#
# Output is to the second cmdline argument.  stdout isn't good because
# we don't want to blindly overwrite a good file if something goes wrong.

use LWP::Simple;
use Locale::Country;
use Getopt::Long;
use Savane::Version;

sub get_loc_and_urls
{
  my ($line, $http_only) = @_;
  my ($loc, $url);
  # The lines we care about look like:
  #   LOCATION - URL[, URL]...
  return ('', '')
    unless $line =~ m,^(.*?) - (.*://.*)$,;  # Non-greedy just in case.

  ($loc, $urls) = ($1, $2);
  # Additional marks at the end of location like [cn, js]:
  # when using for redirections, such mirrors are skipped,
  # in the --all mode, the marks are ignored.
  if ($loc =~ m/(.*) \[.*\]$/)
    {
      return ('', '') if $http_only;
      $loc = $1;
    }
  $urls =~ s,\(.*\)*,,;  # Eliminate random text in parens.

  # The location might have a subpart, as in US-Oregon; drop that.
  $loc =~ s/-.*//;
  return ($loc, $urls);
}

sub get_country_code
{
  my ($loc, $line) = @_;
  # Locale::Codes 3.25 coming with Trisquel 7.0 doesn't let the 'Russia' alias
  # register saying it's already in use, but country2code returns undef for it.
  return 'ru' if lc ($loc) eq 'russia';
  my $country_code = Locale::Country::country2code ($loc);
  warn "no country code for '$loc' (line $line)" unless defined $country_code;
  return $country_code;
}

sub add_country_name
{
  my ($code, $alias) = @_;
  return if Locale::Country::country2code ($alias);
  my $name = Locale::Country::code2country ($code);
  Locale::Country::add_country_alias ($name, $alias);
}

sub split_urls
{
  my ($u, $country_code, $http_only) = @_;
  # Drop leading and trailing whitespace, better not be any more.
  $u =~ s,^\s*,,;
  $u =~ s,\s*$,,;
  if ($u =~ /\s/)
    {
      warn "URL contains whitespace character: $u";
      return '';
    }
  # Need trailing / (mirmon adds it anyway).
  $u .= "/" unless $u =~ m,/$,;
  return '' unless ($u =~ /^http/ || !$http_only);;
  return "$country_code $u\n";
}

my $all = '';
my $http_only = '';
my $origin = 'https://www.gnu.org/prep/FTP';
my $help_msg =
"Usage: $0 [OPTIONS] DEST-FILE

Extract mirror lists from $origin.
Run from dl:/etc/cron.d/sv-mirmon.
See https://savannah.gnu.org/maintenance/Mirroring.

  -h, --help           show this help and exit
  -v, --version        show Savane version and exit
      --http-only      only extract HTTP and HTTPS URLs
      --all            extract all URLs, including FTP and RSYNC
      --prep-ftp       URL of the source [$origin]";

PrintVersionOrHelp ($help_msg);

GetOptions (
  "all" => \$all, "http-only" => \$http_only, 'prep-ftp=s' => \$origin
) or die "Wrong command line.\n";

die "Destination file is unspecified.\n" if $#ARGV < 0;
die ("Specify --all or --http-only.\n") unless ($all || $http_only);
# $all is mutually exclusive with $http_only and is ignored further.

my $dest = $ARGV[0];
open (DEST, ">$dest") || die ("open(>$dest) failed: $!");

my $origlist = LWP::Simple::get ($origin);
die 'GNU mirror list unavailable' unless $origlist;
my @ret = ();

# Zap everything up to the start of the mirror list.
# Try to check for the substitutions failing,
# since if we don't eliminate the header/trailer text,
# nothing good can result.
my $srclist = $origlist;
$srclist =~ s,.*\n\* GNU mirror list\n,,s;
die "no \"* GNU mirror list\", source text changed? (in $srclist)"
  unless $srclist ne $origlist;

# We want UK to work, not just Great Britain.
add_country_name ('gb', 'UK');
# Use 'uk' for that country.
Locale::Country::rename_country_code ('gb', 'uk');
# Cases we've noticed where the function fails; extend as needed.
add_country_name ('us', "US");
add_country_name ('kr', "Korea");
add_country_name ('rs', "Serbia");

my $line_no = 0;
# In the main mirror list.
for my $line (split ("\n", $srclist))
  {
    $line_no++;
    my ($loc, $urls) = get_loc_and_urls ($line, $http_only);
    next if $loc eq '';
    my $country_code = get_country_code ($loc, "$line_no: $line");

    for my $u (split (/, */, $urls))
      {
        $u = split_urls ($u, $country_code, $http_only);
        push (@ret, $u) unless $u eq '';
      }
  } # for my $line (split ("\n", $srclist))
die "found no mirmon entries?! (from $srclist)" unless @ret;

# Order doesn't matter to mirmon, so write it as we read it.
print DEST @ret;
close (DEST) || die ("close(>$dest) failed $!");

exit (0);
