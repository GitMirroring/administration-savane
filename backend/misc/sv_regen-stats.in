use strict;
use File::Copy 'move';
use File::Basename 'dirname';
use Getopt::Long;
use Savane::Mirror;
use Savane::Version;

my $site_name = default_dl_site_name ();
my $file;

my $help_msg =
"Usage: $0 [OPTIONS] PATH/YEAR-MO.IDX

Regenerate HTML reports from sv_collect-mirror-stats data file.
Typically used indirectly from sv_collect-mirror-stats.

  -h, --help    show this help and exit
  -v, --version show Savane version and exit
  -n, --name    website name [$site_name]";

PrintVersionOrHelp ($help_msg);

GetOptions ('n|name=s' => \$site_name) or die ("Wrong command line");
die qq{Wrong number of command line arguments} unless $#ARGV == 0;
$file = $ARGV[0];

die qq{File $file doesn't exist} unless -f $file;

sub extract_year_month_idx
{
  my $tmp = shift;
  $tmp =~ s,.*/,,;
  die qq{File name $tmp doesn't match pattern}
    unless $tmp =~ /^(\d{4})-(\d\d)[.](\d+)$/;
  return ($1, $2, $3);
}

sub parse_file
{
  my $filename = shift;
  my ($counts, $total);
  open (my $fh, "<$filename")
    or die qq{Can't open $filename for reading: $!};
  while (my $line = <$fh>)
    {
      chomp $line;
      my ($val, $no) = split "\t", $line;
      $counts->{$val} = $no;
      $total += $no;
    }
  close ($fh);
  return ($counts, $total);
}

sub output_html_header
{
  my ($fh, $total, $file) = @_;
  my ($year, $month, $idx) = extract_year_month_idx ($file);
  my $label = stat_field_label ($idx);
  my $date = "$year-$month";
  chomp $date;
  print $fh html_header ("$site_name$label");
  print $fh "<h1>$site_name statistics$label</h1>\n";
  print $fh "<p>Period: $date</p>\n";
  print $fh "<p>Total requests: $total</p>\n<dl>\n";
}

my $cnt;

sub by_cnt
{
  return $cnt->{$b} <=> $cnt->{$a} || $a cmp $b;
}

sub output_html
{
  my ($counts, $total, $filename) = @_;
  my ($year, $month, undef) = extract_year_month_idx ($file);
  my $html_dir = mk_html_dir (dirname ($file), "$year-$month");
  $cnt = $counts;
  my @sorted = sort by_cnt keys %{$counts};
  my $html = "$filename.html";
  open (my $fh, ">$html")
    or die qq{Can't open $html for writing: $!};
  output_html_header ($fh, $total, $filename);
  foreach my $val (@sorted)
    {
      print $fh "<dt>$val</dt><dd>$counts->{$val}</dd>\n";
    }
  print $fh "</dl>\n</body>\n</html>\n";
  close ($fh);
  move ($html, $html_dir);
  return $html_dir;
}

sub enumerate_groups
{
  my $counts = shift;
  my $groups;
  foreach my $val (keys %$counts)
    {
      my $grp = $val;
      $grp =~ s,^/,,;
      $grp =~ s,/.*,, or $grp = '[root]';
      push @{$groups->{$grp}}, $val;
    }
  return $groups;
}

sub group_entry
{
  my ($grp, $groups, $counts, $i) = @_;
  $cnt = $counts;
  my @vals = sort by_cnt @{$groups->{$grp}};
  my $total = 0;
  my $grp_id = $grp;
  $grp_id =~ s,[^\w],_,g;
  my $head = "<h2 id='$grp_id-$i'>$grp</h2>\n\n<dl>\n";
  my $list = '';
  $grp = '' if $grp eq '[root]';
  foreach my $v (@vals)
    {
      my $name = $v;
      $name =~ s,^/?$grp/,,;
      $list .= "<dt>$name</dt><dd>$counts->{$v}</dd>\n";
      $total += $counts->{$v};
    }
  $head .= "<dt>total requests</dt><dd>$total</dd>\n";
  return "$head$list</dl>\n\n";
}

sub output_groupped
{
  my ($counts, $total, $filename) = @_;
  my $html = "$filename-groupped.html";
  my $groups = enumerate_groups ($counts);
  my $i = 0;
  open (my $fh, ">$html")
    or die qq{Can't open $html for writing: $!};
  output_html_header ($fh, $total, $filename);
  my @sorted = sort keys %{$groups};
  foreach my $grp (@sorted)
    {
      print $fh group_entry ($grp, $groups, $counts, $i++);
    }
  print $fh "</dl>\n</body>\n</html>\n";
  close ($fh);
  return $html;
}

my ($counts, $total) = parse_file ($file);
my $html_dir = output_html ($counts, $total, $file);

exit (0) unless $file =~ /\.1$/;
my $out_file = output_groupped ($counts, $total, $file);
move ($out_file, $html_dir);
exit (0);
