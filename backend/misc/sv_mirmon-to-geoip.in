# Use mirmon state (first arg) to filter a list of hosts (second arg)
# to write another list of hosts (third arg) with the stale hosts removed.
#
# This is the common script called to make the host lists
# for all three multiplexors.
#
# See http://savannah.gnu.org/maintenance/Mirroring.

use strict;
use warnings;
use Getopt::Long;
use File::Copy;
use File::Temp qw(tempfile);
use Savane::Version;

my $geonames = '@pkgdatadir@/backend/external/cities15000';

my $help_msg =
"Usage: $0 [OPTIONS] STATE MIRRORS HTTP_LIST HTTPS_LIST

Update active mirror lists for mirror multiplexer.

Run indirectly from dl:/etc/cron.d/sv-mirmon.
See https://savannah.gnu.org/maintenance/Mirroring.

  -h, --help           show this help and exit
  -v, --version        show Savane version and exit
      --geonames       path to GeoNames city list [$geonames]
      --ignore-state   accept any mirrors listed in STATE

Other arguments list paths to the files,

STATE:      mirmon state (input)
MIRRORS:    list of all mirrors (input)
HTTP_LIST:  active HTTP mirrors (output)
HTTPS_LIST: active HTTP mirrors (output)";

PrintVersionOrHelp ($help_msg);

my $ignore_state;

GetOptions ('geonames=s' => \$geonames, 'ignore-state' => \$ignore_state)
  or die ("Wrong command line.\n");

die qq{Too few command line arguments $#ARGV\n} if $#ARGV < 3;
my @schemes = ('http', 'https');

our %source_overrides = ('am' => '!az,am,bg,de');
# Sometimes, the GeoIP library returns a code that isn't really a contry.
our %cc_aliases = (
  'ap' => 'as', # 'Asia/Pacific': assume American Samoa.
  'eu' => 'fr', # 'Europe': assume France.
  'a1' => 'us', # 'Anonymous proxy'
  'a2' => 'us', # 'Satellite provider'
  'aq' => 'ch', # ? Let it be Switzerland.
);
my $fallback_country = 'us';
my $conf_file = "@confdir@/mirmon-to-geoip.conf";
die "No $conf_file found. Exiting" unless -e $conf_file;
unless (do $conf_file)
  {
    die "Can't compile $conf_file: $@. Exiting" if defined $@;
    die "Can't run $conf_file: $!. Exiting";
  }

my ($mirror_state, $mirror_list, $active);
$mirror_state = shift @ARGV;
$mirror_list = shift @ARGV;
foreach my $sch (@schemes)
  {
    $active->{$sch} = shift @ARGV;
  }

# Data loaded from GeoNames list.
my ($xc, $yc, $zc);   # Cartezian coordinates on a unit sphere.
my ($pop, $cnt);      # Population, number of records processed.
my @known_codes = ();

my $sites;            # URLs of active mirrors.
my $countries;        # Countries having any active mirrors.

my $ok = 60 * 60 * 30;  # Older than this, skip it.
my $time = time;
my $pi_180 = (atan2 (1, 1) * 4) / 180;

sub lat_lon_to_xyz
{
  my ($lat, $lon) = @_;
  my ($x, $y, $z);
  $lat *= $pi_180;
  $lon *= $pi_180;
  $z = sin ($lat);
  $x = sin ($lon) * cos ($lat);
  $y = cos ($lon) * cos ($lat);
  return ($x, $y, $z);
}

sub skip_unused_fields
{
  my $full_record = $#_ > 5;
  return ($_[4], $_[5], $_[8], $_[14]) if ($full_record);
  chomp $_[3];
  return @_;
}

sub parse_geoname_record
{
  my @ret = skip_unused_fields (@_);
  my $population = pop @ret;
  my $cc = pop @ret;
  push @ret, lc ($cc);
  $population = 1 unless $population > 1;
  push @ret, $population;
  return @ret;
}

sub assign_geoname
{
  my ($lat, $lon, $cc, $po) = parse_geoname_record (split /\t/, $_[0]);
  my ($x, $y, $z) = lat_lon_to_xyz ($lat, $lon);
  $xc->{$cc} += $x * $po;
  $yc->{$cc} += $y * $po;
  $zc->{$cc} += $z * $po;
  $pop->{$cc} += $po;
  $cnt->{$cc}++;
}

sub normalize_xyz
{
  foreach my $cc (@known_codes)
    {
      my $r = $xc->{$cc} * $xc->{$cc} + $yc->{$cc} * $yc->{$cc}
        + $zc->{$cc} * $zc->{$cc};
      $r = sqrt ($r);
      $xc->{$cc} /= $r;
      $yc->{$cc} /= $r;
      $zc->{$cc} /= $r;
    }
}

sub load_geonames
{
  my $path = shift;
  open (my $names, "<$path") or die qq{Cannot open $path: $!};
  while (<$names>)
    {
      next if /^\s*#/;
      assign_geoname ($_);
    }
  close ($path);
  die qq{City list $path seems empty\n} unless defined $pop;
  @known_codes = sort (keys %$pop);
  normalize_xyz ();
}

sub add_geoname_alias
{
  my ($old, $new) = @_;
  $xc->{$new} = $xc->{$old};
  $yc->{$new} = $yc->{$old};
  $zc->{$new} = $zc->{$old};
  $pop->{$new} = $pop->{$old};
  $cnt->{$new} = $cnt->{$old};
}

sub load_mirmon_state
{
  my $path = shift;
  open (my $state, "<$path") or die qq{Cannot open $path: $!};
  while (my $line = <$state>)
    {
      chomp $line;
      my @a = split (' ', $line);
      next unless ($a[1] =~ /^[0-9.]*$/);
      my $diff = $time - $a[1];
      next if (($ok - $diff < 0) && !$ignore_state);
      next unless $a[0] =~ m,^(https?)://,;
      $sites->{$1}->{$a[0]}++;
    }
  close ($state);
  foreach my $sch (@schemes)
    {
      die "No active " . uc ($sch) . " mirrors found in $path.\n"
        unless defined $sites->{$sch};
    }
}

sub load_mirror_entry
{
  my ($line, $line_no) = @_;
  return if $line =~ /^#/;
  chomp $line;
  my ($country, $url) = split (' ', $line);
  unless (defined $pop->{$country})
    {
      warn "Country $country unknown";
      return;
    }
  return if $country =~ /partial/i;
  $url =~ s,/*$,/,; # URLs in mirmon state always end in '/'.
  return unless $url =~ /^(https?)/;
  return unless defined $sites->{$1}->{$url};
  $sites->{$1}->{$url} = $country;
  $countries->{$1}->{$country} = $country;
}

sub load_mirror_list
{
  my $path = shift;
  my $line_no = 0;
  my $line;
  open (my $list, "<$path") or die qq{Cannot open $path: $!};
  load_mirror_entry ($line, $line_no++) while ($line = <$list>);
  close ($list);
  foreach my $sch (@schemes)
    {
      die uc ($sch) . " mirror list $path seems empty\n"
        unless defined $countries->{$sch};
    }
}

sub denied_distance
{
  my ($c0, $c1) = @_;
  return -1 unless defined $source_overrides{$c0};
  foreach my $c (split /,/, $source_overrides{$c0})
    {
      $c =~ s/\s*//g;
      next unless $c =~ m/^!(.*)/;
      next unless "!$c1" eq $c;
      return 289;
    }
  return -1;
}

sub preferred_distance
{
  my ($c0, $c1) = @_;
  my $i = -1;
  my $c;
  return 1 unless defined $source_overrides{$c0};
  foreach my $c (split /,/, $source_overrides{$c0})
    {
      $c =~ s/\s*//g;
      next if $c =~ m/^!(.*)/;
      return $i if $c eq $c1;
      $i--;
    }
  return 1;
}

# The metric isn't exactly Euclidean on the geoid, but it must do for us.
sub country_distance
{
  my ($c0, $c1) = @_;
  my ($dx, $dy, $dz);
  my $d;
  $d = preferred_distance ($c0, $c1);
  return $d if $d < -0;
  $d = denied_distance ($c0, $c1);
  return $d if $d > 0;
  $dx = $xc->{$c0} - $xc->{$c1};
  $dy = $yc->{$c0} - $yc->{$c1};
  $dz = $zc->{$c0} - $zc->{$c1};
  return $dx * $dx + $dy * $dy + $dz * $dz;
}

sub find_source_country
{
  my ($code, $scheme) = @_;
  my $c;
  my %distances;
  my @codes_sorted;
  foreach $c (keys %{$countries->{$scheme}})
    {
      $distances{$c} = country_distance ($code, $c);
    }
  @codes_sorted = sort { $distances{$a} <=> $distances{$b} } keys %distances;
  return $fallback_country if $#codes_sorted < 0;
  return join (',', @codes_sorted);
}

sub get_source_countries
{
  my $sch = shift;
  my $source_countries;
  foreach my $code (@known_codes)
    {
      $source_countries->{$code} = find_source_country ($code, $sch);
    }
  return $source_countries;
}

sub output_mirrors
{
  my ($sch, $path) = @_;
  my ($tmp_h, $tmp_name) = tempfile (UNLINK => 1);
  my $source_countries = get_source_countries ($sch);
  foreach my $site (keys %{$sites->{$sch}})
    {
      my $country_code = $sites->{$sch}->{$site};
      next unless $country_code =~ /^[a-z]+$/;
      $site =~ s,/*$,/,;
      print $tmp_h "$site $country_code\n";
    }
  foreach my $cc (@known_codes)
    {
      print $tmp_h "$cc\t$source_countries->{$cc}\n";
    }
  foreach my $cc (keys %cc_aliases)
    {
      print $tmp_h "$cc => $cc_aliases{$cc}\n";
    }
  close ($tmp_h);
  system ("chmod", "a+r", $tmp_name);
  move ($tmp_name, $path) or die qq{Cannot open $path for writing: $!};
}

load_geonames ($geonames);
add_geoname_alias ('gb', 'uk');

load_mirmon_state ($mirror_state);
load_mirror_list ($mirror_list);
foreach my $sch (@schemes)
  {
    output_mirrors ($sch, $active->{$sch});
  }

exit (0);
