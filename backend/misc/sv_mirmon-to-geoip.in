# Use mirmon state (first arg) to filter a list of hosts (second arg)
# to write another list of hosts (third arg) with the stale hosts removed.
#
# This is the common script called to make the host lists
# for all three multiplexors.
#
# See http://savannah.gnu.org/maintenance/Mirroring.

use strict;
use warnings;
use Savane::Version;

my $help_msg =
"Usage: $0 [OPTIONS] STATE MIRRORS HTTP_LIST HTTPS_LIST

Update active mirror lists for mirror multiplexor.

Run indirectly from dl:/etc/cron.d/sv-mirmon.
See https://savannah.gnu.org/maintenance/Mirroring.

  -h, --help           show this help and exit
  -v, --version        show Savane version and exit

Other arguments list paths to the files,

STATE:      mirmon state (input)
MIRRORS:    list of all mirrors (input)
HTTP_LIST:  active HTTP mirrors (output)
HTTPS_LIST: active HTTP mirrors (output)";

PrintVersionOrHelp ($help_msg);

die qq{Too few command line arguments\n} unless $#ARGV < 3;

my ($mirror_state, $mirror_list, $active_http, $active_https) = @ARGV;

my $sites;
my $ok = 60 * 60 * 30;  # Older than this, skip it.
my $time = time;
open (my $state, "<$mirror_state") or die qq{Cannot open $mirror_state: $!};
while (my $line = <$state>)
  {
    chomp $line;
    my @a = split(' ', $line);
    next unless ($a[1] =~ /^[0-9.]*$/);
    my $diff = $time - $a[1];
    next unless ($ok - $diff > 0);
    $sites->{$a[0]}++;
  }
close ($state);

open (my $list, "<$mirror_list")
  or die qq{Cannot open $mirror_list: $!};
while (my $line = <$list>)
  {
    next if $line =~ /^#/;
    chomp $line;
    my ($country, $url) = split (' ', $line);

    next if $country =~ /partial/i;
    next unless $url =~ /^http/;
    $sites->{$url} = $country if (defined $sites->{$url});
  }
close ($list);

open (my $txt_http, ">$active_http")
  or die qq{Cannot open $active_http for writing: $!};
open (my $txt_https, ">$active_https")
  or die qq{Cannot open $active_https for writing: $!};
foreach my $key(keys %$sites)
  {
    (my $site = $key) =~ s/\/$//;
    my $country_code = $sites->{$key};
    $site .= '/' unless $site =~ /\/$/;
    next unless $country_code =~ /^[a-z]+$/;
    my $out = $txt_http;
    $out = $txt_https if ($site =~ /^https/);
    print $out "$site $country_code\n";
  }
close ($txt_http) or die qq{close(>$active_http) failed: $!};
close ($txt_https) or die qq{close(>$active_https) failed: $!};

exit (0);
