@#!/usr/bin/env perl
# $Id: mirmon-to-geoip,v 1.4 2024/01/30 08:10:34 ineiev Exp $
# Public domain. Originally written by Karl Berry.
# Use mirmon state (first arg) to filter a list of hosts (second arg)
# to write another list of hosts (third arg) with the stale hosts removed.
#
# This is the common script called to make the host lists
# for all three multiplexors.
#
# See http://savannah.gnu.org/maintenance/Mirroring.
#
use strict;
use warnings;

sub main {
  my $path_mirmon_state = $ARGV[0];    # in
  my $path_mirmon_mirrors = $ARGV[1];  # in
  my $path_geoip_mirrors_http = $ARGV[2];   # out
  my $path_geoip_mirrors_https = $ARGV[3];   # out

  my $sites;
  my $ok = 60*60*30;  # older than this, skip it.
  my $time = time;
  open(my $state, "<$path_mirmon_state")
      or die qq{Cannot open $path_mirmon_state: $!};
  while (my $line = <$state>) {
      chomp $line;
      my @@a = split(' ', $line);
      next unless ($a[1] =~ /^[0-9.]*$/);
      my $diff = $time - $a[1];
      next unless ($ok - $diff > 0);
      $sites->{$a[0]}++;
  }
  close ($state);

  open(my $list, "<$path_mirmon_mirrors")
      or die qq{Cannot open $path_mirmon_mirrors: $!};
  while (my $line = <$list>) {
    next if $line =~ /^#/;
    chomp $line;
    my ($country, $url) = split (' ', $line);

    next if $country =~ /partial/i;
    next if $url =~ /^ftp/i;
    if (defined $sites->{$url}) {
        $sites->{$url} = $country;
    }
  }
  close ($list);

  open(my $txt_http, ">$path_geoip_mirrors_http")
      or die qq{Cannot open $path_geoip_mirrors_http for writing: $!};
  open(my $txt_https, ">$path_geoip_mirrors_https")
      or die qq{Cannot open $path_geoip_mirrors_https for writing: $!};
  foreach my $key(keys %$sites) {
      (my $site = $key) =~ s/\/$//;
      my $cc = $sites->{$key};
      $site .= '/' unless $site =~ /\/$/;
      next unless $cc =~ /^[a-z]+$/;
      if ($site =~ /^https/) {
          print $txt_https "$site $cc\n";
      }
      else {
          print $txt_http "$site $cc\n";
      }
  }
  close ($txt_http) or die qq{close(>$path_geoip_mirrors_http) failed: $!};
  close ($txt_https) or die qq{close(>$path_geoip_mirrors_https) failed: $!};

  return 0;
}

exit (&main());
@


