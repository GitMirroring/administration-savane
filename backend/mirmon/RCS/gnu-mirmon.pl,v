@#!/usr/bin/env perl
# $Id: gnu-mirmon.pl,v 1.7 2024/01/30 07:35:31 ineiev Exp $
# Public domain. Originally written by Karl Berry.
# Run from dl:/etc/cron.d/mirmon.
# See https://savannah.gnu.org/maintenance/Mirroring.
#
# Convert the plain text FTP file listing ftp.gnu.org mirrors into
# mirmon format.  Extract either just the http mirrors (used for
# the automatic redirect at ftpmirror.gnu.org) or all the
# mirrors (used by humans for checking).
# 
# Output is to the second cmdline argument.  stdout isn't good because
# we don't want to blindly overwrite a good file if something goes wrong.
# 
# (An earlier version of this script used ftp.html instead of FTP as the
# source, etc.  Saved in dl:/root/bin/archive and RCS.)

use LWP::Simple;
use Locale::Country;

exit (&main ());

sub main {
  if (@@ARGV != 2) {
    die "Usage: $0 --http-only|--all /DEST/FILE\n";
  }
  #
  my $extract;
  if ($ARGV[0] eq "--http-only") {
    $extract = "http";
  } elsif ($ARGV[0] eq "--all") {
    $extract = "all";
  } else {
    die "specify --http-only or --all";
  }
  #
  my $dest = $ARGV[1];
  if (! -w $dest) {
    die "destination not writable: $dest";
  }

  my $origlist = LWP::Simple::get ('https://www.gnu.org/prep/FTP');
  die 'GNU mirror list unavailable' unless $origlist;
  my @@ret = ();
  
  # zap everything up to the start of the mirror list.
  # try to check for the substitutions failing,
  # since if we don't eliminate the header/trailer text,
  # nothing good can result.
  my $srclist = $origlist;
  $srclist =~ s,.*\n\* GNU mirror list\n,,s;
  die "no \"* GNU mirror list\", source text changed? (in $srclist)"
    unless $srclist ne $origlist;
  #
  # and everything after the end.
  $origlist = $srclist;
  $srclist =~ s,\n\* Add your mirror.*$,,s;
  die "no \"* Add your mirror\", source text changed? (in $srclist)"
    unless $srclist ne $origlist;
  
  # we want uk to work, not just gb.
  Locale::Country::alias_code ('uk' => 'gb');
  Locale::Country::rename_country ('uk' => 'UK');

  # in the main mirror list.
  for my $line (split ("\n", $srclist)) {
    # the lines we care about look like:
    #   LOCATION - URL[, URL]...
    next unless $line =~ m,^(.*?) - (.*://.*)$,;  # non-greedy just in case
    my ($loc,$urls) = ($1,$2);
    $urls =~ s,\(.*\)*,,;  # eliminate random text in parens
    
    # the location might have a subpart, as in US-Oregon; drop that.
    $loc =~ s/-.*//;
    
    my $country_code = Locale::Country::country2code ($loc);
    if (! $country_code) {
      # cases we've noticed where the function fails; extend as needed.
      if    ($loc eq "US")     { $country_code = "us"; }
      elsif ($loc eq "Korea")  { $country_code = "kr"; }
      elsif ($loc eq "Serbia") { $country_code = "rs"; }
      elsif ($loc eq "Russia") { $country_code = "ru"; }
      else  { warn "no country code for $loc (from line: $line)"; }
    }
    
    # split the urls.
    for my $u (split (/, */, $urls)) {
      # drop leading/trailing whitespace, better not be any more.
      $u =~ s,^\s*,,;
      $u =~ s,\s*$,,;
      if ($u =~ /\s/) {
        warn "url contains whitespace character: $u";
        next;
      }
      
      # need trailing / (mirmon adds it anyway).
      $u .= "/" unless $u =~ m,/$,;
      
      push (@@ret, "$country_code $u\n")
        if ($extract eq "all"
            || $extract eq "http" && $u =~ /^http/);
    }
  }
  die "found no mirmon entries?! (from $origlist)" unless @@ret;
  
  # order doesn't matter to mirmon, so write it as we read it.
  open (DEST, ">$dest") || die("open(>$dest) failed: $!");
  print DEST @@ret;
  close (DEST) ||  die("close(>$dest) failed $!");

  return 0;
}
@


