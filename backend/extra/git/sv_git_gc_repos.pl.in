use strict;
use Savane::Version qw (PrintVersionOrHelp);
use Savane::Util;
use Getopt::Long;
use File::Temp qw (tempfile);

my $name_base = "sv_git";
my $script = "${name_base}_gc_repos.pl";
my $verbose;
my $topdir = "/srv/git";
my ($dry_run, $skip_du, $skip_gc, $skip_ts);
my $logfile = "/var/log/$name_base.log";
my $git_bin = 'git';

my $help_msg =
"Usage: $0 [OPTIONS]

Run git-gc for every Git repository, update Cgit last-modified info.

  -h, --help        show this help and exit
  -v, --version     show Savane version and exit
      --dry-run     don't apply any changes
      --skip-du     don't report file space usage
      --skip-gc     don't run git-gc
      --skip-ts     don't update last-modified info
      --verbose     output extra messages
      --git-bin     the Git executable [$git_bin]
      --topdir      the working directory [$topdir]
      --logfile     file for reports [$logfile]";

PrintVersionOrHelp ($help_msg);

GetOptions (
  "logfile=s" => \$logfile, "topdir=s" => \$topdir, "dry-run" => \$dry_run,
  "verbose" => \$verbose, "skip-du" => \$skip_du, "skip-gc" => \$skip_gc,
  "skip-ts" => \$skip_ts, "git-bin=s" => \$git_bin
) or die ("Wrong command line.");

$skip_gc = $skip_ts = 1 if $dry_run;

open_log ($logfile, $script, $dry_run);

sub dir_size
{
  my $ret = '0';
  $ret = `du -sk $_[0]` unless $skip_du;
  $ret =~ s/\s.*//s;
  return $ret;
}

sub make_cgit_info_dir
{
  my $dir = shift;
  $dir .= '/info';
  unless (-d $dir)
    {
      mkdir ($dir) or die $!;
    }
  $dir .= '/web';
  unless (-d $dir)
    {
      mkdir ($dir) or die $!;
    }
  return "$dir/last-modified";
}

sub update_cgit_timestamp
{
  return if $skip_ts;
  my $repo = shift;
  my $ts_file = make_cgit_info_dir ($repo);
  my $git_options =
    "for-each-ref --format='%(committerdate)' --sort=-committerdate --count=1";
  my $timestamp = `$git_bin --git-dir=$repo $git_options`;
  chomp $timestamp;
  return if $timestamp eq '';
  open (TS, '>', $ts_file) or die $!;
  print TS "$timestamp\n";
  close (TS);
}

sub report_gc_results
{
  my ($path, $repo, $s0, $t) = @_;
  my $s1 = dir_size ($repo);
  my $msg = sprintf ("%-20s", $path);
  if ($skip_du)
    {
      $msg .= sprintf (" (in %is)", $t);
    }
  else
    {
      $msg .= sprintf (" %u -> %u KiB (saved %.2f%% in %is)",
        $s0, $s1, ($s0 - $s1) * 100 / $s0, $t
        );
    }
  print_log ($msg) if $verbose;
  print "$msg\n";
}

sub run_git_gc
{
  my ($path, $repo) = @_;
  print_log ("running git-gc for $path") if $verbose;
  print STDERR "$path";
  if ($dry_run)
    {
      print STDERR " (dry run)";
    }
  elsif ($skip_gc)
    {
      print STDERR " (skipping gc)";
    }
  print STDERR "...\n";
  my $s0 = dir_size ($repo);
  $s0 = 1 unless $s0 > 0;
  my $t = time ();
  system ("$git_bin --git-dir $repo gc -q --auto 2>&1 | tee -a $logfile")
    unless $skip_gc;
  report_gc_results ($path, $repo, $s0, time () - $t);
  update_cgit_timestamp ($repo);
}

sub show_total_size
{
  my $total_size;
  system ("date");
  return if $skip_du;
  $total_size = dir_size (".");
  print "$total_size\n";
  print_log ("$_[0] size $total_size");
}

chdir ($topdir) or die $!;
show_total_size ("initial");
foreach my $path (<*.git>)
  {
    next unless -d $path;
    run_git_gc ($path, $path);
    $path =~ s/[.]git$//;
    next unless -d $path;
    chdir ($path) or die $!;
    foreach my $repo (<*.git>)
      {
        next unless -d $repo;
        run_git_gc ("$path/$repo", $repo);
      }
    chdir ("..");
  }
show_total_size ("  final");
finalize_log ();
