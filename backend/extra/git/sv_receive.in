use strict;
use Savane::SQL;
use Savane::Version;
use Savane::Hooks;
use Savane::Conf;
use Cwd 'abs_path';
use Getopt::Long;

my $help_msg = <<"EOF";
  Usage: $0 [OPTIONS]

  Preliminary Git hook for Savane.  The script is used as Git pre-receive
  and post-receive hooks.  First, it runs the scripts located
  in savane.d/pre-receive.d/ (in the pre-receive mode)
  or in savane.d/post-receive.d/ (in the post-receive mode).
  Then it checks if any relevant actions are enabled in the settings
  of the Savane group of the repository.  When no actions are enabled,
  it exits; when some actions are to be taken, it passes the control
  to sv_pre-receive that does Savane-specific jobs.

    -h, --help               show this help and exit
    -v, --version            show Savane version and exit

    --pre                    run in the pre-receive mode
    --post                   run in the post-receive mode
EOF
$help_msg =~ s/^  //mg;
PrintVersionOrHelp ($help_msg);

my ($pre, $post, $verbose);

GetOptions (
  'pre' => \$pre, 'post' => \$post, 'verbose' => \$verbose
) or die ("Wrong command line\n");

$pre = 1 unless $post;
$post = 0 if $pre;

sub get_hooks_path
{
  my $git = configured_binary ('git');
  my $path = `$git --git-dir=. config --get core.hooksPath`;
  chomp $path;
  return './hooks' if $path eq '';
  return $path;
}
my %disabled_hooks;

sub run_hook
{
  my ($hook_path, $hook_name) = (shift, shift);
  my $ret = 0;
  my $fh;
  unless (open ($fh, '|-', $hook_path))
    {
      print "Cannot run hook $hook_path\n";
      return 1;
    }
   foreach (@_)
     {
       next if filter_branches ($hook_name, $_);
       print { $fh } $_;
     }
   return !close ($fh);
}

sub try_chdir
{
  my $path = shift;
  return 0 if chdir ($path);
  print "Cannot chdir '$path': $!";
  return 1;
}

sub hook_path
{
  my ($stage, $h) = @_;
  my $path = get_hooks_path () . "/savane.d/$stage-receive.d";
  return $path unless defined $h;
  return "$path/$h";
}

sub ls_sorted_hooks
{
  my $stage = shift;
  my $p = abs_path ('.');
  my $path = hook_path ($stage);
  return () if try_chdir ($path);
  my @ret;
  foreach (<"*">)
    {
      next if exists $disabled_hooks{$stage}{$_};
      next if -d $_;
      push @ret, $_;
    }
  return () if try_chdir ($p);
  return sort (@ret);
}

sub prepend_hooks
{
  my $stage = shift;
  my @hooks = ls_sorted_hooks ($stage);
  return 0 unless @hooks;
  my $ret = 0;
  foreach (@hooks)
    {
      my $idx = "$stage-$_";
      $ret = 1 if run_hook (hook_path ($stage, $_), $idx, @_);
    }
  return $ret;
}

sub list_known_hooks
{
  my $stage = shift;
  return qw (mail) if $stage eq 'post';
  return qw (closes-item opens-item no-merges updates-item check-gpg);
}

sub get_known_hooks
{
  my $stage = shift;
  my %ret = ();
  $ret{$_} = 1 foreach (list_known_hooks ($stage));
  return \%ret;
}

sub disable_additional_hooks
{
  my ($prefs, $stage) = @_;
  my $sep = get_hook_separator ();
  my $idx = "disabled-hooks:$stage";
  return unless exists $prefs->{$idx};
  $disabled_hooks{$stage}{$_} = 1
    foreach (split (m%$sep%, $prefs->{$idx}));
}

my $unix_group_name;

sub apply_hook_prefs
{
  my $stage = shift;
  my $dir;
  ($unix_group_name, $dir) = guess_group_and_dir ();
  return 0 unless defined $unix_group_name;
  my %prefs = get_git_group_prefs ($unix_group_name, $dir);
  return 0 unless %prefs;
  disable_additional_hooks (\%prefs, $stage);
  get_disabled_branches (\%prefs);
  foreach (list_known_hooks ($stage))
    {
      next unless exists $prefs{$_};
      return 1 if $prefs{$_} eq '1';
    }
  return 0;
}

sub get_hook_result
{
  my $stage = $pre? 'pre': 'post';
  my @lines;
  push @lines, $_ foreach (<>);
  my $have_hooks = apply_hook_prefs ($stage);
  return 1 if prepend_hooks ($stage, @lines);
  return 0 unless $have_hooks;
  return run_hook ('@bindir@/sv_' . "pre-receive --$stage", undef, @lines);
}

sub main
{
  my $ret = get_hook_result ();
  return $ret unless ($pre && $ret);
  my $url = get_server_url () . "/git/hooks.php?group=$unix_group_name";
  my $admin_url = get_server_url () . "/git/admin/?group=$unix_group_name";
  my $msg = <<"  EOF";
    Your push is being rejected due to some hooks installed in this repository.
    You can see the details of Git hook configuration at
    <$url>.

    The admins of <$unix_group_name> can edit the configuration at
    <$admin_url>.
  EOF
  $msg =~ s/^ {4}//gm;
  print $msg;
  return $ret;
}

exit (main ());
