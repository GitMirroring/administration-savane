use strict;
use warnings;
use Savane::Version;
use Savane::Conf;
use Savane::Util;
use Savane::DB;
use Savane::Groups;
use Savane::Hooks;
use Savane::Mail;
use Savane::SQL;
use LWP::UserAgent;
use Time::HiRes 'time';
use File::Temp 'tempdir';
use Cwd 'abs_path';

my $help = <<"EOF";
  Savane Git pre-receive and post-receive hook.

    -h, --help               show this help and exit
    -v, --version            show Savane version and exit

    --pre                    run in the pre-receive mode
    --post                   run in the post-receive mode
EOF
$help =~ s/^  //mg;
PrintVersionOrHelp ($help);

my ($pre, $post, $verbose);

GetOptions (
  'pre' => \$pre, 'post' => \$post, 'verbose' => \$verbose
) or die ("Wrong command line\n");

$pre = 1 unless $post;
$post = 0 if $pre;

my $stage = $pre? 'pre': 'post';

my $pusher_uname = getpwuid ($>);

sub report_wrong_line
{
  my $msg = shift;
  print "$msg\n";
  return (undef);
}

sub parse_line
{
  my $line = shift;
  chomp $line;
  my ($old, $new, $ref, $extra) = split (/ /, $line);
  return report_wrong_line ("Extra value in $line.") if defined $extra;
  return report_wrong_line ("Wrong old value in $line.")
    unless ($old =~ /^[[:xdigit:]]+$/);
  return report_wrong_line ("Wrong new value in $line.")
    unless ($new =~ /^[[:xdigit:]]+$/);
  return report_wrong_line ("Wrong reference in $line.")
    unless ($ref =~ s,^refs/(heads|tags)/([^[:space:]]+),$2,);
  return ($old, $new, $ref, $1);
}

sub make_user_line
{
  return "sv-user: $pusher_uname";
}

sub run_requests
{
  my ($group, $dir) = (shift, shift);
  return 0 unless @_;
  my $d = 'savane.d';
  $dir .= "/$d";
  chdir ($d);
  unshift @_, make_user_line ();
  my ($fh, $fn) = open_tmp ('sv-git-triggers');
  chdir ('..');
  print { $fh } join ("\n", @_);
  close ($fh);
  my $url = get_server_url () . '/bugs/git-triggers.php?disable_notice=1';
  my $ua = LWP::UserAgent->new (timeout => 0x11);
  my $resp = $ua->get ("$url&group=$group&dir=$dir&file=$fn");
  my $text = $resp->content;
  print "$text";
  return $resp->is_error;
}

sub rev_is_null
{
  my $rev = shift;
  return $rev =~ /^0+$/;
}

sub get_rev_range
{
  my ($old, $new) = @_;
  return $new if rev_is_null ($old);
  return "$old..$new";
}

sub run_git
{
  my $cmd = shift;
  my $git = configured_binary ('git');
  return `$git --git-dir=. $cmd`;
}

sub list_revisions
{
  my ($old, $new, $pretty) = @_;
  return () if (rev_is_null ($new)); # Removing branch: no new revisions.
  my $range = get_rev_range ($old, $new);
  my @ret = ();
  foreach (run_git ("log --reverse --pretty='$pretty' $range"))
    {
      chomp;
      push @ret, $_;
    }
  return @ret;
}

my $unix_group_name;
my $repo_dir;
my %group_preferences;

sub forbid_merges
{
  my ($old, $new, $ref, $type) = parse_line (shift);
  return 0 unless $type eq 'heads';
  my $range = get_rev_range ($old, $new);
  my $merges = run_git ("log --merges $range");
  return 0 unless $merges ne '';
  print "Rejecting merge commits in '$ref':\n";
  my $sep = ('= ' x 33) . "=\n";
  print "$sep$merges\n$sep";
  return 1;
}

my $gpg_home;

sub get_gpg_keys
{
  my $idx = "check-gpg:keys";
  unless (exists $group_preferences{$idx})
    {
      print "GPG keys are not configured for this repository.\n";
      return undef;
    }
  if ($group_preferences{$idx} eq '')
    {
      print "No GPG keys are defined for this repository.\n";
      return undef;
    }
  return $group_preferences{$idx};
}

sub get_key_fingerprints
{
  my ($gpg, $dir) = @_;
  my $prev = '';
  my @ret;
  foreach (`$gpg --list-keys --with-colons`)
    {
      chomp;
      if ($prev =~ /^pub:/ && $_ =~ /^fpr:/)
        {
          my $fpr = $_;
          $fpr =~ s/^fpr:+(.*):/$1/;
          push @ret, $fpr;
        }
      $prev = $_;
    }
  return () if $?;
  return @ret;
}

sub assign_trust_level
{
  my ($gpg, $dir) = @_;
  my $any_keys;
  my $fh;
  unless (open ($fh, '>>', "$dir/gpg.conf"))
    {
      print "Cannot open $dir/gpg.conf for appending: $!\n";
      return 1;
    }
  foreach (get_key_fingerprints (@_))
    {
      print {$fh} "trusted-key $_\n";
      $any_keys = 1;
    }
  close ($fh);
  return 0 if $any_keys;
  print "No keys are listed.";
  return 1;
}

sub make_gpg_home
{
  return 0 if defined $gpg_home;
  my $keys = get_gpg_keys ();
  return 1 unless defined $keys;
  my $dir = tempdir ('gpg-home-XXXXXXXX', DIR => 'savane.d', CLEANUP => 1);
  chmod (0700, $dir);
  $dir = abs_path ($dir);
  $ENV{'GNUPGHOME'} = $dir;
  my $gpg = configured_binary ('gpg');
  my $fh;
  open ($fh, '|-', "$gpg -q --import 2>&1");
  print {$fh} $keys;
  close ($fh);
  util_system ('git', 'config', 'gpg.program', "$gpg");
  return assign_trust_level ($gpg, $dir);
}

sub git_g_code_str
{
  my $c = shift;
  my %codes = (
    'G' => 'good signature',
    'B' => 'bad signature',
    'U' => 'good signature with unknown validity',
    'X' => 'expired good signature',
    'Y' => 'the key has expired',
    'R' => 'the key was revoked',
    'E' => 'signature cannot be checked',
    'N' => 'no signature'
  );
  return $codes{$c} if exists $codes{$c};
  return $c;
}

sub check_signature
{
  my $commit = shift;
  my $code = run_git ("show -s --format='%G?' $commit");
  chomp $code;
  return 0 if $code eq 'G';
  my $str = git_g_code_str ($code);
  print "Error: this commit doesn't verify with GnuPG ($str):\n";
  util_system ('git', 'show', '-s', '--show-signature', $commit);
  return 1;
}

sub check_gpg
{
  my ($old, $new, $ref, $type) = parse_line (shift);
  return 0 unless $type eq 'heads';
  return 1 if make_gpg_home ();
  foreach (list_revisions ($old, $new, '%H'))
    {
      return 1 if check_signature ($_);
    }
  return 0;
}

sub get_null_rev
{
  return '0' x 40;
}

sub get_mailing_list
{
  unless (exists ($group_preferences{'mail:address'}))
    {
      print "Mailing list not set in hook preferences.\n";
      return undef;
    }
  if ($group_preferences{'mail:address'} eq '')
    {
      print "Mailing list in hook preferences is empty.\n";
      return undef;
    }
  return $group_preferences{'mail:address'};
}

sub get_common_subject
{
  my ($ref, $ref_type) = @_;
  my $dir = $repo_dir;
  $dir =~ s/\.git$//;
  return "[$dir] $ref_type '$ref'";
}

sub get_rm_subject
{
  my $s = get_common_subject (@_);
  return "$s deleted";
}

sub git_rev_list
{
  my $arg = shift;
  my $fmt = @_? shift: '%H';
  my $rev_list_flags = '--reverse';
  my @ret;
  my @output = run_git ("rev-list $rev_list_flags --format='$fmt' $arg");
  while (@output)
    {
      shift @output; # Skip commit header.  Note that --no-commit-header
                     # is only introduced in Git 2.33.
      my $line = shift @output;
      push @ret, $line;
    }
  return wantarray? @ret: join ('', @ret);
}

sub list_lost_commits
{
  my $removed = shift;
  my $all = get_other_refs ('../..');
  my $ret = git_rev_list ("$removed --not $all", '%h %s');
  chomp $ret;
  return 'All omitted commits are still available through other references.'
    if $ret eq '';
  $ret =~ s/^/  /gm;
  return
    "These commits are not accessible through references any more:\n\n$ret";
}

sub get_rm_body
{
  my ($old, $ref, $ref_type) = @_;
  my $log = run_git ("log -1 --format='%h %s' $old");
  chomp $log;
  my $lost = list_lost_commits ($old);
  my $msg = <<"  EOF";
    <$pusher_uname> pushed a change to delete $ref_type '$ref'

    was at $log

  EOF
  $msg =~ s/^ {4}//gm;
  return "$msg\n$lost";
}

sub gen_msg_id
{
  my $t = time ();
  my ($sec, $min, $hr, $day, $mon, $yr) = gmtime ();
  $mon++;
  $yr += 1900;
  my $ret = "$yr$mon$day$hr$min$sec.sv.$pusher_uname.";
  my $frac = $t - int ($t);
  srand ($frac * 1000000);
  $frac = int (rand (1000000));
  my $domain = GetConf ('sys_default_domain');
  return "$ret$frac\@$domain";
}

sub get_pusher_email
{
  my $res = sql_query (
    "SELECT `realname`, `email` FROM `user` WHERE `user_name` = ?",
    $pusher_uname
  );
  return undef unless $res;
  my ($realname, $email) = sql_fetch_row ($res);
  return undef unless defined $email;
  return "$realname <$email>";
}

sub get_ref_type
{
  my $type = shift;
  return ($type eq 'heads')? 'branch': ($type eq 'tags'? 'tag': $type);
}

sub build_headers
{
  my ($old, $new, $ref, $type) = @_;
  my %headers;
  $headers{'X-Git-Ref'} = "refs/$type/$ref";
  $headers{'X-Git-Reftype'} = get_ref_type ($type);
  $headers{'X-Git-Oldrev'} = $old;
  $headers{'X-Git-Newrev'} = $new;
  $headers{'Message-Id'} = '<' . gen_msg_id () . '>';
  my $reply_to = get_pusher_email ();
  $headers{'Reply-To'} = $reply_to if defined $reply_to;
  return %headers;
}

sub notify_removed
{
  my ($old, $ref, $type, $headers) = @_;
  my $ref_type = get_ref_type ($type);
  my $to = get_mailing_list ();
  return 0 unless defined $to;

  my $subj = get_rm_subject ($ref, $ref_type);
  my $msg = get_rm_body ($old, $ref, $ref_type);
  print "notifying $to about removed refs/$type/$ref\n";
  MailSend ($to, $subj, $msg, $headers);
  return 0;
}

sub get_add_subject
{
  my $s = get_common_subject (@_);
  return "$s created";
}

sub list_new_commits
{
  my $new = shift;
  my $all = get_other_refs ($new);
  my $commits = git_rev_list ("$new --not $all", '%H %h %s');
  chomp $commits;
  my $log;
  foreach (split (/\n/, $commits))
    {
      s/ .*//;
      $log .= run_git ("log -1 --stat $_") . "\n";
    }
  return  'This branch contains no new commits.'
    if $commits eq '';
  $commits =~ s/^\S+\s//gm;
  $commits =~ s/^/  /gm;
  return
    "This branch contains the next new commits:\n\n$commits\n\n$log";
}

sub get_add_body
{
  my ($new, $ref, $ref_type, $type) = @_;
  my $log = run_git ("log -1 --format='%h %s' $new");
  chomp $log;
  my $new_commits = list_new_commits ("refs/$type/$ref");
  my $msg = <<"  EOF";
    <$pusher_uname> pushed a change to create $ref_type '$ref'

      at $log
  EOF
  $msg =~ s/^ {4}//gm;
  return "$msg\n$new_commits";
}

sub notify_created
{
  my ($new, $ref, $type, $headers) = @_;
  my $ref_type = get_ref_type ($type);
  my $to = get_mailing_list ();
  return 0 unless defined $to;
  my $subj = get_add_subject ($ref, $ref_type);
  my $msg = get_add_body ($new, $ref, $ref_type, $type);
  print "notifying $to about created refs/$type/$ref\n";
  MailSend ($to, $subj, $msg, $headers);
  return 0;
}

sub get_other_refs
{
  my $ref = shift;
  my @ret;
  foreach (run_git ("for-each-ref --format='%(refname)' refs/heads/"))
    {
      chomp;
      push @ret, $_ unless $ref eq $_;
    }
  foreach (run_git ("for-each-ref --format='%(refname)' refs/tags/"))
    {
      chomp;
      push @ret, $_ unless $ref eq $_;
    }
  return join (' ', @ret);
}

sub list_commits
{
  my ($mark, $arg, $status) = @_;
  my @ret;
  foreach (git_rev_list ($arg, '%H %h %s'))
    {
      my $h = $_;
      $h =~ s/\s(.*)//;
      push @ret, $_ unless exists $status->{$h};
      $status->{$h} = $mark;
    }
  return @ret;
}

sub get_commit_log
{
  my $idx = 'mail:show-diffs';
  my $p = ' ';
  $p = '-p ' if (exists $group_preferences{$idx} && $group_preferences{$idx});
  my $ret = run_git ("log -1 --stat $p" . shift);
  return $ret;
}

sub commit_classes
{
  my ($old, $new, $ref, $type) = @_;
  return (
    'add ' => "^$old $new", 'omit' => "^$new $old",
    'lost' => "$old --not " . get_other_refs ('../..'),
    'new ' => "--all --not $old " . get_other_refs ("refs/$type/$ref")
  );
}

sub sort_commits
{
  my ($old, $new, $ref, $type) = @_;
  my %classes = commit_classes (@_);
  my (%status, @commits, @new_commits, @lost, @summaries);
  push @commits, list_commits ($_, $classes{$_}, \%status)
    foreach ('add ', 'omit', 'new ', 'lost');
  foreach my $st ('lost', 'omit', 'add ', 'new ')
    {
      foreach (@commits)
        {
          my $h = $_;
          $h =~ s/\s(.*)//;
          next if $st ne $status{$h};
          push @summaries, "$st $1";
          push @new_commits, get_commit_log ($h) if $st eq 'new ';
          push @lost, "$st $1" if $st eq 'lost';
        }
    }
  return (\@summaries, \@new_commits, \@lost);
}

sub get_change_subject
{
  my $s = get_common_subject (@_);
  return "$s pushed";
}

sub change_format_commits
{
  my ($lost, $sep, $pfx) = @_;
  my @ret;
  foreach (@{$lost})
    {
      s/^$pfx //;
      push @ret, $_;
    }
  return '' unless @ret;
  my $msg = 'These commits are not accessible through references any more:';
  $msg = 'Logs for new commits follow.' unless $pfx eq 'lost';
  return "\n\n$msg\n$sep" . join ($sep, @ret);
}

sub get_change_summary
{
  my ($old, $new) = @_;
  my $ret = join ('', run_git ("diff --stat $old $new"));
  chomp $ret;
  my $indent = ' ' x 2;
  $ret =~ s/^/$indent/gm;
  return "\n\nSummary of changes:\n$ret";
}

sub get_change_body
{
  my ($old, $new, $ref, $type) = @_;
  my $ref_type = get_ref_type ($type);
  my ($summaries, $new_commits, $lost) = sort_commits ($old, $new, $ref, $type);
  my $msg = <<"  EOF";
    <$pusher_uname> pushed $ref_type '$ref'
  EOF
  $msg =~ s/^ {4}//gm;
  my $sep = "\n  ";
  $msg .= $sep . join ($sep, @{$summaries});
  $msg .= get_change_summary ($old, $new);
  $msg .= change_format_commits ($lost, $sep, 'lost');
  $msg .= change_format_commits ($new_commits, "\n", 'new ');
  return $msg;
}

sub notify_by_email
{
  my $line = shift;
  my ($old, $new, $ref, $type) = parse_line ($line);
  my %headers = build_headers ($old, $new, $ref, $type);
  return notify_removed ($old, $ref, $type, \%headers) if rev_is_null ($new);
  return notify_created ($new, $ref, $type, \%headers) if rev_is_null ($old);
  my $ref_type = get_ref_type ($type);
  my $subj = get_change_subject ($ref, $ref_type);
  my $body = get_change_body ($old, $new, $ref, $type);
  my $to = get_mailing_list ();
  return 0 unless defined $to;
  print "notifying $to about changed refs/$type/$ref\n";
  MailSend ($to, $subj, $body, \%headers);
  return 0;
}

my %known_actions = (
  'no-merges' => \&forbid_merges, 'check-gpg' => \&check_gpg
);

%known_actions = ('mail' => \&notify_by_email) if $post;

sub make_savane_d
{
  my $d = 'savane.d';
  return 0 if (-d $d or mkdir $d);
  print "Cannot make '$d' directory.\n";
  return 1;
}

sub hash_actions
{
  my %vals;
  foreach (keys %known_actions)
    {
      $vals{$_} = $known_actions{$_} if defined $known_actions{$_};
    }
  return %vals;
}

sub validate_push
{
  return 1 if make_savane_d ();
  my %vals = hash_actions ();
  return 0 unless %vals;
  foreach my $line (@_)
    {
      foreach (keys %vals)
        {
          next if filter_branches ($_, $line);
          my $f = $vals{$_};
          return 1 if $f->($line);
        }
    }
  return 0;
}

# Triggers may abort the push, so they are applied at the pre-receive stage.
# Triggers are special because they are passed to the frontend page
# /bugs/git-triggers.php.
my %known_triggers = (
  'closes-item' => '\S+\s+#\d+(\s.+)?', 'opens-item' => '\S+\s+#\d+(\s.+)?',
  'updates-item' => '\S+\s+#\d+(\s.+)'
);
%known_triggers = () if $stage eq 'post';

sub get_group_id
{
  my $group = shift;
  my %h = GetDBHash ('`groups`', "`unix_group_name` = '$group'", '`group_id`');
  return $h{0}->[0] if exists $h{0}->[0];
  print "Cannot get group id for group <$group>.\n";
  return undef;
}

sub disable_unused_actions
{
  my ($group, $dir) = @_;
  my $group_id = get_group_id ($group);
  return 1 unless defined $group_id;
  $dir =~ s/\.git$//;
  foreach (keys %known_triggers)
    {
      my $idx = "$_";
      next if (exists $group_preferences{$idx} && $group_preferences{$idx});
      $known_triggers{$_} = undef;
    }
  foreach (keys %known_actions)
    {
      my $idx = "$_";
      next if (exists $group_preferences{$idx} && $group_preferences{$idx});
      $known_actions{$_} = undef;
    }
  return 0;
}

sub list_block_lines
{
  my $block = shift;
  my @ret;
  foreach (split (/\n/, $block))
    {
      return () unless $_ =~ /^\S+:\s/;
      push @ret, $_;
    }
  return @ret;
}

sub list_footers
{
  my ($old, $new) = @_;
  my $accum = '';
  my @ret;
  $accum .= "\n$_" foreach list_revisions ($old, $new, '%n-%n%w(0,1,1)%b');
  foreach (split (/\n-\n/s, $accum))
    {
      s/^ //gm;
      foreach my $block (split /\n\n/)
        {
          push @ret, list_block_lines ($block);
        }
    }
  return @ret;
}

sub process_update
{
  my ($old, $new, $ref) = @_;
  return () unless defined $old;
  my @ret = ('skip me');
  foreach (list_footers ($old, $new))
    {
      next unless $_ =~ s/^(\S+): //;
      my $trigger = lc ($1);
      next unless defined $known_triggers{$trigger};
      my $regexp = $known_triggers{$trigger};
      next unless $_ =~ /^$regexp$/;
      next if filter_branches ($trigger, "$old $new refs/heads/$ref");
      push @ret, "$trigger: $_";
    }
  return @ret;
}

sub any_triggers_are_enabled
{
  foreach (keys %known_triggers)
    {
      return 1 if defined $known_triggers{$_};
    }
  return 0;
}

sub find_requests
{
  my @requests;
  foreach (@_)
    {
      chomp;
      my ($old, $new, $ref, $type) = parse_line ($_);
      return () unless $type eq 'heads';
      return () unless defined $old;
      my @next_bugs = process_update ($old, $new, $ref);
      return () unless defined shift @next_bugs;
      push @requests, @next_bugs;
    }
  my %ret;
  $ret{$_} = 1 foreach @requests;
  return %ret;
}

sub receive_hook
{
  ($unix_group_name, $repo_dir) = guess_group_and_dir ();
  return 1 unless defined $unix_group_name;
  %group_preferences = get_git_group_prefs ($unix_group_name, $repo_dir);
  get_disabled_branches (\%group_preferences);
  my @lines;
  push @lines, $_ foreach (<>);
  return 1 if disable_unused_actions ($unix_group_name, $repo_dir);
  return 1 if validate_push (@lines);
  return 0 unless any_triggers_are_enabled ();
  my %requests = find_requests (@lines);
  return 0 unless %requests;
  return run_requests ($unix_group_name, $repo_dir, keys %requests);
}

sub get_user_stamp_path
{
  return "savane.d/$pusher_uname.stamp";
}

sub touch_user_stamp
{
  my $path = get_user_stamp_path ();
  my $fd;
  unless (open ($fd, '>', $path))
    {
      print "Cannot open '$path' for writing: $!";
      return;
    }
  print {$fd} "\n";
  close ($fd);
}

sub check_user_stamp
{
  return unlink (get_user_stamp_path ());
}

sub main
{
  my $ret = receive_hook ();
  touch_user_stamp () if $pre;
  my $offer = offer_source_code (1);
  $offer = '' if ($post && check_user_stamp ());
  check_user_stamp () if $ret;
  return $ret if $offer eq '';
  $offer =~ s/\n$//s;
  $offer =~ s/^/| /gm;
  print "---\n$offer---\n";
  return $ret;
}

exit (main ());
