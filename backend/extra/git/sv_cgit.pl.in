use strict;
use Savane;
use Savane::Util;
use Getopt::Long;

our $dbd;
my $verbose;
my $git_bin = '@GIT@';
$git_bin = 'git' if $git_bin eq '';
my $cgitrepos_file = "cgitrepos";
my $repo_list = 'project-list';
my $update_repos;
my $git_suff;
my $topdir = "/srv/git";
my $pfx = "/srv/git";

my $help_msg =
"Usage: $0 [OPTIONS]

Generate lists of Git repositories for CGit and gitweb.

  -h, --help               show this help and exit
  -v, --version            show Savane version and exit
      --verbose            output extra warnings
      --topdir             the working directory [$topdir]
      --output             the file to write CGit index of repos
                           [$cgitrepos_file]
      --repo-list          the file to write repo list for gitweb [$repo_list]
      --update-repos       update repo configurations for gitweb
      --gitconf-suffix     write to a file with the specified suffix
                           instead of updating repo configurations
      --path-prefix        prefix for the URL part [$pfx]";

PrintVersionOrHelp ($help_msg);

GetOptions (
  "output=s" => \$cgitrepos_file, "topdir=s" => \$topdir,
  "repo-list=s" => $repo_list, "update-repos" => \$update_repos,
  "gitconf-suffix=s" => \$git_suff, 'git-bin=s' => \$git_bin,
  "path-prefix=s" => \$pfx, "verbose" => \$verbose
) or die ("Wrong command line\n");

$dbd->{mysql_enable_utf8} = 1;

sub htmlspecialchars
{
  $_ = $_[0];
  s/&/&amp;/g;
  s/</&lt;/g;
  s/>/&gt;/g;
  return $_;
}

my %group_names;
my %group_ids;

sub repo_name_to_group
{
  my $group = shift;
  $group =~ s,/.*,,;
  return $group;
}

sub get_group_id
{
  my $group = repo_name_to_group (shift);
  my $group_id;
  return 0 unless exists $group_ids{$group};
  $group_id = $group_ids{$group};
}

sub get_repo_name
{
  my $name = $_[0];
  $name =~ s/[.]git$//;
  return $name;
}

sub fetch_group_git_pref
{
  my ($pref, $group_id, $fallback) = @_;
  return $fallback unless $group_id;
  my @req = GetDBLists (
    "group_preferences",
    "group_id = $group_id AND preference_name = 'vcs:git:$pref'",
    "preference_value"
  );
  foreach my $line (@req)
    {
      my ($val) = @{$line};
      return $val;
    }
  return $fallback;
}

sub get_repo_order
{
  my $group_id = shift;
  return split (":", fetch_group_git_pref ("repo-order", $group_id, ""));
}

sub fetch_repo_pref
{
  my ($pref, $repo_name, $group_id, $fallback) = @_;;
  return fetch_group_git_pref ("$pref:$repo_name", $group_id, $fallback);
}

sub get_desc
{
  my ($path, $url, $repo_name, $group_id) = @_;
  my $desc = fetch_repo_pref ("desc", $repo_name, $group_id, "");
  return $desc unless $desc eq "";
  open (DESC, "<:encoding(UTF-8)", "$path/description")
    or warn "Can't open $path/description: $!";
  $desc = <DESC>;
  close (DESC);
  chomp ($desc);
  $desc = '' if $desc =~ /^Unnamed repository; edit this file/;
  $desc = htmlspecialchars ($desc);
  return $desc;
}

sub output_section
{
  my $group = shift;
  unless (exists $group_names{$group})
    {
      warn "No public group $group using Git in the database.\n" if $verbose;
      return 0;
    }
  my $out = shift;
  print { $out } "section=$group_names{$group}\n";
  return 1;
}

sub repo_entry
{
  my ($url, $desc_path) = @_;
  my $repo_name = get_repo_name ($url);
  my $group_id = get_group_id ($repo_name);
  my $dsc = get_desc ($desc_path, $url, $repo_name, $group_id);
  my $no_tarballs = fetch_repo_pref ("no-tarball", $repo_name, $group_id, 0);
  my $readme = fetch_repo_pref ("readme", $repo_name, $group_id, "");
  my %out = ('url' => $url, 'path' => "$pfx/$url", 'desc' => $dsc);
  $out{'readme'} = $readme unless $readme eq "";
  $out{'snapshots'} = '' if $no_tarballs;
  return \%out;
}

sub enumerate_subrepos
{
  my $group = shift;
  my $names = shift;
  my @ret;

  return () unless -d $group;
  chdir ($group) or die $!;
  foreach my $repo (<*.git>)
    {
      next if ! -d $repo;
      push @{$names}, get_repo_name ("$group/$repo");
      push @ret, (repo_entry ("$group/$repo", $repo));
    }
  chdir ("..");
  return @ret;
}

sub sort_entries
{
  my ($ent_ref, $name_ref, $group_id) = @_;
  my @repo_order = get_repo_order ($group_id);
  return @{$ent_ref} unless 0 < $#repo_order;
  my @sorted;
  my %by_name;
  foreach my $n (@{$name_ref})
    {
      $by_name{$n} = shift @{$ent_ref};
    }
  foreach my $n (@repo_order)
    {
      next unless exists $by_name{$n};
      push @sorted, $by_name{$n};
      delete $by_name{$n};
    }
  foreach my $n (@{$name_ref})
    {
      next unless exists $by_name{$n};
      push @sorted, $by_name{$n};
    }
  return @sorted;
}

sub run_git_config
{
  my ($conf, $file) = @_;
  system ('touch', $file); # Git only updates existing files.
  foreach my $k (keys %$conf)
    {
      system ($git_bin, 'config', '--replace-all', '--file', $file,
        "gitweb.$k", $conf->{$k}
      );
    }
}

sub update_git_config
{
  my $ent = shift;
  my $group = shift;
  my $name = $ent->{'url'};
  my $file = "$name/config";
  $file .= $git_suff if defined $git_suff;
  my %conf = ('category' => $group);
  $conf{'snaphsot'} = 'none' if exists $ent->{'snapshots'};
  run_git_config (\%conf, $file);
}

sub url_encode
{
  my $ret = shift;
  $ret =~ s/{+}/%2B/g;
  $ret =~ s/\s/+/g;
  return $ret;
}

sub output_gitweb_entry
{
  my ($out, $ent, $group) = @_;
  return unless exists ($ent->{'url'});
  $group = $group_names{$group} if exists $group_names{$group};
  print { $out } "$ent->{'url'} " . url_encode ($group) . "\n";
  return unless $update_repos;
  update_git_config ($ent, $group);
}

sub output_entries
{
  my $out = shift;
  my $repo_out = shift;
  my $group = shift;
  foreach my $ent (@_)
    {
      my @ordered = ('url', 'path', 'desc');
      my ($k, $v);
      foreach $k (@ordered)
        {
          next unless exists $ent->{$k};
          print { $out } "repo.$k=$ent->{$k}\n";
          delete $ent->{$k};
        }
      foreach $k (keys %$ent)
        {
          print { $out } "repo.$k=$ent->{$k}\n";
        }
      output_gitweb_entry ($repo_out, $ent, $group);
    }
}

my @db = GetDBLists (
  "groups", "status = 'A' AND use_git = 1 AND is_public <> 0",
  "unix_group_name, group_name, group_id"
);

foreach my $line (@db)
  {
    my ($unix_group_name, $group_name, $group_id) = @{$line};
    $group_names{$unix_group_name} = $group_name;
    $group_ids{$unix_group_name} = $group_id;
  }

chdir ($topdir) or die $!;
my ($out, $tmp_filename) = open_tmp ("cgitrepos");
my ($repo_out, $repo_filename) = open_tmp ("repolist");

foreach my $path (<*.git>)
  {
    next if ! -d $path;
    my $group = $path;
    my @entries;
    my @names;
    $group =~ s/[.]git$//;
    next unless output_section ($group, $out);
    push @names, get_repo_name ($path);
    push @entries, (repo_entry ($path, $path));
    push @entries, enumerate_subrepos ($group, \@names);
    my @sorted = sort_entries (\@entries, \@names, get_group_id ($group));
    output_entries ($out, $repo_out, $group, @sorted);
  }

close_and_move ($out, $tmp_filename, $cgitrepos_file);
close_and_move ($repo_out, $repo_filename, $repo_list);
