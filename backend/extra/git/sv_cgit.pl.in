use strict;
use Savane;
use Getopt::Long;
use File::Temp qw/ tempfile /;

our $dbd;
my $verbose;
my $dry_run;
my $topdir;
my $pfx;

my $help_msg =
"Usage: $0 [OPTIONS]

Generate the list of Git repositories for CGit.

  -h, --help                   Show this help and exit
  -v, --version                Show Savane version and exit
      --verbose                Output extra warnings
      --dry-run                Write to cgitrepos~ instead of cgitrepos
      --topdir                 The working directory [/srv/git]
      --path-prefix            Prefix for the URL part [/srv/git]";

PrintVersionOrHelp ($help_msg);

GetOptions (
  "dry-run" => \$dry_run, "topdir=s" => \$topdir, "path-prefix=s" => \$pfx,
  "verbose" => \$verbose
) or die ("Wrong command line.");

$topdir = "/srv/git" unless $topdir;
$pfx = "/srv/git" unless $pfx;
$dry_run = 0 unless $dry_run;
$verbose = 0 unless $verbose;

$dbd->{mysql_enable_utf8} = 1;

sub htmlspecialchars
{
  $_ = $_[0];
  s/&/&amp;/g;
  s/</&lt;/g;
  s/>/&gt;/g;
  return $_;
}

sub urldecode
{
  my $url = $_[0];
  $url =~ tr/+/ /;
  $url =~ s/%([a-fA-F0-9]{2})/chr(hex($1))/eg;
  return $url;
}

sub get_desc
{
  my $path = $_[0];
  my $desc = '';
  open (DESC, "<:encoding(UTF-8)", "$path/description") or warn "$path/description: $!";
  $desc = <DESC>;
  close (DESC);
  chomp ($desc);
  $desc = '' if $desc =~ /^Unnamed repository; edit this file/;
  $desc = htmlspecialchars ($desc);
  return $desc;
}

my %group_names;

sub output_group_name
{
  my $out = shift;
  my $group = shift;
  my $group_name = "";

  if (exists $group_names{$group})
    {
      $group_name = $group_names{$group};
    }
  else
    {
      warn "No group $group using Git in the database.\n" if $verbose;
      return 0;
    }
  print { $out } "repo.group=$group_name\n";
  return 1;
}

sub output_entry
{
  my $dsc = get_desc ($_[2]);
  print { $_[0] } "repo.url=$_[1]\nrepo.path=$pfx/$_[1]\nrepo.desc=$dsc\n"
    . "repo.readme=README.html\nrepo.owner=\n";
}

sub enumerate_subrepos
{
  my $out = shift;
  my $group = shift;

  return unless -d $group;
  chdir ($group) or die $!;
  foreach my $repo (<*.git>)
    {
      next if ! -d $repo;
      output_entry ($out, "$group/$repo", $repo);
    }
  chdir ("..");
}

my @db = GetDBLists (
  "groups", "status = 'A' AND use_git = 1", "unix_group_name, group_name"
);

foreach my $line (@db)
  {
    my ($unix_group_name, $group_name) = @{$line};
    $group_names{$unix_group_name} = $group_name;
  }

my $out;
my $tmp_filename;

chdir ($topdir) or die $!;
($out, $tmp_filename) = tempfile ("cgitrepos-XXXXXXXX", UNLINK => 1);
binmode $out, ":utf8";
foreach my $path (<*.git>)
  {
    next if ! -d $path;
    my $group = $path;
    $group =~ s/[.]git$//;
    next unless output_group_name ($out, $group);
    output_entry ($out, $path, $path);
    enumerate_subrepos ($out, $group);
  }
chmod 0644, $out;
close ($out);

my $target = "cgitrepos";
$target .= "~" if $dry_run;
rename $tmp_filename,  $target or die $!;
