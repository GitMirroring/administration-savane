# You probably should set the following options of your sshd_config
# like below:
#   PermitEmptyPasswords no
#   PasswordAuthentication no
#   AllowTcpForwarding no

use strict;
use Cwd 'abs_path';
use Savane::Version;
use Savane::DB;
use Savane::User;

$ENV{'PATH'}="/usr/local/bin:/usr/bin:/bin";
$ENV{'CVSEDITOR'}="/bin/false";

our $bin_bzr = "bzr";
our $dir_bzr = "/srv/bzr";

our $bin_cvs = "cvs";
our $bin_git = "git-shell";
our $bin_hg = "hg";
our $dir_hg = "/srv/hg"; # Only access existing directories within $dir_hg.

our $bin_rsync = "rsync";
our $allowed_paths =
  '^/('
      . 'net/(audio-video(/|$)|(download|(vcs/(arch|bzr|cvs|git|hg|svn))/))'
      . '|opt/src/'
  . ')';
our $bin_scp = "scp";
our $bin_sftp = "/usr/lib/openssh/sftp-server";
our $bin_svn = "svnserve";
our @prepend_args_svn = ('-r', '/srv/svn');

our %commands_available = (
  'bzr' => '^bzr serve --inet --directory=/ --allow-writes$',
  'cvs' => '^cvs server$',
  'git' => '^git-',
  'hg' => '^hg -R ([[:alpha:]][[:alnum:]_/-]*) serve --stdio$',
  'rm' => '^rm ([[:alnum:]_/.-]+)',
  'rmdir' => '^rmdir ([[:alnum:]_/.-]+)',
  'rsync' => '^rsync --server ',
  'scp' => '^scp( -[dprv])* (-t|-f) (-- )?([[:alnum:]_/.-]+)$',
  'sftp' => '^/usr/lib/openssh/sftp-server( |$)',
  'svn' => '^svnserve -t( |$)'
);
our @commands_enabled = ();
our $source_code_url = '';

my $conf_file = "@sysconfdir@/savane/membersh-conf.pl";

die "No $conf_file found. Exiting" unless -e $conf_file;
unless (do $conf_file)
  {
    die "Can't compile $conf_file: $@. Exiting" if defined $@;
    die "Can't run $conf_file: $!. Exiting";
  }

process_help_and_version () unless ($ARGV[0] eq "-c");
# When this script is invoked through the network, $ARGV[0]
# is set to '-c', so we may offer the source code after
# checking if --help is requested; if we did that before,
# make installcheck would require setting $source_code_url
# in the stub membersh-conf.pl.
offer_source_code () unless quiet_is_requested ();

output_error_msg () unless ($#ARGV == 1 && $ARGV[0] eq "-c");

for my $cmd (@commands_enabled)
  {
    next unless defined $commands_available{$cmd};
    next unless $ARGV[1] =~ m:$commands_available{$cmd}:;
    my $sub = "run_$cmd";
    my $sr = \&$sub;
    &$sr (split (' ', $ARGV[1]));
  }

output_error_msg ();

sub quiet_is_requested
{
  return GetUserPrefs ($ENV{'USER'}, 'quiet_ssh');
}

sub offer_source_code
{
  die "Source code URL isn't defined in configuration file\n\n"
    . "\t$conf_file\n\nExiting" if $source_code_url eq '';
  my $script = $0;
  $script =~ s,.*/,,;
  my $msg = <<"    EOF";
    $script is part of Savane.
    In order to download the corresponding source code of Savane, run

      rsync -avz --cvs-exclude $ENV{'USER'}\@$source_code_url .

    EOF
  $msg =~ s, {4},,gm;
  print STDERR $msg;
}

sub run_command
{
  exec @_; # exec doesn't return unless failed to run the command.
  my @args;
  while ($#_ >= 0)
    {
      my $a = shift;
      $a =~ s/'/\\'/g;
      push @args, $a;
    }
  die "Failed to exec '" . join ("' '", @args) . "': $!.\nExiting";
}

sub run_bzr
{
  # rgm@gnu 2013/06/06. Let's try logging + logrotate to limit the size.
  $ENV{'BZR_LOG'} = '/var/log/bzr/bzr.log';
  $ENV{'HOME'} = '/var/lib/bzr';
  # rgm@gnu addition 2013/08/28.
  # https://lists.ubuntu.com/archives/bazaar/2013q3/075681.html
  $ENV{'LANG'} = 'en_US.ISO8859-1';
  # rgm@gnu addition 2013/06/05.
  $ENV{'BZR_PLUGIN_PATH'} = '-user:+core:-site';
  # authorize 'bzr serve' in SSH tunnel mode
  # rgm@gnu removed '--no-plugins' 2013/06/05.
  run_command ($bin_bzr, 'serve', '--client-timeout=3600', '--inet',
    "--directory=$dir_bzr", '--allow-writes'
  );
}

sub run_cvs
{
  run_command ($bin_cvs, 'server');
}

sub run_git
{
  # Delegate filtering to git-shell.
  run_command ($bin_git, @ARGV);
}

sub run_hg
{
  my $repo_path = $_[2];
  # Run in $dir_hg to get rid of the path prefix (e.g. /srv/hg).
  run_command (
    $bin_hg, '--cwd', $dir_hg, '-R', $repo_path, 'serve', '--stdio'
  );
}

sub assert_path
{
  my $path = shift;
  my $realpath = abs_path ($path);
  return if $realpath =~ m:$allowed_paths:;
  die "Wrong path requested: >$path<, resolves to >$realpath<\n"
    . "Allowed paths are $allowed_paths\nExiting";
}

sub remove
{
  my $path = shift;
  my $type = shift;
  assert_path ($path);
  die "$path doesn't exist.\nExiting" unless -e $path;
  if ($type)
    {
      die "$path is not a directory.\nExiting" unless -d $path;
      die "Can't remove directory $path: $!.\nExiting" unless rmdir ($path);
      exit (0);
    }
  die "$path is not a file.\nExiting" unless -f $path;
  die "Can't remove file $path: $!.\nExiting" unless unlink ($path);
  exit (0);
}

sub run_rm
{
  remove ($_[$#_], 0);
}

sub run_rmdir
{
  remove ($_[$#_], 1);
}

sub run_rsync
{
  assert_path ($_[$#_]);
  shift;
  run_command ($bin_rsync, @_);
}

sub run_scp
{
  assert_path ($_[$#_]);
  shift;
  run_command ($bin_scp, @_);
}

sub run_sftp
{
  run_command ($bin_sftp);
}

sub run_svn
{
  # Authorize svnserve in tunnel mode, with the svn root prepended.
  shift;
  unshift @_, @prepend_args_svn;
  run_command ($bin_svn, @_);
}

sub output_error_msg
{
  print STDERR "You tried to execute: @ARGV[1..$#ARGV]\n";
  print STDERR "Sorry, you are not allowed to execute that command.\n";
  print STDERR list_available (sort @commands_enabled);
  exit (1);
}

sub list_available
{
  my $ret = "\nConfiguration file:\n\n\t$conf_file\n";
  return "$ret\nNo commands are available.\n" if $#_ < 0;
  $ret .= "\nAvailable commands:\n\n";
  for my $cmd (@_)
    {
      my $regex = $commands_available{$cmd};
      $regex =~ s,%,\\%,g;
      $ret .= "\t$cmd:\t%$regex%\n";
    }
  return "$ret\n";
}

sub list_commands
{
  my $ret = '';
  $ret = list_available (sort keys %commands_available);
  return "$ret\nNo commands are enabled.\n" if $#commands_enabled < 0;
  $ret .= "\nCommands enabled:\n\n\t" . join (", ", sort @commands_enabled);
  return "$ret\n\nAll other commands are rejected.\n";
}

sub process_help_and_version
{
  my $help = <<"    EOF";
    Usage: $0 [OPTION]

    Restricted login shell for Savane system users.
    All options are mutually exclusive.

      -h, --help     show this help and exit
      -v, --version  show Savane version and exit
      -c command     run the specified command
    EOF
  $help .= list_commands () . "\n";
  $help .= <<'    EOF';
    Example configuration file:

      $allowed_paths = '^/srv/(cvs|download|hg)/';
      @commands_enabled = ('cvs', 'hg', 'scp', 'sftp', 'rsync');
      $bin_cvs = "/usr/bin/cvs";

      $bin_rsync = "/usr/bin/rsync";
      # Make rsync read-only:
      $commands_available{'rsync'} = "^rsync --server --sender ";
    EOF
  $help =~ s,^ {4},,gm;
  PrintVersionOrHelp ($help);
}
