# This script should be used via a cronjob to update the system
# by reading the database about groups.
#
# It will add create/update a group for each group.
# It will also create a download area, a web area, and a cvs repository
# if in the database the fields dir_cvs dir_homepage and dir_download
# contains the string %PROJECT
# (if they don't, it means that no group specific directories like that
# are desired).
# (the web area can be also a cvs repository
#
# WARNING: sv_groups should run before sv_users.

use strict;
use Savane;
use Savane::Download;
use Savane::Cvs;
use Savane::Svn;
use Savane::Git;
use Savane::Hg;
use Savane::Bzr;
use Getopt::Long;
use Term::ANSIColor qw(:constants);
use POSIX qw(strftime);

our $script = "sv_groups";
my $logfile = "/var/log/sv_database2system.log";
my $lockfile = "groups-users.lock";
my $dry_run;
my $verbose;
my $cron;

my $no_etc = 0;
my $no_cvs = 0;
my $no_arch = 0;
my $no_svn = 0;
my $no_git = 0;
my $no_hg = 0;
my $no_bzr = 0;
my $no_homepage = 0;
my $no_download = 0;

my $only_etc;
my $only_cvs;
my $only_arch;
my $only_svn;
my $only_git;
my $only_hg;
my $only_bzr;
my $only_homepage;
my $only_download;

my $one_group;
my $webgroup = 0;

my $min_gid = "5000";

my $help_msg =
"Usage: $0 [OPTIONS]

Update the system to reflect the database about groups.
Normally, sv_users should run just after.

  -h, --help           show this help and exit
  -v, --version        show Savane version and exit
      --dry-run        don't apply changes
      --verbose        log additional info
      --cron           ignored
      --one-group      ignored
      --logfile        file for reports [$logfile]

      --no-etc         do not update system groups
      --no-cvs         do not update CVS trees
      --no-arch        do not update GNU Arch trees
      --no-svn         do not update Subversion trees
      --no-git         do not update Git trees
      --no-hg          do not update Mercurial trees
      --no-bzr         do not update Bazaar trees
      --no-homepage    do not update homepage dirs
      --no-download    do not update download dirs

      --only-etc       only update system groups
      --only-cvs       only update CVS trees
      --only-arch      only update GNU Arch trees
      --only-svn       only update Subversion trees
      --only-git       only update Git trees
      --only-hg        only update Mercurial trees
      --only-bzr       only update Bazaar trees
      --only-homepage  only update homepage dirs
      --only-download  only update download dirs

      --webgroup       for each Savane group, add users in two groups,
                       including one with the prefix web";
PrintVersionOrHelp ($help_msg);

GetOptions (
  "cron" => \$cron, "logfile=s" => \$logfile, "dry-run" => \$dry_run,
  "no-etc" => \$no_etc, "no-cvs" => \$no_cvs, "no-svn" => \$no_svn,
  "no-git" => \$no_git, "no-hg" => \$no_hg, "no-arch" => \$no_arch,
  "no-homepage" => \$no_homepage, "no-download" => \$no_download,
  "only-etc" => \$only_etc, "only-cvs" => \$only_cvs,
  "only-svn" => \$only_svn, "only-git" => \$only_git,
  "only-hg" => \$only_hg, "only-bzr" => \$only_bzr,
  "only-arch" => \$only_arch, "only-homepage" => \$only_homepage,
  "only-download" => \$only_download, "verbose" => \$verbose,
  "webgroup" => \$webgroup, "one-group" => \$one_group
);

# If we are asked to create only a few services, set everything to "no"
# and later add the only one(s) asked for.
if ($only_etc || $only_cvs || $only_arch || $only_svn || $only_git
    || $only_hg || $only_bzr || $only_homepage || $only_download
  )
  {
    $no_etc = 1;
    $no_cvs = 1;
    $no_arch = 1;
    $no_svn = 1;
    $no_git = 1;
    $no_hg = 1;
    $no_bzr = 1;
    $no_homepage = 1;
    $no_download = 1;

    $no_etc = 0 if $only_etc;
    $no_cvs = 0 if $only_cvs;
    $no_arch = 0 if $only_arch;
    $no_svn = 0 if $only_svn;
    $no_git = 0 if $only_git;
    $no_hg = 0 if $only_hg;
    $no_bzr = 0 if $only_bzr;
    $no_homepage = 0 if $only_homepage;
    $no_download = 0 if $only_download;
  }

open (LOG, ">>:encoding(UTF-8)", $logfile);

sub PrintLog
{
  our $script;
  my $dr = $dry_run? " (dry run)": "";
  print LOG (strftime "[$script] %c -$dr", localtime) . " $_[0]\n";
}

PrintLog ("starting");

# Locks: There are several sv_db2sys scripts,
# but they should not run concurrently.
AcquireReplicationLock ($lockfile);

# Grab database information.
#
# - db_groups items
# - db_group_type items

# db_group_type:
# Create an hash that contains group type infos from the table group_type,
# as lists for each group type (@{$db_group_type{$id}}).
# Note that we store the data with the id as key, not the name, because
# in the group db are only used the ids.
#
# To limit the number of requests, we use one very long SQL request.
my @db_group_type_fields = (
  "name", "type_id", "dir_type_homepage", "dir_type_cvs", "dir_type_arch",
  "dir_type_svn", "dir_type_git", "dir_type_hg", "dir_type_bzr",
  "dir_type_download", "dir_homepage", "dir_cvs", "dir_arch", "dir_svn",
  "dir_git", "dir_hg", "dir_bzr", "dir_download", "can_use_homepage",
  "can_use_cvs", "can_use_arch", "can_use_svn", "can_use_git", "can_use_hg",
  "can_use_bzr", "can_use_download"
);
my %db_group_type;
foreach my $line (GetDB ("group_type", 0, join (", ", @db_group_type_fields)))
  {
    chomp ($line);
    my @entry = split(",", $line);
    PrintLog ("db: get $line from database") if $verbose;
    $db_group_type{$entry[1]} = [@entry];
  }

# db_groups:
# Create an hash that contains group infos from the table groups,
# as lists for each group (@{$db_group{$name}}).
# Additionally, create a list of groups.
# Additionally, create an hash to find easily which groups are
# in the database.
#
# Only groups in Active status will be handled!
my %db_groups;
my @db_groups;
my @db_groups_fields = (
  "unix_group_name", "type", "is_public", "use_homepage", "use_cvs",
  "use_arch", "use_svn", "use_git", "use_hg", "use_bzr", "use_download",
  "dir_homepage", "dir_cvs", "dir_arch", "dir_svn", "dir_git", "dir_hg",
  "dir_bzr", "dir_download"
);
foreach my $line
  (GetDB ("groups", "status = 'A'", join (", ", @db_groups_fields)))
  {
    chomp ($line);
    my @entry = split (",", $line);
    PrintLog ("db: get group $line from database") if $verbose;
    $db_groups{$entry[0]} = [ @entry ];
    push (@db_groups, $entry[0]);
 }
PrintLog ("database info fetched");

# Grab system information, run comparisons.
#
# - etc_group* items

# /etc/group:
#   Create a list of groups which are missing on the the system. We ignore
#   groups that are not in the database.
#   Find what is the maximum id number known.
my @only_in_db;
foreach my $group (@db_groups)
  {
    my ($exists) = getgrnam ($group);
    my $predicate = $exists? "present": "missing";
    PrintLog ("etc+compare: group $group is $predicate on the system")
      if $verbose;
    push (@only_in_db, $group) unless ($exists);
  }

# /etc/group:
# Find what is the maximum id number known.  Save also the nogroup id.
my $etc_group_maxid = -1;
my $nogroup_gid = 65534;
while (my @entry = getgrent ())
  {
    if($entry[0] ne 'nogroup')
      {
        $etc_group_maxid = $entry[2] if $entry[2] > $etc_group_maxid;
      }
    else
      {
        $nogroup_gid = $entry[2];
      }
    PrintLog ("etc: group $entry[0]\t\t maxid $etc_group_maxid") if $verbose;
  }
$etc_group_maxid++;
# If we did not reached the minimal gid, set it as maxid
$etc_group_maxid = $min_gid if $min_gid > $etc_group_maxid;

PrintLog ("system infos grabbed");
PrintLog ("comparison done");

# Update the system.

# Make sure that the group svusers and anoncvs exists
# sv_users and sv_groups would broke without these groups
for ("svusers", "anoncvs")
  {
    unless (getgrnam($_))
      {
        system("/usr/sbin/groupadd", "-g", $etc_group_maxid, $_)
          unless ($dry_run || $no_etc);
        PrintLog (
          "-- groupadd -g $etc_group_maxid $_ (required by the savane backend)"
        );
        $etc_group_maxid++;
      }
  }
# Add groups missing on the system.
foreach my $group (@only_in_db)
  {
    my
      (
        $name, $type, $is_public, $use_homepage, $use_cvs, $use_arch,
        $use_svn, $use_git, $use_hg, $use_bzr, $use_download
      )
      = @{$db_groups{$group}};
    PrintLog ("create: $name and web$name") if $verbose;

    unless ($dry_run || $no_etc)
      {
        # Actually add the groups.
        system("/usr/sbin/groupadd", "-g", $etc_group_maxid, $name);
        if ($webgroup)
          {
            $etc_group_maxid++;
            system("/usr/sbin/groupadd", "-g", $etc_group_maxid, "web$name");
          }
        # We do not at that moment create the directories, we just relying
        # on the next step.
      }
    # Increment the gid for the next group, avoid the special value
    # attributed to nogroup.
    $etc_group_maxid++;
    $etc_group_maxid++ if $etc_group_maxid == $nogroup_gid;

    PrintLog ("-- groupadd $name,web$name");
  }

PrintLog ("account creation done");

# Update existing groups, including the ones just created
# These groups are in the database and on the system.

sub make_area
{
  my ($func, $name, $dir, $pub) = @_;
  my $fr = \&$func;
  PrintLog ("$func ($name, $dir, $pub)") if $verbose;
  return &$fr ($name, $dir, $pub) unless $dry_run;
  return '';
}

sub make_dl_savannah
{
  my ($name, $dt, $dir, $pub) = @_;
  return '' unless $dt eq "savannah-gnu" || $dt eq "savannah-nongnu";
  return make_area ('DownloadMareAreaSavannah', $name, $dir, $pub);
}

sub make_vcs_dir
{
  my ($name, $dir, $dir_svn, $dir_type, $pub) = @_;
  my $f = {
    'basiccvs' => 'CvsMakeArea', 'basicdirectory' => 'DownloadMakeArea',
    'cvsattic' => 'CvsMakeAreaAttic', 'basicsvn' => 'SvnMakeArea',
  };
  return make_area (${$f}{$dir_type}, $name, $dir, $pub)
    if exists ${$f}{$dir_type};
  $f = {
    'svnattic' => 'SvnMakeAreaAttic',
    "svnatticwebsite" => 'SvnMakeAreaAtticWebsite'
  };
  return make_area (${$f}{$dir_type}, $name, $dir_svn, $pub)
    if exists ${$f}{$dir_type};
  return '';
}

foreach my $group (@db_groups)
  {
    # If we run in no etc mode, we cannot handle groups missing on the system.
    my ($exists) = getgrnam ($group);
    if ($no_etc && !$exists)
      {
        PrintLog (
          "-- no way to update $group, the group is missing on the system"
        );
        next;
      }
    my @group_entry = @{$db_groups{$group}};
    my %vars;
    foreach my $k (@db_groups_fields)
      {
        $vars{$k} = shift @group_entry;
      }
    my @group_type_entry = @{$db_group_type{$vars{'type'}}};
    foreach my $k (@db_group_type_fields)
      {
        $vars{$k} = shift @group_type_entry;
      }
    foreach my $k
      ("homepage", "cvs", "arch", "svn", "git", "hg", "bzr", "download")
      {
        # If a use in the database is empty, set it to the group type can_use.
        $vars{"use_$k"} = $vars{"can_use_$k"} if $vars{"use_$k"} eq '';
        # If a group_dir in the database is not empty, set reset the default
        # (it means that the group does not respect the group type settings).
        $vars{"dir_$k"} = $vars{"group_dir_$k"} if $vars{"group_dir_$k"};
      }
    my $name = $vars{'unix_group_name'};
    my $msg = "update: $name, ";
    foreach my $f ("type", "is_public", "use_homepage", "use_cvs", "use_arch",
      "use_svn", "use_git", "use_hg", "use_download", "dir_homepage",
      "dir_cvs")
      {
        $msg .= "$f: $vars{$f}, "
      }
    $msg .= " dir_download: $vars{'dir_download'}";
    PrintLog ($msg) if $verbose;

    my $madesomething;

    # FIXME: in a future, we may create a table of method associating
    # method -> perl module -> sub name.
    # Currently it is hardcoded.
    next if ($dry_run);
    my $pub = $vars{'is_public'};
    my $dis = $vars{'dir_svn'};
    # Create the cvs area, by relying on the library, that should
    # make the appropriate decision (i.e. if no %PROJECT string is
    # provided, nothing should be done; check if the directory does
    # not already exists).
    if ($vars{'use_cvs'} && !$no_cvs)
      {
        my $dic = $vars{'dir_cvs'};
        my $dtc = $vars{'dir_type_cvs'};
        $madesomething .= make_vcs_dir ($name, $dic, $dis, $dtc, $pub);
        $madesomething .= make_area ('CvsMakeAreaSavannah', $name, $dic, $pub)
          if ($dtc eq "savannah-gnu" or $dtc eq "savannah-nongnu");
      }

    # The web area.
    if ($vars{'use_homepage'} && !$no_homepage)
      {
        my $dih = $vars{'dir_homepage'};
        my $dth = $vars{'dir_type_homepage'};
        $madesomething .= make_vcs_dir ($name, $dih, $dis, $dth, $pub);
        $madesomething .=
          make_area ('WebCvsMakeAreaSavannahGNU', $name, $dih, $pub)
            if $dth eq "savannah-gnu";
        $madesomething .=
          make_area ('WebCvsMakeAreaSavannahNonGNU', $name, $dih, $pub)
            if $dth eq "savannah-nongnu";
      }

    # The download area.
    if ($vars{'use_download'} && !$no_download)
      {
        my $did = $vars{'dir_download'};
         my $dtd = $vars{'dir_type_download'};
        $madesomething .= make_vcs_dir ($name, $did, $dis, $dtd, $pub);
        $madesomething .= make_dl_savannah ($name, $dtd, $did, $pub);
      }

    if ($vars{'use_arch'} && !$no_arch)
      {
        my $dia = $vars{'dir_arch'};
        my $dta = $vars{'dir_type_arch'};
        $madesomething .= make_vcs_dir ($name, $dia, $dis, $dta, $pub);
        $madesomething .= make_dl_savannah ($name, $dta, $dia, $pub);
      }

    if ($vars{'use_svn'} && !$no_svn)
      {
        my $dts = $vars{'dir_type_svn'};
        $madesomething .= make_vcs_dir ($name, $dis, $dis, $dts, $pub);
        $madesomething .= make_dl_savannah ($name, $dts, $dis, $pub);
      }

    if ($vars{'use_git'} && !$no_git)
      {
        $madesomething .=
          make_area ('GitMakeArea', $name, $vars{'dir_git'}, $pub)
            if $vars{'dir_type_git'} eq "basicgit";
      }

    if ($vars{'use_hg'} && !$no_hg)
      {
        $madesomething .= make_area ('HgMakeArea', $name, $vars{'dir_hg'}, $pub)
          if $vars{'dir_type_hg'} eq "basichg";
      }

    if ($vars{'use_bzr'} && !$no_bzr)
      {
        $madesomething .=
          make_area ('BzrMakeArea', $name, $vars{'dir_bzr'}, $pub)
            if $vars{'dir_type_bzr'} eq "basicbzr";
      }
    PrintLog ("-- update $name ($madesomething built)") if $madesomething;
  } # foreach my $group (@db_groups)

PrintLog ("work finished");
print LOG "[$script] ------------------------------------------------------\n";
