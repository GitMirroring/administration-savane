use strict;
use warnings;
use Savane::Version;

my $help =
"Usage: $0 [OPTIONS]

Run crypt(3).  Used in web UI to make and validate hashed passphrases.
The first line is the hashed passphrase (or the prefix), the rest is
the passphrase in cleartext.

  -h, --help           show this help and exit
  -v, --version        show Savane version and exit";

PrintVersionOrHelp ($help);

my $pfx_hash = <STDIN>;
my $passphrase = '';
$passphrase .= $_ while (<>);
chop $pfx_hash;
chop $passphrase;
print crypt ($passphrase, $pfx_hash) . "\n";
exit (0);
