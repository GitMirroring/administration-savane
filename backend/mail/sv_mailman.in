# Status of list:
# 0: list does not exist;
# 1: list is marked for creation;
# 2: list is marked for reconfiguration;
# 5: list exists and needs no changes.
#
# The frontend PHP script sets
# password = 1 when password reset is requested;
# is_public = 9 when user deletes the list;
# status = 1 when adding the list to the database;
# status from 5 to 2 when user reconfigures the existing list.

use strict;
use Getopt::Long;
use Savane;
use POSIX qw(strftime);
use File::Temp qw(tempfile tempdir);
use String::Random qw(random_string);

my $script = "sv_mailman";
my $logfile = "/var/log/sv_database2system.log";

# Import.
our $sys_mail_domain;

my $dry_run;
my $verbose;
my $pfx = "/usr/sbin";
my $ssh_user = 'list@lists.gnu.org';
my $cron;

my $help =
"Usage: $0 [OPTIONS]

Pass list admins' requests from frontend to mailman:

* create lists;
* reset mailmain administrative passwords;
* delete lists.

  -h, --help           show this help and exit
  -v, --version        show Savane version and exit
      --dry-run        don't apply changes
      --verbose        log additional info
      --prefix         prefix for mailman tools [$pfx]
      --ssh-user       send mailman commands to the wrapper script over ssh
                         to this user rather than run them locally [$ssh_user]
      --cron           ignored
      --logfile        file for reports [$logfile]";
PrintVersionOrHelp ($help);

GetOptions (
  "dry-run" => \$dry_run, "cron" => \$cron, "prefix=s" => \$pfx,
  "logfile=s" => \$logfile, "verbose" => \$verbose, "ssh-user=s" => \$ssh_user
) or die "Wrong command line";

sub Escape
{
  my $data = $_[0];
  $data =~ s/\'/\\\'/g;
  return $data;
}

sub PrintLog
{
  my ($msg, $extra) = @_;
  my $dashes = '- - - -';
  $dashes = "$dashes $dashes $dashes"; $dashes = "$dashes $dashes $dashes";
  my $dr = $dry_run? " (dry run)": "";
  $msg .= "\n8< $dashes\n$extra$dashes >8" if $extra;
  print LOG strftime "[$script] %c -$dr $msg\n", localtime;
}

# Create a new password, random enough, without too weird characters.
sub make_password
{
  return random_string ("ssssssss");
}

sub send_mail
{
  my ($admin, $name, $password, $action) = @_;
  my $mail = <<"  EOF";
    Hello,

    You requested the $action of the list $name at $sys_mail_domain.

    The new list administrator password of the mailing list $name is:
            $password

    You are advised to change the password, and to avoid using a password
    you use for important accounts, as mailman does not really provide
    security for these list passwords.

    Regards
  EOF
  $mail =~ s/^    //gm;
  my $subj = "Mailman list $name";
  PrintLog ("composed mail", "To: $admin\nSubject: $subj\n$mail")
    if $verbose;
  MailSend ("", $admin, $subj, $mail) unless $dry_run;
  PrintLog ("mail sent to $admin for list $name");
}

sub run_ssh_wrapper
{
  my $msg = shift;
  $msg =~ s/(^|\n) */$1/g;
  PrintLog ("running ssh", $msg) if $verbose;
  return if $dry_run;
  my $cmd;
  open ($cmd, '|-', "ssh -T $ssh_user");
  print $cmd $msg;
  close ($cmd);
}

sub change_pw
{
  my ($name, $password) = @_;
  unless ($ssh_user)
    {
      system ("$pfx/change_pw", "-l", $name, "-p", $password) unless $dry_run;
      return;
    }
  my $msg = << "  EOF";
    COMMAND=change_pw
    LIST_NAME=$name
    PASSWORD=$password
  EOF
  run_ssh_wrapper ($msg);
}

sub rm_list
{
  my $name = shift;
  unless ($ssh_user)
    {
      system ("$pfx/rmlist", $name) unless $dry_run;
    }
  my $msg = << "  EOF";
    COMMAND=rmlist
    LIST_NAME=$name
  EOF
  run_ssh_wrapper ($msg);
}

sub new_list
{
  my ($name, $admin, $password) = @_;
  unless ($ssh_user)
    {
      system ("$pfx/newlist", $name, $admin, $password, '--quiet')
        unless $dry_run;
      return;
    }
  my $msg = << "  EOF";
    COMMAND=newlist
    LIST_FULL_NAME=$name
    ADMIN_MAIL=$admin
    PASSWORD=$password
  EOF
  run_ssh_wrapper ($msg);
}

open (LOG, ">>$logfile");
PrintLog ("starting");

AcquireReplicationLock ();

# Create new lists.
my $lists_ref = GetDBListsRef (
  "mail_group_list m, group_type t, groups g, user u",
  "m.status IN ('0', '1') AND g.group_id = m.group_id AND t.type_id = g.type
   AND u.user_id = m.list_admin AND m.is_public != '9'",
  "list_name, g.group_id, t.mailing_list_virtual_host, u.email"
);
foreach my $line (@$lists_ref)
  {
    chomp ($line);
    my ($name, $group_id, $virtual_host, $admin) = @$line;
    my $complete_name = $name;
    my $password = make_password;
    if ($virtual_host && $virtual_host ne '')
      {
        $complete_name .= '@' . $virtual_host;
      }

    my $admins = join (", ", GetGroupAdminsMail (GetGroupName ($group_id)));
    $admins = "$admin, $admins";
    new_list ($complete_name, $admin, $password);
    PrintLog ("list $name; admins $admins; newlist");
    send_mail ("$admin, $admins", $name, $password, "creation");

    SetDBSettings (
      "mail_group_list", "list_name = '$name'", "status = '5', password = NULL"
    )
      unless $dry_run;
    PrintLog ("list $name <$admin> created");
  } # foreach my $line (@$lists_ref)

# Delete the lists which are marked for deletion (is_public = 9),
# but do exist (status != 0).
foreach my $line
  (
    GetDB (
      "mail_group_list", "status != '0' AND is_public = '9'",
      "group_list_id, list_name"
    )
  )
  {
    chomp ($line);
    my ($id, $name) = split (",", $line);

    rm_list ($name);
    PrintLog ("list $name removed with mailman rmlist");
    DeleteDB ("mail_group_list", "group_list_id = '$id'") unless $dry_run;
    PrintLog ("list $name deleted from the database");
  }

# Reconfigure all lists marked for reconfiguration (status = 2).
# FIXME the only configuration setting is public vs private;
# updating this remotely in mailman doesn't work, so what Savane
# frontend does when showing the mailing lists on group page
# is out-of-sync with what mailman does.
foreach my $line
  (
     GetDB (
       "mail_group_list", "status = '2' AND is_public != '9'",
       "group_list_id, list_name, list_admin"
    )
  )
  {
    chomp ($line);
    my ($id, $name, $admin) = split (",", $line);
    $admin = GetUserName ($admin);

    SetDBSettings ("mail_group_list", "group_list_id = '$id'", "status = '5'")
      unless $dry_run;
    PrintLog ("list $name <$admin> supposedly reconfigured");
  } # foreach my $line...

foreach my $line
  (
    GetDB (
      "mail_group_list", "password = '1'", "group_list_id, list_name, group_id"
    )
  )
  {
    chomp ($line);
    my ($id, $name, $group_id) = split (",", $line);

    my $password = make_password;
    my $admins = join (", ", GetGroupAdminsMail (GetGroupName ($group_id)));

    change_pw ($name, $password);
    # Register the change in the database.
    SetDBSettings (
      "mail_group_list", "group_list_id = '$id'", "password = NULL"
    )
      unless $dry_run;
    PrintLog ("list $name password was reset");
    send_mail ($admins, $name, $password, "password reset");
  }

PrintLog ("work finished");
print LOG "[$script] ------------------------------------------------------\n";
