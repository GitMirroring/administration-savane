use strict;
use Getopt::Long;
use Savane;
use POSIX qw(strftime);
use Time::Local;

my $logfile = "/dev/null";
my $args = join (' ', @ARGV);

my $help =
"Usage: $0 [OPTIONS]

Stub mailman wrapper; implements the protocol used with list\@lists.gnu.org.

  -h, --help           show this help and exit
  -v, --version        show Savane version and exit
      --logfile        log requests in file [$logfile]";
PrintVersionOrHelp ($help);
GetOptions ("logfile=s" => \$logfile) or die ("Wrong command line");

my $dry_run = 0;
my @output_fields = ('version');
my %ctx;
$ctx{'version'} = 'stub Savane ' . GetVersion;

open (LOG, ">>:encoding(UTF-8)", $logfile);
print LOG strftime "--- %c ---\n", localtime;
print LOG "$0 $args\n";
print LOG "--- parsing request ---\n";

sub random_string
{
  my $n = shift;
  $n = length ($n);
  my ($i, $ret);
  for ($i = 0, $ret = ''; $i < $n; $i++)
    {
      my $ch = 0;
      until (chr ($ch) =~ /^[A-Za-z0-9.]/)
        {
          $ch = rand (128);
        }
      $ret .= chr ($ch);
    }
  return $ret;
}

# Create a new password, random enough, without too weird characters.
sub make_password
{
  my $p = $ctx{'password'};
  $p = random_string ("ssssssss") if $p eq '';
  $ctx{'password'} = $p;
  exit_error ("Wrong password $ctx{'password'}")
    unless $p =~ /^[A-Za-z0-9._-]+$/;
}

sub set_dry_run
{
  $dry_run = $ctx{'dry_run'} eq 'yes';
  exit_error ("Wrong dry_run setting $ctx{'dry_run'}") unless $dry_run;
}

sub print_results
{
  print LOG "--- response ---\n";
  foreach my $f (@output_fields)
    {
      print "$f=$ctx{$f}\n";
      print LOG "$f=$ctx{$f}\n";
    }
}

sub require_vars
{
  foreach my $v (@_)
    {
      exit_error ("$v field is missing") unless exists $ctx{$v};
      push @output_fields, $v;
    }
}

sub optional_vars
{
  push @_, 'dry_run';
  foreach my $v (@_)
    {
      push @output_fields, $v if exists $ctx{$v};
    }
}

sub exit_error
{
  print "Error: $_[0]\n";
  print LOG "Error: $_[0]\n";
  print_results ();
  exit 1;
}

sub check_visibility
{
  return unless exists $ctx{'visibility'};
  exit_error ("wrong visibility field $ctx{'visibility'}")
    unless ($ctx{'visibility'} =~ m/^(public|private)$/);
}

sub sanitize_description
{
  return unless exists $ctx{'description'};
  $ctx{'description'} =~ s,\s+, ,g;
  $ctx{'description'} =~ s,',\\',g;
}

sub pre_version
{
  push @output_fields, 'password';
  $ctx{'password'} = '';
}

sub push_output_field
{
  my ($k, $v) = @_;
  push @output_fields, $k;
  $ctx{$k} = $v;
}

sub post_query
{
  my $list = $ctx{'list_name'};
  my $domain = 'savane.test';
  return if $list =~ /fnord/;
  push_output_field ('qry::host_name', $domain);
  push_output_field ('qry::advertised', 1);
  push_output_field ('qry::description', "description for $list\@$domain");
  push_output_field ('qry::owner', "example\@$domain");
}

sub run_sub
{
  my $sub = shift;
  my $sr = \&$sub;
  &$sr () unless $dry_run;
}

sub scan_input
{
  my $i = 0;

  binmode STDIN, ":utf8";
  binmode STDOUT, ":utf8";

  while (<STDIN>)
    {
      print LOG $_;
      my ($key, $val);
      chomp $_;
      my $pos = index ($_, '=');
      $i++;
      exit_error ("Input line $i has no '=': $_") if $pos < 0;
      exit_error ("Input line $i defines an empty key: $_") if $pos < 1;
      $key = lc (substr ($_, 0, $pos));
      $val = substr ($_, $pos + 1);
      $key =~ s,^\s*(\S*)\s*$,$1,;
      $val =~ s,^\s*(\S*)\s*$,$1,;
      exit_error ("Input line $i redefines a key: $_") if exists $ctx{$key};
      $ctx{$key} = $val;
    }
}

scan_input ();

require_vars ('command');
my $cmd = $ctx{'command'};

my %req_vars = (
  'newlist' => [
     'list_full_name', 'admin_mail', 'visibility', 'description', 'password'
  ],
  'change_pw' => ['list_name', 'password'],
  'rmlist' => ['list_name'],
  'config' => ['list_full_name'],
  'query' => ['list_name'],
  'version' => [],
);
my %opt_vars = ('config' => ['description', 'visibility']);
my %sanitizers = (
  'visibility' => 'check_visibility', 'description' => 'sanitize_description',
  'password' => 'make_password', 'dry_run' => 'set_dry_run'
);

my %pre_cmds = ('version' => 'pre_version');
my %post_cmds = ('query' => 'post_query');

exit_error ("unknown command $cmd") unless exists $req_vars{$cmd};

run_sub ($pre_cmds{$cmd}) if exists $pre_cmds{$cmd};
require_vars (@{$req_vars{$cmd}});
optional_vars (@{$opt_vars{$cmd}}) if exists $opt_vars{$cmd};

foreach my $v (@output_fields)
  {
    run_sub ($sanitizers{$v}) if exists $sanitizers{$v};
  }

run_sub ($post_cmds{$cmd}) if exists $post_cmds{$cmd};
print_results ();
exit (0);
