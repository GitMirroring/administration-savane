use strict;
use Getopt::Long;
use Savane::Version;
use Savane::DB;
use Savane::User;
use Savane::Locks;
use File::Copy;
use File::Temp qw(tempfile);

# Imports (needed for strict).
our $sys_mail_list;
our $sys_mail_aliases;

# Preconfigure.
my $sysemails = '/etc/email-addresses';
my $sysaliases = '/etc/aliases';
my $dry_run;
my $verbose;
my $suffix = '';
my $cron;
my $logfile = "/var/log/sv_aliases.log";

our $script = "sv_aliases";
$sysemails = "$sys_mail_list" unless "$sys_mail_list" eq '';
$sysaliases = "$sys_mail_aliases" unless "$sys_mail_aliases" eq '';

my $help = <<"EOF";
  Usage: $0 [OPTIONS]

  Update the list of Savannah users in email and alias files.

    -h, --help      show this help and exit
    -v, --version   show Savane version and exit
        --aliases   alias file [$sysaliases]
        --emails    email file [$sysemails]
        --dry-run   don't apply changes
        --suffix    output to files with this suffix instead of overwriting
                    the original files
        --verbose   log additional info
        --logfile   file for reports [$logfile]
        --cron      ignored
EOF
$help =~ s/^  //gm;
chop $help;
PrintVersionOrHelp ($help);
GetOptions (
  "dry-run" => \$dry_run, "logfile=s" => \$logfile, "cron" => \$cron,
  "verbose" => \$verbose, "suffix=s" => \$suffix,
  "aliases=s" => \$sysaliases, "emails=s" => \$sysemails,
) or die "Wrong command line";

# Avoid concurrent runs.
AcquireReplicationLock ();

open_log ($logfile, $script, $dry_run);

sub move_file
{
  my ($tmpf, $emails) = @_;
  unless ($dry_run)
    {
      system ("chmod", "a+r", $tmpf);
      my $res = move ($tmpf, "$emails$suffix");
      unless ($res)
        {
          my $msg = "Unable to overwrite $emails with $tmpf:" . $!;
          print_log ($msg);
          die $msg;
        }
    }
  print_log ("move $tmpf $emails$suffix");
}

sub update_email_list
{
  my ($emails, $sv_mails) = @_;
  return unless $emails;
  my ($tmpfh, $tmpf) = tempfile (UNLINK => 1);

  print_log ("emails for $emails written to $tmpf") if $verbose;
  open (IN, "< $emails");
  while (<IN>)
    {
      next if (/^\# Savannah include start/ .. /^\# Savannah include end/);
      print $tmpfh $_;
      chomp;
      print_log ("local email copied: $_") if $verbose;
    }
  close (IN);

  seek ($sv_mails, 0, 0);
  while (<$sv_mails>)
    {
      print $tmpfh $_;
      chomp;
      print_log ("Savane-controlled line added: $_") if $verbose;
    }
  close ($tmpfh);
  move_file ($tmpf, $emails);
}

sub fetch_sv_aliases
{
  my ($sv_mails, $sv_mails_file) = tempfile (UNLINK => 1);
  my $msg = <<"  EOF";
    # Savannah include start
    ################################################################
    #  Please DO NOT MODIFY the section in between                 #
    #  'Savannah include start' and 'Savannah include end'.        #
    #  It is generated automatically by sv_aliases                 #
    ################################################################
  EOF
  $msg =~ s/^\s*//gm;
  print $sv_mails $msg;
  PrintAliasesList ($sv_mails);
  print $sv_mails "# Savannah include end\n";
  if ($verbose)
    {
      print_log ("aliases list written to $sv_mails_file");
      seek ($sv_mails, 0, 0);
      while (<$sv_mails>)
        {
          chomp;
          print_log ("Savane-controlled line read: $_") if $verbose;
        }
    }
  return $sv_mails;
}

sub finish
{
  finalize_log ();
  exit (0);
}

unless ($sysemails || $sysaliases)
  {
    print_log ("no alias files to update defined");
    exit (0);
  }

my $sv_mails = fetch_sv_aliases ();
update_email_list ($sysemails, $sv_mails);
update_email_list ($sysaliases, $sv_mails);
close ($sv_mails);
finish () unless $sysaliases;

if (-e "/usr/bin/newaliases")
  {
    system ("/usr/bin/newaliases") unless $dry_run;
    print_log ("/usr/bin/newaliases");
  }
finish ();
