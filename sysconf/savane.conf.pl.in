# Configuration file for Savane Perl scripts.

our $sys_dbname="@SV_DB_NAME@";
our $sys_dbhost="@SV_DB_HOST@";
our $sys_dbport="@SV_DB_PORT@";
our $sys_dbuser="@SV_DB_USER@";
our $sys_dbnetworking = "@SV_DB_NETWORKING@";
our $sys_dbpasswd="@SV_DB_PASSWORD@";
our $sys_dbsocket = "@mysql_socket@"
  if $sys_dbnetworking eq 'no';
our $sys_banned_email_domains = '';
our %sys_banned_email_names = ();
$sys_default_domain = '@WWW_SERVER_HOST@';
$sys_dir_prefix = '@pkgstatedir@';
our $sys_source_code_url = 'PLACEHOLDER-URL';
# The %sys_binaries variable may be used to override the configured
# binaries like,
#
#   $sys_binaries{'hg'} = '/usr/local/bin/hg';
return 1;
