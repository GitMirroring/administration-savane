register_globals = off
magic_quotes_gpc = off
file_uploads = on
log_errors = on
display_errors = on
error_reporting = E_ALL
error_log = "@apache_logdir@/@php_log_file@"

allow_url_fopen = on
disable_functions = passthru,popen,shell_exec,system
date.timezone = "UTC"
@PHP_SENDMAIL_LINE@
