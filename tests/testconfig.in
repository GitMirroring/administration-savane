use strict;
use warnings;
use Savane::Version;
use Savane::Test;

my $frontenddir = '@frontenddir@';
my $gnupgdir = "@pkgstatedir@/gnupg";

sub install_gpg_key
{
  my $pref = "$frontenddir/php/testing/gpg/rsa";
  print_test_log ('Installing sample GnuPG key.');
  try_mkdir ($gnupgdir);
  chmod 0700, $gnupgdir;
  my $gpg_version = `@GPG@ --version`;
  die "Cannot get GnuPG version.\n" unless defined $gpg_version;
  print_test_log ('@GPG@' . " --version output:\n$gpg_version");
  system ('@GPG@', '--home', $gnupgdir, '--import', "$pref-pub.asc")
    && die "Cannot install public GnuPG key.\n";
  system ('@GPG@', '--home', $gnupgdir, '--import', "$pref-priv.asc")
    && die "Cannot install private GnuPG key.\n";
  append_savane_conf ('$sys_gpg_home = "' . $gnupgdir . '";');
  return 0;
}

sub check_source_availability
{
  my $agent = shift;
  print_test_log ('Checking source code availability.');
  my $link = $agent->find_link (text_regex => qr/^savane-[0-9a-f]*\.tar\.gz$/);
  if (!defined $link)
    {
      print_test_error ("Link to source code not found.");
      save_page ($agent, 'no-source-link.html');
      return 1;
    }
  return check_status_code (unmake_url ($link->url ()), '200');
}

END {
  return unless -d $gnupgdir;
  print_test_log ('Removing GnuPG directory.');
  system ('rm', '-f', '-r', $gnupgdir);
}

PrintVersionOrHelp ('Visit testconfig.php and check for essential issues.');

my $exit_code = 2;
exit (1) if install_gpg_key ();
my $agent = make_agent (0) or exit (1);
my $url = 'testconfig.php';

print_test_log ('Visiting testconfig.php.');
$agent->get (make_url ('testconfig.php'));
$exit_code = 1 if check_request_status ($agent, 'testconfig-status.html');

if ($agent->content (raw => 1) =~ /<p id='no-tests-failed'>/)
  {
    print_test_result ('No essential tests failed on the page.');
  }
else
  {
    $exit_code = 1;
    print_test_error ('Some tests failed.');
    save_page ($agent, 'testconfig.html');
  }
$exit_code = 1 if check_source_availability ($agent);
$exit_code = 0 if $exit_code == 2;
print_test_result ("Test done.") unless $exit_code;
exit ($exit_code);
