use strict;
use warnings;
use Savane::Version;
use Savane::Test;
use WWW::Mechanize;

PrintVersionOrHelp ("Test tracker operations.");

my $agent = make_agent ();
my $group = 'administration';
my $tracker = 'support';
my $submit_url = make_url ("/$tracker/?group=$group&func=additem");
my @logins = ('semel', 'bis', 'ter', 'quater', 'quinquies', 'sexies');
my @registered_logins;
my %passwords;
my $exit_code = 0;

my %submit_selects = (
  'category_id' => ['100'],
  'severity' => ['1', '3', '5', '7', '8', '9'],
  'privacy' => ['1', '2'],
  'platform_version_id' => ['100', '110', '120', '130', '140']
);

my %submit_value_names;

my @submit_texts = (
  'originator_email', 'plan_release', 'summary', 'file_description'
);
my %submit_fields = (
  'anonymous' => {'originator_email' => 'anon@savane.test'},
  '<bob>' => {'severity' => '1', 'plan_release' => '0.1'},
  '<ter>' => {'privacy' => '2'}
);
my @submit_textareas = ('details');
my @submit_files;
for (my $i = 1; $i <= 4; $i++)
  {
    push @submit_files, "input_file$i";
  }
my @submit_buttons = ('preview', 'submit');

sub check_input_set
{
  my ($form, $input_type) = (shift, shift);
  my $type = lc ($input_type);
  my @texts = map { $_->name ()} $form->find_input (undef, $type);
  my %text_set;
  my $ret = 0;
  print_test_log ("Checking $type inputs.");
  print_test_result ("$input_type inputs found: ("
    . join (', ', map { "'$_'" } @texts) . ")."
  );
  $text_set{$_} = 1 foreach (@texts);
  foreach my $t (@_)
    {
      next if defined $text_set{$t};
      print_test_error ("$input_type input '$t' is missing.");
      $ret = 1;
    }
  print_test_result ("All expected $type inputs are present.") unless $ret;
  return $ret;
}

sub assign_submit_value_names
{
  my $input = shift;
  my $name = $input->name ();
  my @vals = $input->possible_values ();
  my @val_names = $input->value_names ();
  my @vn;
  foreach (@vals)
    {
      my $n = shift @val_names;
      $submit_value_names{$name}->{$_} = $n;
      push @vn, "'$_' => '" . $n . "'";
    }
}

sub report_changed_names
{
  my $input = shift;
  my $name = $input->name ();
  my @vals = $input->possible_values ();
  my @val_names = $input->value_names ();
  my @vn;
  foreach (@vals)
    {
      next unless exists $submit_value_names{$name}->{$_};
      my $new_val = $submit_value_names{$name}->{$_};
      my $v = shift @val_names;
      push @vn, "'$_': '$v' -> '$new_val'" if $new_val ne $v;;
    }
  return unless @vn;
  my $sep = "\n  ";
  print_test_error ("Values changed for $name:$sep" . join ($sep, @vn));
}

sub report_select_values
{
  my $input = shift;
  my $name = $input->name ();
  my @vals = $input->possible_values ();
  my @val_names = $input->value_names ();
  if (exists $submit_value_names{$name})
    {
      report_changed_names ($input);
      return;
    }
  assign_submit_value_names ($input);
  my @vn;
  push @vn, "'$_' => '" . (shift @val_names) . "'" foreach (@vals);
  my $sep = "\n  ";
  print_test_result ("Values found for $name:$sep" . join ($sep, @vn));
}

sub check_select_values
{
  my $input = shift;
  my $ret = 0;
  my %vals = ('!unknown!' => 1);
  my (@missing, @extra);
  $vals{$_} = 1 foreach (@_);
  $vals{$_}-- foreach ($input->possible_values ());
  report_select_values ($input);
  foreach (keys %vals)
    {
      push @missing, "'$_'" if $vals{$_} > 0;
      push @extra, "'$_'" if $vals{$_} < 0;
      next unless $vals{$_};
      $ret = 1;
    }
  print_test_error ("Missing values: (" . join (', ', @missing) . ").")
    if @missing;
  print_test_error ("Unexpected values: (" . join (', ', @extra) . ").")
    if @extra;
  return $ret;
}

sub check_submit_options
{
  my $form = shift;
  my $ret = check_input_set ($form, 'Option', keys (%submit_selects));
  return $ret if $ret;
  foreach my $name (keys %submit_selects)
    {
      print_test_log ("Checking for values of $name select box.");
      my $input = $form->find_input ($name);
      if (check_select_values ($input, @{$submit_selects{$name}}))
        {
          $ret = 1;
          next;
        }
      print_test_result ("Value set doesn't differ from the expected one.");
    }
  return $ret;
}

sub check_submit_fields
{
  my $form = shift;
  my $ret;
  print_test_log ("Checking submit form fields.");
  $ret = check_input_set ($form, 'Text', @submit_texts);
  $ret = 1 if check_input_set ($form, 'Textarea', @submit_textareas);
  $ret = 1 if check_submit_options ($form);
  return $ret;
}

sub fill_anon_check
{
  my ($form, $name) = @_;
  my $input;
  return if $name ne 'anonymous';
  print_test_log ("Filling the anonymous check.");
  $input = $form->find_input ('check', 'text');
  $input->value ('1984');
}

sub fill_new_item_form
{
  my ($form, $name) = @_;
  my ($input, $text);
  $text = "request by $name";
  print_test_log ("Setting summary, '$text'.");
  $input = $form->find_input ('summary', 'text');
  $input->value ($text);
  $text = "This item was submitted by name of $name.";
  print_test_log ("Setting details, '$text'.");
  $input = $form->find_input ('details', 'textarea');
  $input->value ($text);
  return unless exists $submit_fields{$name};
  my $fields = $submit_fields{$name};
  foreach my $k (keys %$fields)
    {
      my $val = $fields->{$k};
      print_test_log ("Setting the '$k' field to '$val'.");
      $input = $form->find_input ($k);
      $input->value ($val);
    }
}

sub check_request_status
{
  my $agent = shift;
  my $status = $agent->status ();
  return 0 if $status eq '200';
  print_test_error ("Unexpected request status $status.");
  return 1;
}

sub extract_new_item_no
{
  my ($agent, $txt, $name) = @_;
  return $1 if $txt =~ m,#(\d+)<,;
  my $file = "no-item-id-$name.html";
  print_test_error ("Item ID not found.");
  save_page ($agent, $file);
  return undef;
}

sub check_for_success
{
  my ($agent, $txt, $name) = @_;
  return extract_new_item_no ($agent, $1, $name)
    if $txt =~ m,/bool/ok[.]png.* />.*Success:.*New item posted [(]([^)]*)[)],;
  my $file = "no-sucess-$name.html";
  print_test_error ("Success message not found.");
  save_page ($agent, $file);
  return undef;
}

sub check_for_fb
{
  my ($agent, $name) = @_;
  my $txt = $agent->content (raw => 1);
  $name =~ s,[<>],,g;
  return check_for_success ($agent, $1, $name)
    if $txt =~ m,<div id="feedback" class="feedback">([^\n]*),;
  my $file = "no-fb-$name.html";
  print_test_error ("Feedback not found.");
  save_page ($agent, $file);
  return undef;
}

sub check_submitted_item
{
  my ($agent, $name) = @_;
  my $item_id;
  print_test_log ("Checking the submitted request.");
  return -1 if check_request_status ($agent);
  $item_id = check_for_fb ($agent, $name);
  return -1 unless defined $item_id;
  return $item_id;
}

sub request_new_item
{
  my ($agent, $name) = @_;
  my $form;
  $agent->get ($submit_url);
  $form = $agent->form_with_fields (qw (form_id func group_id));
  return 1 if (check_submit_fields ($form));
  fill_new_item_form ($form, $name);
  fill_anon_check ($form, $name);
  print_test_log ('Sending the request.');
  $agent->click ('submit');
  return check_submitted_item ($agent, $name);
}

sub check_new_item
{
  my ($agent, $name, $item_id) = @_;
  return 1 if $item_id < 0;
  $agent->get (make_url ("/$tracker/?$item_id"));
  return 0;
}

sub submit_item
{
  my ($agent, $login) = @_;
  my $name = defined ($login)? "<$login>": "anonymous";
  my ($item_id, $ret);
  my $pw = '-';
  $pw = $passwords{$login}
    if ((defined ($login)) and (defined ($passwords{$login})));
  print_test_log ("Submitting item as $name.");
  log_in ($agent, $login, $pw) if defined $login;
  $item_id = request_new_item ($agent, $name);
  $ret = check_new_item ($agent, $name, $item_id);
  # Remove originator_email from further non-anonymous submissions.
  shift @submit_texts unless defined $login;
  log_out ($agent) if defined $login;
  return $ret;
}

END
{
  print_test_log ("Removing users registered in the test.");
  remove_user ($agent, $_, $passwords{$_}) foreach (@registered_logins);
}

speed_up_crypt ();

foreach my $login (@logins)
  {
    $passwords{$login} = register_user ($agent, $login);
    push @registered_logins, $login;
  }

unshift @logins, undef, '-', 'alice', 'bob';

foreach (@logins)
  {
    $exit_code = 1 if submit_item ($agent, $_);
  }

print_test_result ("Test done.") unless $exit_code;;
exit ($exit_code);
