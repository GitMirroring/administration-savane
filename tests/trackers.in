use strict;
use warnings;
use Savane::Version;
use Savane::Test;
use Savane::Test::Conf;
use Savane::Test::Group;
use Savane::Test::User;
use Savane::Test::Tracker;
use WWW::Mechanize;

PrintVersionOrHelp ("Test tracker operations.");

my $agent = make_agent () or exit (1);
my %group_types = ('proba' => 1, 'proba-nongnu' => 2);
my $admin = 'bob';
my @logins = ('semel', 'bis', 'ter', 'quater', 'quinquies', 'sexies');
my @registered_logins;
my %registered_groups;
my $exit_code = 2;

my %group_members = ($admin => 1);
my %tracker_admins = ($admin => 1, '*' => 1);

my %private_names = ('<ter>' => 1, '<quinquies>' => 1, '<dave>' => 1);
set_private_names (%private_names);

sub clear_session_set
{
  my $agents = shift;
  return unless defined $agents;
  print_test_log ('Clearing session set.');
  foreach (keys %$agents)
    {
      print_test_log ("Closing session for $_.");
      log_out ($agents->{$_}) if defined $_;
    }
}

sub make_session_set
{
  my @users = (undef, 'alice', '-', $admin, '*');
  push @users, map { name_to_login ($_) } keys %private_names;
  push @users, 'bis', 'eve';
  my %ret;
  my $fail = 0;
  print_test_log ('Making a set of sessions.');
  foreach (@users)
    {
      my $agent = make_agent (0);
      my $res = (defined $_)? log_in ($agent, $_): 0;
      if ($res)
        {
          $fail = 1;
          last;
        }
      $ret{displayed_user_name ($_)} = $agent;
    }
  return \%ret unless $fail;
  clear_session_set (\%ret);
  return undef;
}

sub should_have_access
{
  my ($user, $item) = @_;
  my $submitter = displayed_user_name (get_submitted_item ($item));
  return 1 unless item_is_private ($item);
  return 0 unless defined $user;
  return 1 if $submitter eq displayed_user_name ($user);
  return 1 if $user eq '*';
  return 1 if exists $group_members{$user};
  return 0;
}

sub make_test_file
{
  my $fn = shift;
  my $fd;
  my $text;
  print_test_log ("Creating test file $fn.");
  unless (open ($fd, '>', $fn))
    {
      print_test_error ("Cannot open $fn for writing.");
      return undef;
    }
  $text = rand (0x11);
  print {$fd} "$text\n";
  close ($fd);
  print_test_result ("Wrote '$text' (with a newline) to $fn.");
  return "$text\n";
}

sub generate_file_description
{
  my $fn = shift;
  return "comment for $fn with chars like ' and \"";
}

sub attach_file
{
  my ($agent, $form, $fn) = @_;
  my $input = $form->find_input ('input_file1', 'file');
  my $desc = $form->find_input ('file_description', 'text');
  if (defined $input)
    {
      $input->file ($fn);
      $desc->value (generate_file_description ($fn));
      return 0;
    }
  print_test_error ("Input for file not found.");
  save_page ($agent, "$fn-no-file-input.html");
  return 1;
}

sub download_file
{
  my ($agent, $url, $fn) = @_;
  print_test_log ("Downloading file $fn.");
  $agent->get ($url);
  return $agent->content (raw => 1)
    unless check_request_status ($agent, "$fn-download.html");
  return undef;
}

sub compare_attachment
{
  my ($agent, $fn, $text) = @_;
  my $link = $agent->find_link (text_regex => qr/^file\b.*#\d+$/);
  print_test_log ('Looking into uploaded file contents.');
  unless (defined $link)
    {
      print_test_error ('Link to uploaded file not found.');
      save_page ($agent, "$fn-uploaded.html");
      return 1;
    }
  my $file_id = $link->text;
  $file_id =~ s/^\D*//;
  my $dl = download_file ($agent, $link->url (), $fn);
  return undef unless defined $dl;
  if ($dl eq $text)
    {
      print_test_result ("File contents are as expected.");
      return $file_id if $dl eq $text;
    }
  print_test_error ("Contents do not match.");
  return undef;
}

sub check_notif
{
  my $desc = shift;
  my ($headers, $body, $mbox) = get_message ();
  return 1 unless defined $body;
  if (index ($body, "\n$desc\n") < 0)
    {
      print_test_error ("Expected string >$desc< not found in message body.");
      save_text ($mbox, 'notif.mbox');
      return 1;
    }
  print_test_result ('Notification is correct.');
  return 0;
}

sub check_file_notif
{
  print_test_log ('Checking notification on attachment.');
  return check_notif (generate_file_description (shift));
}

sub find_file_deletion_link
{
  my ($agent, $file_id) = @_;
  return $agent->find_link (url_regex => qr/item_file_id=$file_id($|&)/);
}

sub check_if_deletion_is_absent
{
  my ($agent, $file_id, $fn) = @_;
  print_test_log ('Checking that the deletion link is absent.');
  unless (defined find_file_deletion_link ($agent, $file_id))
    {
      print_test_result ("Deletion link for file #$file_id is absent.");
      return 0;
    }
  print_test_error ("Deletion link for file #$file_id is present.");
  save_page ("$fn-persistent.html");
  return 1;
}

sub remove_attachment
{
  my ($agent, $fn, $item_id, $file_id) = @_;
  print_test_log ("Removing attachment #$file_id.");
  $agent->get (make_url (comment_page_url ($item_id)));
  return 1 if check_request_status ($agent, "$fn-status.html");
  my $link = find_file_deletion_link ($agent, $file_id);
  unless (defined $link)
    {
      print_test_error ('Cannot find deletion link.');
      save_page ($agent, "$fn-no-del.html");
      return 1;
    }
  print_test_log ('Following deletion link.');
  $agent->get ($link->url ());
  return 1 if check_request_status ($agent, "$fn-del-status.html");
  return check_if_deletion_is_absent ($agent, $file_id, $fn);
}

sub run_attachment
{
  my ($agent, $fn, $item_id, $name) = @_;
  my $text = make_test_file ($fn, "$fn-make-test.html");
  return 1 unless defined $text;
  my $form = find_form (
    $agent, 'submission', "try-comment-$fn", qw (form_id func group_id preview)
  );
  return 1 unless defined $form;
  return 1 if attach_file ($agent, $form, $fn);
  fill_anon_check ($form, $name);
  print_test_log ('Submitting file.');
  $agent->click ('submitreturn');
  return 1 if check_request_status ($agent, "$fn-status.html");
  return 1 if check_file_notif ($fn);
  my $file_id = compare_attachment ($agent, $fn, $text);
  return 1 unless defined $file_id;
  my $user = name_to_login ($name);
  return check_if_deletion_is_absent ($agent, $file_id, $fn)
    unless (defined ($user) and $tracker_admins{$user});
  return remove_attachment ($agent, $fn, $item_id, $file_id);
}

sub try_attach
{
  my ($agent, $fn, $item_id, $name) = @_;
  my $access = item_is_private ($item_id)? 'private': 'public';
  my $submitter = get_submitters_by_item_id ($item_id);
  $submitter = '(anonymous)' unless defined $submitter;
  return run_attachment (@_)
    if (should_have_access (name_to_login ($name), $item_id));
  print_test_error ('Access should be denied.');
  return 1;
}

sub test_item_page_access
{
  my ($agent, $name, $item_id) = @_;
  my $url = comment_page_url ($item_id);
  my $have_access = should_have_access (name_to_login ($name), $item_id);
  print_test_log ("Testing accessibility of item #$item_id to user $name.");
  print_test_log ('The item is private.') if item_is_private ($item_id);
  return 2
    if (check_status_code ($url, $have_access? '200': '40\d', undef, $agent));
  return $have_access? 0: 1;
}
sub check_comment_status
{
  my ($agent, $fn) = @_;
  unless (check_request_status ($agent))
    {
      print_test_result ('Comment added.');
      return 0;
    }
  print_test_error ('Cannot comment.');
  save_page ($agent, "cant-comment-$fn");
  return 1;
}

sub check_comment_notif
{
  print_test_log ('Checking comment notification.');
  return check_notif (shift);
}

sub try_comment
{
  my ($agent, $fn, $item_id, $name) = @_;
  print_test_log ('Testing comment.');
  my $form = find_form (
    $agent, 'submission', "try-comment-$fn", qw (form_id func group_id preview)
  );
  return 1 unless defined $form;
  my $input = $form->find_input ('comment', 'textarea');
  unless (defined $input)
    {
      print_test_error ("Cannot find comment textarea.");
      save_page ($agent, "comment-input-$fn");
      return 1;
    }
  my $msg = "Comment by $name with chars like ' and \".";
  $input->value ($msg);
  $agent->click ('submitreturn');
  return 1 if check_comment_status ($agent, $fn);
  return check_comment_notif ($msg) unless $name eq 'anonymous';
  return 0;
}

sub test_user_access
{
  my ($agent, $name) = @_;
  my $ret =  0;
  my $fn = 'test.txt';
  foreach (submitted_items_keys ())
    {
      my $filename = "$_-$name-$fn";
      $filename =~ tr/<*>/,+./;
      my $item_access = test_item_page_access ($agent, $name, $_);
      $ret = 1 if $item_access > 1;
      next if $item_access;
      $ret = 1 if try_comment ($agent, $filename, $_, $name);
      print_test_log ('Attaching a file.');
      $ret = 1 if try_attach ($agent, $filename, $_, $name);
      unlink ($filename) if -f $filename;
    }
  return $ret;
}

sub check_item_access
{
  my $agents = make_session_set ();
  return 1 unless defined $agents;
  my $ret = 0;
  foreach (keys (%$agents))
    {
      $ret = 1 if test_user_access ($agents->{$_}, $_);
    }
  clear_session_set ($agents);
  return $ret;
}

sub log_test_redirect
{
  my ($url, $redir, $err) = @_;
  $url = make_url ($url);
  if ($redir)
    {
      print_test_result ("$url redirects.", $err);
      return;
    }
  print_test_result ("$url doesn't redirect.", $err);
}

sub test_redir
{
  my ($agent, $url, $should_redirect) = @_;
  my ($redir, $err);
  $url = make_url ($url);
  $agent->get ($url);
  return 1 if check_request_status ($agent, 'redir.html');
  $redir = $agent->redirects ();
  $err = $should_redirect ^ !!$redir;
  log_test_redirect ($url, $redir, $err);
  return $err;
}

sub test_redirect
{
  my ($agent, $group, $gnu) = @_;
  my @artifacts = ('support', 'task', 'news', 'hg');
  my @urls = ("projects/$group/");
  push @urls, "$_/?group=$group" foreach @artifacts;
  my $item = recall_item_url ($group);
  my $ret = !defined $item;
  push @urls, $item unless $ret;
  print_test_log ("Checking if >$group< group redirects from 'gnu'.");
  select_root_url ('www');
  foreach (@urls)
    {
      $ret = 1 if test_redir ($agent, $_, !$gnu);
    }
  print_test_log ("Checking if >$group< group redirects from 'nongnu'.");
  select_root_url ('twin');
  foreach (@urls)
    {
      $ret = 1 if test_redir ($agent, $_, $gnu);
    }
  return $ret;
}

sub test_group_domains
{
  my ($group, $gnu) = @_;
  my $agent = make_agent (0);
  return test_redirect ($agent, $group, $gnu);
}

END
{
  print_test_log ("Removing users registered in the test.");
  foreach (@registered_logins)
    {
      $exit_code = 1 if remove_user ($agent, $_);
    }
  print_test_log ("Removing groups registered in the test.");
  foreach (keys %registered_groups)
    {
      $exit_code = 1 if remove_group ($registered_groups{$_}, $_);
    }
  $? = $exit_code;
}

speed_up_crypt (undef, 1) and exit (1);

foreach my $login (@logins)
  {
    my $passwd = register_user ($agent, $login);
    $exit_code = 1 unless defined $passwd;
    next unless defined $passwd;
    push @registered_logins, $login;
  }

unshift @logins, undef, '-', 'alice', 'bob', 'dave';

foreach (keys %group_types)
  {
    my $group_id = register_group ($agent, $admin, $_, $group_types{$_});
    exit (1) if $group_id < 0;
    $registered_groups{$_} = $group_id;
  }
clear_mbox (1);
my $group;
foreach $group (keys %group_types)
  {
    foreach (@logins)
      {
        $exit_code = 1 if submit_item ($_, $group, get_current_tracker ());
      }
  }

$exit_code = 1 if check_item_access ();
my $root_idx = select_root_url ();
foreach (keys %group_types)
  {
    $exit_code = 1 if test_group_domains ($_, $group_types{$_} == 1);
  }
select_root_url ($root_idx);
$exit_code = 0 if $exit_code == 2;
print_test_result ("Test done.") unless $exit_code;
exit ($exit_code);
