use strict;
use warnings;
use Savane::Version;
use Savane::Test;
use Savane::Mail;

PrintVersionOrHelp ('Test $sys_log_exits (see doc/savane.conf.php).');

my $agent = make_agent ();
my $exit_code = 0;
my $url = 'siteadmin/index.php';
my $cc_error_setting = <<'EOF';
  # Save error reports in mbox.
  $sys_cc_error = ['sv-dev@savane.test' => ['subject' => 'error']];
  $sys_error_cc_limit = -1; # Don't limit error message rate.
EOF

sub check_mbox
{
  my $should_be_empty = @_? shift: 1;
  my $empty = get_mbox (1, 1) eq '';
  if ($should_be_empty)
    {
      if ($empty)
        {
          print_test_result ("Mbox was expectedly empty.");
          return 0;
        }
      print_test_error ("Mbox wasn't empty.");
      return 1;
    }
  if ($empty)
    {
      print_test_error ("Mbox was empty.");
      return 1;
    }
  print_test_result ("Mbox was expectedly not empty.");
  return 0;
}

append_savane_conf ($cc_error_setting);
print_test_log ('Checking default $sys_log_exits behavior.');
assert_status_code ("$url/?iter=0", '403');
$exit_code = 1 if check_mbox ();
print_test_log ('Checking $sys_log_exits explicitly set to false.');
append_savane_conf ('$sys_log_exits = false;');
assert_status_code ("$url/?iter=1", '403');
$exit_code = 1 if check_mbox ();
print_test_log ('Checking $sys_log_exits set to true.');
append_savane_conf ('$sys_log_exits = true;');
assert_status_code ("$url/?iter=2", '403');
$exit_code = 1 if check_mbox (0);
print_test_log ('Checking the theoretical existence of the URL tested.');
assert_status_code ("$url/?iter=3", '200', '*');

print_test_result ("Test done.") unless $exit_code;
exit ($exit_code);
