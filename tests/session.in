use strict;
use warnings;
use Savane::Version;
use Savane::Test;
use Savane::Test::User;
use Savane::Test::Membership;
use WWW::Mechanize;

PrintVersionOrHelp ("Test session-related operations.");

my $list_sessions_php = <<'EOF';
  <?php
  require_once ('include/init.php');
  $res = db_execute ('
    SELECT `user_name`, `time`, `session_hash`
    FROM `session` `s` JOIN `user` `u` ON `s`.`user_id` = `u`.`user_id`'
  );
  while ($row = db_fetch_array ($res))
    print $row['user_name'] . " " . $row['time']
      . " " . $row['session_hash'] . "\n";
  ?>
EOF
$list_sessions_php =~ s/^  //gm;

sub fetch_sessions
{
  my $agent = @_? shift: make_agent ();
  my @ret;
  $agent->get (make_url ('list-sessions.php'));
  push @ret, $_ foreach (split (/\n/, $agent->content (raw => 1)));
  return @ret;
}

sub log_out_single_session
{
  my $s = shift;
  my $ret = 0;
  select_root_url ($s->{'root'});
  $ret = 1 if log_out ($s->{'agent'});
  my %h;
  $h{$_}++ foreach fetch_sessions ($s->{'agent'});
  foreach (@{$s->{'rows'}})
    {
      next unless exists $h{$_};
      print_test_error ("A session wasn't deleted, $_.");
      $ret = 1;
    }
  save_page ($s->{'agent'}, 'left-sessions') if $ret;
  return $ret;
}

sub session_page
{
  return make_url ('my/admin/sessions.php');
}

sub kill_single_session
{
  my ($sessions, $hashes) = @_;
  my $s0 = shift @$sessions;
  my $s = $sessions->[0];
  my $a = $s->{'agent'};
  print_test_log (
    'Killing session ' . $s0->{'time'} . ":\n  "
    . join ("\n  ", @{$s0->{'rows'}})
  );
  select_root_url ($s->{'root'});
  $a->get (session_page ());
  my ($ret, $hashes) = find_session_links ($a);
  return 1 if $ret;
  my $url = get_session_link ($a, $s0, $hashes);
  return 1 unless defined $url;
  $a->get ($url);
  return check_request_status ($a, 'cant-kill-session.html');
}

sub kill_some_sessions
{
  my ($sessions, $n) = @_;
  my $ret = 0;
  print_test_log ("Killing $n sessions.");
  while (--$n > 0)
    {
      $ret = 1 if kill_single_session ($sessions);
    }
  return $ret;
}

sub log_out_some_sessions
{
  my ($sessions, $n) = @_;
  print_test_log ("Logging out $n sessions.");
  my $ret = 0;
  while (--$n > 0)
    {
      my $s = shift @$sessions;
      $ret = 1 if log_out_single_session ($s);
    }
  return $ret;
}

sub have_kill_session_link
{
  my $a = shift;
  return 0 unless defined $a->find_link (text => 'Kill this session');
  print_test_error ('Some sessions are left to kill.');
  save_page ($a, 'unkilled-sessions.html');
  return 1;
}

sub kill_most_sessions
{
  my $s = shift;
  my $a = $s->{'agent'};
  print_test_log ('Killing all sessions except the current one.');
  select_root_url ($s->{'root'});
  $a->get (session_page ());
  my $link = $a->find_link (text => 'Kill all sessions');
  unless (defined $link)
    {
      print_test_error ('No link to kill all sessions found.');
      save_page ($a, 'no-kill-all-link.html');
      return 1;
    }
  $a->get ($link->url);
  return 1 if (check_request_status ($a, 'cant-kill-all.html'));
  return 1 if have_kill_session_link ($a);
  print_test_result ('Successfully killed all sessions but the current one.');
  return 0;
}

sub log_out_sessions
{
  my $sessions = shift;
  my $ret = kill_some_sessions ($sessions, int ($#$sessions / 3));
  $ret = 1 if log_out_some_sessions ($sessions, int ($#$sessions / 2));
  my $last_session = shift @$sessions;
  $ret = 1 if kill_most_sessions ($last_session);
  print_test_log ("Logging out the last session.");
  $ret = 1 if log_out_single_session ($last_session);
  return $ret;
}

sub report_new_sessions
{
  my ($agent, $user, $fresh) = (shift, shift, shift);
  unless (@_)
    {
      print_test_result ("No new sessions found for $user.", !$fresh);
      return 0 if $fresh;
      save_page ($agent, "no-new-$user");
      return 1;
    }
  print_test_result ("New sessions found for $user:\n  " . join ("\n  ", @_));
  my $n = $#_ + 1;
  return 0 if $n <= 2 || $fresh;
  print_test_result ("$n new sessions found, should be 2 or less.");
  save_page ($agent, "many-new-sessions-$user");
  return 1;
}

# Check that all new sessions share the same "$user $time $ticket" values.
sub check_session_consistency
{
  my ($agent, $user, $fresh) = (shift, shift, shift);
  return 0 if $fresh;
  my %ids;
  foreach (@_)
    {
      my $id = $_;
      $id =~ s,;.*,,;
      $ids{$id}++;
    }
  my @ids = keys (%ids);
  if ($#ids == 0)
    {
      print_test_result ('New sessions look consistent.');
      return 0;
    }
  print_test_error ("Inconsistent hashes found:\n  " . join ("\n  "), @ids);
  save_page ($agent, "inconsistent-sessions-$user");
  return 1;
}

my $hash_tail_length = 8;

sub check_new_tails
{
  my $hashes = shift;
  return 0 unless defined $$hashes;
  my (%tails, %new);
  my $ret = 0;
  $new{$_} = 1 foreach (@_);
  foreach my $id (keys %{$$hashes})
    {
      next if exists $new{$id};
      $id =~ s/(.*;).*(.{$hash_tail_length})$/$1...$2/;
      $tails{$id} = 1;
    }
  foreach my $id (@_)
    {
      $id =~ s/(.*;).*(.{$hash_tail_length})$/$1...$2/;
      print_test_log ("Session ID '$id' found.");
      next unless exists $tails{$id};
      print_test_log ("Session ID '$id' is ambiguous.");
      $ret = 1;
    }
  return $ret;
}

sub check_new_sessions
{
  my ($user, $hashes, $fresh) = @_;
  my @ret;
  my $agent = make_agent ();
  foreach my $line (fetch_sessions ($agent))
    {
      my ($uname) = split (/ /, $line);
      next unless lc ($uname) eq $user;
      next if exists $$hashes->{$line};
      $$hashes->{$line} = 1;
      push @ret, $line;
    }
  return () if report_new_sessions ($agent, $user, $fresh, @ret);
  return () if check_session_consistency ($agent, $user, $fresh, @ret);
  return @ret;
}

my @hosts = ('www', 'twin');
my ($host_no, $no_brother) = (0, 0);
sub next_log_in
{
  my ($user, $j) = shift;
  my $agent = make_agent (0);
  unless (defined ($agent))
    {
      $$j = -1;
      return undef;
    }
  if ($host_no > $#hosts)
    {
      $no_brother = !$no_brother;
      $host_no = 0;
    }
  select_root_url ($hosts[$host_no++]);
  return $agent unless (log_in ($agent, $user, undef, $no_brother));
  $$j = -1;
  return undef;
}

sub build_session
{
  my ($user, $hashes, $j) = @_;
  my $agent = next_log_in ($user, $j);
  return undef unless defined ($agent);
  my @new_sessions = check_new_sessions ($user, $hashes);
  unless (@new_sessions)
    {
      log_out ($agent);
      $$j = -1;
      return undef;
    }
  if (check_new_tails ($hashes, @new_sessions))
    {
      log_out ($agent);
      $$j++;
      return undef;
    }
  my ($uname, $time) = split (/ /, $new_sessions[0]);
  return {'agent' => $agent, 'time' => $time, 'rows' => \@new_sessions};
}

sub make_sessions
{
  my $n = 0x22;
  my $user = shift;
  my $hashes;
  print_test_log ('Building new sessions.');
  check_new_sessions ($user, \$hashes, 1);
  my @ret;
  for (my ($i, $j) = (0, 0); $i - $j < $n && $j < $n && $j >= 0; $i++)
    {
      my $s = build_session ($user, \$hashes, \$j);
      next unless (defined $s);
      $s->{'root'} = select_root_url ();
      $s->{'combined'} = !$no_brother;
      push @ret, $s;
    }
  return undef unless $#ret == $n - 1;
  return \@ret;
}

sub find_session_links
{
  my $agent = shift;
  my $ret = 0;
  my %hashes;
  my $link_re = qr,/sessions\.php[?]func=del[&].*dtime=,;
  foreach my $l ($agent->find_all_links (url_regex => $link_re))
    {
      my $url = $l->url;
      unless ($url =~ /.*[&]dsession_hash=\.\.\.([^&]*)[&].*dtime=(\d*)/)
        {
          $ret = -1;
          print_test_result ("Wrong session link found, '$url'.");
          next;
        }
      $hashes{"$2;$1"} = $url;
      $hash_tail_length = length ($1);
    }
  return ($ret, \%hashes);
}

sub report_session_link_not_found
{
  my ($agent, $t) = (shift, shift);
  print_test_error (
    "Session link not found: t = $t, hashes " . join (', ', @_) . "."
  );
  save_page ($agent, "no-session-link.html");
}

sub get_session_link
{
  my ($agent, $s, $hashes) = @_;
  my $t = $s->{'time'};
  my @ret;
  my @tails;
  push @tails, substr ($_, -$hash_tail_length) foreach (@{$s->{'rows'}});
  foreach (@tails)
    {
      my $tail = substr ($_, -$hash_tail_length);
      next unless exists $hashes->{"$t;$tail"};
      print_test_result ("Found session $t;$tail.");
      push @ret, $hashes->{"$t;$tail"};
    }
  return $ret[0] if $#ret == 0;
  if (@ret)
    {
      print_test_error ("Multiple matching sessions found.");
      return undef;
    }
  report_session_link_not_found ($agent, $t, @tails);
  return undef;
}

sub have_session_link
{
  return defined get_session_link (@_);
}

sub count_missing_session_links
{
  my ($agent, $sessions) = @_;
  my ($ret, $hashes) = find_session_links ($agent);
  return $ret if $ret;
  foreach my $s (@$sessions)
    {
      next if $s->{'agent'} == $agent;
      $ret++ unless have_session_link ($agent, $s, $hashes);
    }
  return $ret;
}

sub check_session_url
{
  my ($s0, $sessions) = @_;
  my $agent = $s0->{'agent'};
  my $url = session_page ();
  my @tails = ();
  push @tails, substr ($_, -$hash_tail_length) foreach (@{$s0->{'rows'}});
  my $s = $s0->{'time'} . ": (" . join (', ', @tails) . ')';
  print_test_log ("Visiting session page $url, session $s.");
  $agent->get ($url);
  return 1 if (check_request_status ($agent, 'no-sessions.html'));
  return count_missing_session_links ($agent, $sessions);
}

sub check_session_pages
{
  my $sessions = shift;
  my $ret = 0;
  foreach my $s0 (@$sessions)
    {
      select_root_url ($s0->{'root'});
      $ret = 1 if (check_session_url ($s0, $sessions));
      next unless $s0->{'combined'};
      select_root_url (get_twin_idx ($s0->{'root'}));
      $ret = 1 if (check_session_url ($s0, $sessions));
    }
  return $ret;
}

sub main
{
  return 1 if write_test_php ('list-sessions.php', $list_sessions_php);
  my $sessions = make_sessions ('bob');
  unless (defined $sessions)
    {
      print_test_error ("Cannot make session set.");
      return 1;
    }
  print_test_log ("Made session set.");
  my $exit_code = check_session_pages ($sessions);
  $exit_code = 1 if log_out_sessions ($sessions);
  print_test_result ("Test done.") unless $exit_code;
  return $exit_code;
}

exit (main ());
