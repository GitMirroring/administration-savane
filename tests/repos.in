use strict;
use warnings;
use Savane::Version;
use Savane::Test;
use WWW::Mechanize;

PrintVersionOrHelp ("Test repositories and their modules.");

my $unix_group_name = 'administration';
my $statedir = '@pkgstatedir@';
my @git_repos = ('semel', 'bis', 'ter');
my @git_paths;
my @src_modules = ($unix_group_name, 'proba');
my @web_modules = ($unix_group_name);
my @more_web_modules = ('www', 'web');
my $git_url = make_url ("git/?group=$unix_group_name");
my $admin_url = make_url ("git/admin/?group=$unix_group_name");
my $agent = make_agent ()
  or exit (1);

sub simulate_cvs_repos
{
  my @modules = @src_modules;
  push @modules, 'CVSROOT';
  my $root = $statedir;
  for ('cvs', 'sources', $unix_group_name)
    {
      $root .= "/$_";
      try_mkdir ($root);
    }
  try_mkdir ("$root/$_") for (@modules);
  $root = "$statedir/cvs/web";
  try_mkdir ($root);
  $root .= "/$unix_group_name";
  try_mkdir ($root);
  @modules = @web_modules;
  push @modules, 'CVSROOT';
  try_mkdir ("$root/$_") for (@modules);
}

sub git_root
{
  return "$statedir/git";
}

sub simulate_git_repos
{
  my $root = git_root ();
  try_mkdir ($root);
  try_mkdir ("$root/$unix_group_name");
  push @git_paths, "$unix_group_name.git";
  push @git_paths, "$unix_group_name/$_.git" for @git_repos;
  try_mkdir ("$root/$_") for @git_paths;
}

sub try_rm_dir
{
  my $dir = shift;
  print_test_error ("Can't clear $dir: $!.")
    unless rmdir ($dir);
}

sub clear_repos
{
  my $root = git_root ();
  my @modules = @src_modules;
  push @modules, 'CVSROOT';
  try_rm_dir ("$root/$_") for (@git_paths);
  try_rm_dir ("$root/$unix_group_name");
  try_rm_dir ($root);
  $root = "$statedir/cvs/sources/$unix_group_name";
  try_rm_dir ("$root/$_") for (@modules);
  try_rm_dir ($root);
  $root = "$statedir/cvs/web/$unix_group_name";
  @modules = @web_modules;
  push @modules, 'CVSROOT';
  try_rm_dir ("$root/$_") for (@modules);
  try_rm_dir ($root);
  $root = "$statedir/cvs";
  try_rm_dir ("$statedir/cvs/$_") for ('sources', 'web');
  try_rm_dir ($root);
}
my %mod_cnt;
sub check_existing_modules
{
  my $res = 0;
  for (@_)
    {
      if ((exists ($mod_cnt{$_}) && $mod_cnt{$_} == 1))
        {
          $mod_cnt{$_} = -1;
          next;
        }
      $res = 1;
      if (exists ($mod_cnt{$_}))
        {
          print_test_error ("Module $_ is listed $mod_cnt{$_} times.");
          next;
        }
      print_test_error ("Module $_ is absent in the list.")
    }
  return $res;
}
sub check_extra_modules
{
  my $res = 0;
  for (keys (%mod_cnt))
    {
      next if $mod_cnt{$_} < 0;
      print_test_error ("Unexpected module $_ is listed $mod_cnt{$_} times.");
      $res = 1;
    }
  return $res;
}
sub check_module_set
{
  my $res = check_existing_modules (@_);
  $res = 1 if check_extra_modules ();
  return unless $res;
  save_page ($agent, 'module-set.html');
  exit (1);
}
sub find_module_list
{
  my ($page, $start, $end) = @_;
  unless ($page =~ s#.*$start(.*)$end.*#$1#s)
    {
      print_test_error ("No module list found.");
      save_page ($agent, 'no-module-list.html');
      exit (1);
    }
  $page =~ s#^\s*<li>(.*)</li>\s*$#$1#s;
  %mod_cnt = ();
  my @mods = split (/<\/li>\s*<li>/s, $page);
  print_test_result ("Modules found: " . join (', ', @mods) . ".");
  $mod_cnt{$_}++ for (@mods);
}
sub assert_no_module_list
{
  my ($page, $start, $end) = @_;
  unless ($page =~ m#$start(.*)$end#s)
    {
      print_test_result ("No modules found.");
      return;
    }
  print_test_error ("Module list is found unexpectedly:\n$1\n");
  save_page ($agent, 'modules.html');
}
sub source_start
{
  return '<h4>Software repository:</h4>.*<p>Available CVS modules:</p>.*<ul>'
    unless shift;
  return '<h3>Authenticated SSH access</h3>.*'
    . '<h4>Software repository:</h4>.*<p>Available CVS modules:</p>.*<ul>';
}
sub source_end
{
  return '</ul>.*<h4>Webpage repository:</h4>.*<h3>Authenticated SSH access</h3>'
    unless shift;
  return '</ul>.*<h4>Webpage repository:</h4>';
}
sub check_source_repos
{
  my $page = shift;
  my ($start, $end);
  print_test_log ("Looking for source module list in the anonymous section.");
  $start = source_start ();
  $end = source_end ();
  find_module_list ($page, $start, $end);
  check_module_set (@src_modules);

  $start = source_start (1);
  $end = source_end (1);
  print_test_log (
    "Looking for source module list in the authenticated section."
  );
  find_module_list ($page, $start, $end);
  check_module_set (@src_modules);
}

sub check_source_absense
{
  my $page = shift;
  my ($start, $end);
  print_test_log ("Looking for source module list in the anonymous section.");
  $start = source_start ();
  $end = source_end ();
  assert_no_module_list ($page, $start, $end);
  $start = source_start (1);
  $end = source_end (1);
  print_test_log (
    "Looking for source module list in the authenticated section."
  );
  assert_no_module_list ($page, $start, $end);
}

sub web_start
{
  return '<h4>Software repository:</h4>.*<h4>Webpage repository:</h4>.*<ul>'
    unless shift;
  return '<h3>Authenticated SSH access</h3>.*'
    . '<h4>Software repository:</h4>.*<h4>Webpage repository:</h4>.*'
    . '<p>Available CVS modules:</p>.*<ul>';
}
sub web_end
{
  return '</ul>.*<h3>Authenticated SSH access</h3>'
    unless shift;
  return '</ul>';
}

sub check_web_absense
{
  my $page = shift;
  my ($start, $end);
  $start = web_start ();
  $end = web_end ();
  print_test_log ("Looking for web module list in the anonymous section.");
  assert_no_module_list ($page, $start, $end);
  $start = web_start (1);
  $end = web_end (1);
  print_test_log ("Looking for web module list in the authenticated section.");
  assert_no_module_list ($page, $start, $end);
}

sub check_web_repos
{
  my $page = shift;
  my ($start, $end);
  $start = web_start ();
  $end = web_end ();
  print_test_log ("Looking for web module list in the anonymous section.");
  find_module_list ($page, $start, $end);
  check_module_set (@web_modules);

  $start = web_start (1);
  $end = web_end (1);
  print_test_log ("Looking for web module list in the authenticated section.");
  find_module_list ($page, $start, $end);
  check_module_set (@web_modules);
}
sub get_cvs_section
{
  my $url = shift;
  my ($page, $start);
  print_test_log ("Getting page at $url.");
  $agent->get ($url);
  $start = 'Getting a Copy of the CVS Repository';
  $page = $agent->content (raw => 1);
  return $page
    if $page =~ s#.*<h2>$start</h2>(.*)<h2>Email Notifications</h2>.*#$1#s;
  print_test_error ("Page at $url has a wrong structure.");
  save_page ($agent, 'cvs-section.html');
  exit (1);
}
sub run_cvs_checks
{
  my $url = "cvs/?group=$unix_group_name";
  my $page = get_cvs_section ($url);
  check_source_absense ($page);
  check_web_absense ($page);
  simulate_cvs_repos ();
  $page = get_cvs_section ($url);
  check_source_repos ($page);
  check_web_absense ($page);
  print_test_log ("Adding web modules " . join (', ', @more_web_modules) . '.');
  push @web_modules, @more_web_modules;
  try_mkdir ("$statedir/cvs/web/$unix_group_name/$_") for (@more_web_modules);
  $page = get_cvs_section ($url);
  check_web_repos ($page);
}

sub find_repos_in_html
{
  my ($start, $end, $item_start, $item_end) = @_;
  my $page = $agent->content (raw => 1);
  unless ($page =~ s#.*$start(.*)$end.*#$1#s)
    {
      print_test_error ("No repo list found.");
      save_page ($agent, 'repos.html');
      exit (1);
    }
  $page =~ s#^\s*$item_start(.*)$item_end\s*$#$1#s;
  %mod_cnt = ();
  my @mods = split (/$item_end\s*$item_start/s, $page);
  $mod_cnt{$_}++ for (@mods);
  print_test_result ("Repos found: " . join (', ', keys (%mod_cnt)) . ".");
}

sub list_git_browsing
{
  print_test_log ("Looking for repos in the browsing section.");
  find_repos_in_html (
    "<h2>Browsing the Git Repository</h2>.*<ul>",
    "</ul>.*<h2>Getting a Copy of the Git Repository</h2>",
    "<li><a [^>]*>", "</a></li>"
  );
  return check_module_set (@_);
}

sub list_git_anon_access
{
  print_test_log ("Looking for repos in anonymous access section.");
  find_repos_in_html (
    "<h3>Anonymous access</h3>\\s*<pre>",
    "</pre>\\s*<h3>Authenticated SSH access</h3>",
    "", "\\ngit clone[^\\n]*[.]git\\n"
  );
  return check_module_set (@_);
}

sub list_git_ssh_access
{
  print_test_log ("Looking for repos in authenticated access section.");
  find_repos_in_html (
    "<h3>Authenticated SSH access</h3>\\s*<pre>", "</pre>\\s*<p>",
    "", "\\ngit clone[^\\n]*[.]git\\n"
  );
  return check_module_set (@_);
}

sub list_git_repos
{
  my @paths = @_;
  my $exit_code = 0;
  print_test_log ("Enumerating git repos.");
  $agent->get ($git_url);
  $exit_code = 1 if list_git_browsing (@paths);
  $exit_code = 1 if list_git_anon_access (@paths);
  $exit_code = 1 if list_git_ssh_access (@paths);
  return  $exit_code;
}

sub list_git_admin_items
{
  my @repos = @_;
  s/[.]git$// for @repos;
  print_test_log ("Looking for repos on Git administration page.");
  find_repos_in_html (
    "web server[.]</p>\\s*<div class=.boxitem[^>]*>\\s<h2 [^>]*>",
    "</h2>\\s*.*?</div>\\s*<p class=.backtotop.>",
    "\\s*<div class=.boxitem[^>]*>\\s<h2 [^>]*>", "</h2>\\s*.*?</div>\\s*"
  );
  return check_module_set (@repos);
}

sub defstr
{
  my $a = shift;
  return defined $a? $a: '(undef)';
}

sub set_git_input
{
  my ($i, $field_name, $val) = @_;
  print_test_log ("Setting $field_name$i to '" . defstr ($val) . "'.");
  $agent->form_with_fields ("desc$i", "disable_tarballs$i", "readme$i");
  my $form = $agent->current_form ();
  my $input = $form->find_input ("#${field_name}$i");
  $agent->set_fields ("$field_name$i" => $val);
  $agent->click ();
  $agent->form_with_fields ("desc$i", "disable_tarballs$i", "readme$i");
  $form = $agent->current_form ();
  $input = $form->find_input ("#${field_name}$i");
  return if (defstr ($input->value ()) eq defstr ($val));
  print_test_error (
    "Can't set: the value is '" . defstr ($input->value ()) . "'."
  );
  exit (1);
}

sub set_git_field
{
  my $field_name = shift;
  my @ret;
  my $i;
  for ($i = 0; $i <= $#git_paths; $i++)
    {
      $agent->form_with_fields ("desc$i", "disable_tarballs$i", "readme$i");
      my $form = $agent->current_form ();
      my $input = $form->find_input ("#${field_name}$i");
      push @ret, $input->value ();
    }
  for ($i = 0; ($i <= $#git_paths) && @_; $i++)
    {
      set_git_input ($i, $field_name, shift);
    }
  return @ret;
}

sub modify_git_configuration
{
  my @new_desc = ('default reposiory', 'third', 'first', 'second');
  my @new_readme = ('admin.readme', 'third.read.me', 'readme.first', 'rm.sec');
  my @new_tarballs = (undef, 1, undef, 1);
  my @desc = set_git_field ('desc', @new_desc);
  my @readme = set_git_field ('readme', @new_readme);
  my @tarballs = set_git_field ('disable_tarballs', @new_tarballs);

  $agent->get ($git_url);
  my $ret = list_git_repos (@new_desc);
  print_test_log ("Resetting Git configuration.");
  $agent->get ($admin_url);
  set_git_field ('desc', @desc);
  set_git_field ('readme', @readme);
  set_git_field ('disable_tarballs', @tarballs);
  return $ret;
}

sub run_git_checks
{
  simulate_git_repos ();
  exit (1) if list_git_repos (@git_paths);
  $agent->get ($admin_url);
  exit (1) if list_git_admin_items (@git_paths);
  exit (1) if modify_git_configuration ();
}

log_in ($agent);
run_cvs_checks ();
run_git_checks ();

print_test_result ("Test done.");
exit (0);
END { clear_repos (); }
