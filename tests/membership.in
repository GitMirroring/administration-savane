use strict;
use warnings;
use Savane::Version;
use Savane::Test;
use Savane::Test::Membership;
use WWW::Mechanize;

PrintVersionOrHelp ("Test membership operations.");

my $agent = make_agent ()
  or exit (1);
my $exit_code = 0;

my $user = 'eve';
my $id = get_user_id ($user);
if ($id < 0)
  {
    $exit_code = 1;
  }
else
  {
    log_in ($agent, '-');
    $agent->get (group_admin_url ());
    remove_user_from_group ($agent, $user, $id)
      if user_id_is_removable ($agent, $id);
    log_out ($agent);
    $exit_code = 1 if request_inclusion ($agent, $user);
  }

log_in ($agent, '-');
$agent->get (group_admin_url ());

$user = 'dave';
$id = add_user_to_group ($agent, $user);
if ($id < 0)
  {
    $exit_code = 1;
  }
else
  {
    $agent->get (group_user_perm_url ());
    $agent->get (group_admin_url ());
    $exit_code = 1 if remove_user_from_group ($agent, $user, $id);
  }


$user = 'eve';
$id = approve_user ($agent, $user);
if ($id < 0)
  {
    $exit_code = 1;
  }
else
  {
    $exit_code = 1 if remove_user_from_group ($agent, $user, $id);
  }

$user = 'dave';
print_test_log ("Testing self-removal.");
if (add_user_to_group ($agent, $user) < 0)
  {
    $exit_code = 1;
  }
else
  {
    log_out ($agent);
    $exit_code = 1 if quit_group ($agent, 'dave');
  }

print_test_result ('Test done.') unless $exit_code;
exit ($exit_code);
