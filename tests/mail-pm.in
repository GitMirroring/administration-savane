use strict;
use warnings;
use Savane::Version;
use Savane::Test;
use Savane::Mail;

PrintVersionOrHelp ("Test Savane::Mail.");

sub save_mbox
{
  my $fd;
  open ($fd, '>:encoding(UTF-8)', 'mbox');
  print {$fd} $_[0];
  close ($fd);
}

my $to = 'to-addr@savane.test';
my $subj =  'Testing Savane::Mail';
my $msg = "This is a message to test Savane Mail.pm module.\n";
$msg =~ s/^  //gm;

print_test_log ("Sending mail.");
MailSend ($to, $subj, $msg);
print_test_result ("Mail sent.");

my $mbox = get_mbox (1);
unless ($mbox =~ /./)
  {
    print_test_error ("Mailbox is empty.");
    exit (1);
  }
my $needle = 'From @PACKAGE@';
my $exit_code = 0;
if (index ($mbox, $needle) != 0)
  {
    print_test_error ("Mailbox doesn't start with '$needle'.");
    save_mbox ($mbox);
    $exit_code = 1;
  }
my @headers = (
  'From: ' . GetConf ('sys_mail_replyto'),
  "X-Savane-Server: " . GetConf ("sys_default_domain"),
  "X-Savane-Version: " . GetVersion (1),
  "User-Agent: " . 'Savane::Mail.pm',
  "Subject: $subj",
  "To: $to"
);
foreach (@headers)
  {
    next unless index ($mbox, "\n$_") < 0;
    print_test_error ("Mailbox has no line starting with '$_'.");
    save_mbox ($mbox);
    $exit_code = 1;
  }
if (index ($mbox, "\n\n$msg") < 0)
  {
    print_test_error ("Mailbox doesn't contain message '$msg'.");
    save_mbox ($mbox);
    $exit_code = 1;
  }

print_test_result ("Test done.") unless $exit_code;
exit ($exit_code);
