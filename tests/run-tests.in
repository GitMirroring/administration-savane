use strict;
use warnings;
use Savane::Version;

my $sbindir = "@sbindir@";
my $pidfile = "@mysql_pid@";
my $have_database ="@HAVE_DATABASE@";
my $php_bin = "@PHP@";
my $port;
my $php_pid;
my $exit_code = 0;
my $help = <<"EOF";
  Usage: $0 [OPTIONS]

  Run regression tests.

  -h, --help           show this help and exit
  -v, --version        show Savane version and exit
      --php-bin        PHP executable [$php_bin]
EOF
$help =~ s,^  ,,gm;

PrintVersionOrHelp ($help);
GetOptions ("php-bin=s" => \$php_bin)
  or die ("Wrong command line.");
my $kill_servers = 1;

sub launch_db
{
  return unless $have_database;
  system ("$sbindir/sv_launch_db.pl") && die "Can't launch the database.\n";
}
sub kill_db
{
  return unless $have_database;
  system ("$sbindir/sv_kill_db.pl")
    && print STDERR "Can't kill the database server.\n";
}
sub wait_for_db
{
  return unless $have_database;
  for (my $i = 0; $i < 0x11 && ! -f $pidfile; $i++)
    {
      sleep 1;
    }
  -f ($pidfile) || die "Database isn't running.\n";
}
sub launch_php_server
{
  my $port = shift;
  my $pid = fork ();
  system ("echo Trying port $port... >> test-php.log");
  die "Can't fork: $!" unless defined $pid;
  unless ($pid)
    {
      $kill_servers = undef;
      setpgrp ();
      system (
        "$sbindir/sv_php_server.pl --port=$port --php-bin=$php_bin "
        . ">> test-php.log 2>&1"
      );
      exit (0);
    }
  return -1 unless kill 0, $pid;
  system ("echo Using port $port. >> test-php.log");
  return $pid;
}
sub look_for_port
{
  my $port = "@WWW_SERVER_PORT@";
  # Select port different from the configured by default
  # to hopefully avoid collisions at once.
  $port = ($port < 1024 || $port > 9826)? 4913: $port + 1;

  for (my $i = 0; $i < 289; $i++)
    {
      my $php = launch_php_server ($port);
      return ($php, $port) unless $php < 0;
      $port++;
    }
  die "Can't start PHP server.";
}

END
{
  return unless defined $kill_servers;
  kill_db ();
  return unless defined $php_pid;
  return if kill ('-TERM', $php_pid);
  $? = 1;
  print STDERR "Can't kill PHP server.\n";
}

launch_db ();
($php_pid, $port) = look_for_port ();
wait_for_db ();
my @scripts;
my @all_scripts = qw (@test_scripts@);
for (@all_scripts)
  {
    s,^tests/,,;
    push @scripts, $_;
  }

@scripts = @ARGV if ($#ARGV >= 0);
my %results = ('PASS' => 0, 'FAIL' => 0);
for (@scripts)
  {
    my $str = 'PASS';
    print "TEST $_\r";
    if (system ("echo $port | ./$_"))
      {
        $exit_code = 1;
        $str = 'FAIL';
      }
     $results{$str}++;
     print "$str $_\n";
  }
print "\nNumber of tests:\n";
my $total = 0;
for (keys %results)
  {
    print "$_: $results{$_}\n";
    $total += $results{$_};
  }
print "\nTotal: $total\n";
exit ($exit_code);
