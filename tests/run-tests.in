use strict;
use warnings;
use Savane::Version;
use Savane::Test::PHP;

my $sbindir = "@sbindir@";
my $pidfile = "@mysql_pid@";
my $have_database ="@HAVE_DATABASE@";
my $php_bin = "@PHP@";
my $port;
my $exit_code = 0;
my $php_log_name = 'test-php.log';
my $php_log;
my $have_launched_db = 0;
my $help = <<"EOF";
  Usage: $0 [OPTIONS]

  Run regression tests.

  -h, --help           show this help and exit
  -v, --version        show Savane version and exit
      --php-bin        PHP executable [$php_bin]
EOF
$help =~ s,^  ,,gm;

PrintVersionOrHelp ($help);
GetOptions ("php-bin=s" => \$php_bin)
  or die ("Wrong command line.\n");

sub launch_db
{
  return unless $have_database;
  system ("$sbindir/sv_launch_db.pl") && die "Cannot launch the database.\n";
  $have_launched_db = 1;
}
sub kill_db
{
  return 0 unless $have_launched_db;
  return 0 unless $have_database;
  return 0 unless system ("$sbindir/sv_kill_db.pl");
  print STDERR "Can't kill the database server.\n";
  return 1;
}
sub wait_for_db
{
  return unless $have_database;
  for (my $i = 0; $i < 0x11 && ! -f $pidfile; $i++)
    {
      sleep 1;
    }
  -f ($pidfile) || die "Database isn't running.\n";
}
sub look_for_port
{
  my $port = "@WWW_SERVER_PORT@";
  # Select port different from the configured by default
  # to hopefully avoid collisions at once.
  $port = ($port < 1024 || $port > 9826)? 4913: $port + 1;

  for (my $i = 0; $i < 289; $i++)
    {
      print {$php_log} "Trying port $port...\n";
      my $php = launch_php_server ($port, $php_bin);
      last if $php < -1;
      # Older PHP built-in servers like 8.0 may need reloading when
      # savane.conf.php changes, so we launch server in each test process
      # to simplify IPC; here we only test port availability.  In contrast,
      # the database server is launched once for all tests.
      die "Cannot kill PHP server.\n" if kill_php_server ();
      return $port unless $php < 0;
      $port++;
    }
  die "Cannot start PHP server.\n";
}
sub init_all
{
  open ($php_log, '>>', $php_log_name)
    or die "Cannot open log file $php_log_name: $!\n";
  select ($php_log);
  $| = 1;
  select (STDOUT);
  launch_db ();
  $port = look_for_port ();
  wait_for_db ();
}

END
{
  $exit_code = 1 if kill_db ();
  $? = $exit_code;
}

init_all ();
my @scripts;
my @all_scripts = qw (@test_scripts@);
for (@all_scripts)
  {
    s,^tests/,,;
    push @scripts, $_;
  }

@scripts = @ARGV if ($#ARGV >= 0);
my %results = ('PASS' => 0, 'FAIL' => 0);
for (@scripts)
  {
    my $str = 'PASS';
    print "TEST $_\r";
    print {$php_log} "Running $_...\n";
    if (system ("echo \"$port\n$php_bin\" | ./$_ 2>> test.log"))
      {
        $exit_code = 1;
        $str = 'FAIL';
      }
     $results{$str}++;
     print "$str $_\n";
  }
print "\nNumber of tests:\n";
my $total = 0;
for (sort (keys %results))
  {
    print "$_: $results{$_}\n";
    $total += $results{$_};
  }
print "\nTotal: $total\n";
exit ($exit_code);
