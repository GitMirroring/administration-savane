use strict;
use warnings;
use Savane::Version;
use Savane::Test;
use WWW::Mechanize;

PrintVersionOrHelp ("Test user account creation and removal.");

my $agent = make_agent ();
my $login = 'test_user';

sub get_password
{
  my $passwd = $agent->text ();
  $passwd =~ s/.*For instance: ([^.]*).*/$1/;
  $passwd = "merge&tragic-Maxim#$passwd^Detest2new*mutiny";
  print_test_log ("Password: $passwd");
  return $passwd;
}

sub request_account
{
  $agent->get (make_url ('account/register.php'));
  my $passwd = get_password ();
  $agent->form_with_fields (qw (form_id));
  $agent->set_fields (
    'form_loginname' => $login,
    'form_pw' => $passwd, 'form_pw2' => $passwd,
    'form_realname' => "Test User",
    'form_email' => 'user@savane.test',
  );
  $agent->click ('update');
  print_test_log ("Account requested.");
  return $passwd;
}

sub get_confirmation_url
{
  my $url = get_mbox ();
  return make_url ('no-such-page') if $url eq '';
  clear_mbox ();
  $url =~ s/^.*?visit the following URL[^:]*:\n+//s;
  $url =~ s/\n.*$//s;
  print_test_log ("Confirmation URL: $url.");
  return $url;
}

sub confirm_account
{
  my ($login, $passwd) = @_;
  my $url = get_confirmation_url ();
  $agent->get ($url);
  $agent->form_with_fields (qw (form_id));
  $agent->set_fields ('form_loginname' => $login, 'form_pw' => $passwd);
  $agent->click ('update');
  print_test_log ("Account confirmed.");
}

sub request_removal
{
  $agent->get (make_url ('my/admin/change.php?item=delete'));
  $agent->form_with_fields (qw (form_id));
  $agent->tick ('newvalue', 'deletionconfirmed');
  $agent->click ('update');
  print_test_log ("Deletion requested.");
}

sub confirm_deletion
{
  my $url = get_confirmation_url ();
  $agent->get ($url);
  $agent->form_with_fields (qw (form_id));
  $agent->click ('update');
  print_test_log ("Deletion confirmed.");
}

sub have_idle_warning
{
  return $agent->content (raw => 1) =~ /Your account has no records of activity/;
}

sub check_for_idle_warning
{
  if (have_idle_warning ())
    {
      print_test_log ('Warning about being idle is shown on log in.');
      $agent->get (make_url ("my/items.php"));
      if (have_idle_warning ())
        {
          print_test_log ('Warning persists when visiting next page.');
          return 1;
        }
      print_test_log ('Warning disappears when visiting next page.');
      return 0;
    }
  print_test_log ('No warning about being idle is shown on log in.');
  return 1;
}

print_test_log ("Checking for <$login> existence.");
check_inaccessibility ("users/$login");
my $passwd = request_account ();
confirm_account ($login, $passwd);
log_out ($agent);
$agent->get (make_url ("users/$login"));
print_test_log ("Account exists.");
log_in ($agent, $login, $passwd);
my $exit_code = check_for_idle_warning ();
save_page ($agent, 'idle-warning.html') if $exit_code;
request_removal ();
confirm_deletion ();
check_inaccessibility ("users/$login");
print_test_log ("Test done.");
exit ($exit_code);
