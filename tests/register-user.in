use strict;
use warnings;
use Savane::Version;
use Savane::Test;
use Savane::Test::User;
use WWW::Mechanize;
use File::Temp qw (tempfile);

PrintVersionOrHelp ("Test user account-related actions.");

my $agent = make_agent () or exit (1);
my $login = 'test_user';
my $test_php = <<'EOF';
  <?php
    require_once ('include/init.php');
    $email = user_getemail (user_getid ($_GET['login']));
    $d_spec = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
    $proc = proc_open ("echo $email", $d_spec, $pipes, NULL);
    fclose ($pipes[0]);
    print trim (stream_get_contents ($pipes[1]));
    fclose ($pipes[1]); fclose ($pipes[2]);
    proc_close ($proc);
  ?>
EOF
$test_php =~ s/^  //gm;
my $phpdir = '@frontenddir@/php';

sub have_idle_warning
{
  return $agent->content (raw => 1) =~ /Your account has no records of activity/;
}

sub check_for_idle_warning
{
  if (!have_idle_warning ())
    {
      print_test_error ('No warning about being idle is shown on log in.');
      return 1;
    }
  print_test_result ('Warning about being idle is shown on log in.');
  $agent->get (make_url ("my/items.php"));
  if (have_idle_warning ())
    {
      print_test_error ('Warning persists when visiting next page.');
      return 1;
    }
  print_test_result ('Warning disappears when visiting next page.');
  return 0;
}

sub check_est_in_file
{
  my $file = shift;
  print_test_log ("Checking for the contents of temporary file $file.");
  unless (-f $file)
    {
      print_test_error ("File $file does not exist.");
      return 1;
    }
  my $text = `cat "$file"`;
  my $should_be = 'est';
  if ($text eq $should_be)
    {
      unlink $file;
      print_test_result ("The file expectedly contains '$should_be'.");
      return 0;
    }
  print_test_error (
    "The file unexpectedly contains '$text' instead of '$should_be'."
  );
  return 1;
}

sub check_email_in_cmd_results
{
  my ($agent, $file) = @_;
  my $text = $agent->content (raw => 1);
  my $ret = check_est_in_file ($file);
  my $should_be = 'test@savane.test';
  if ($text eq $should_be)
    {
      print_test_result ("The test page expectedly says, '$text'.");
    }
  else
    {
      $ret = 1;
      print_test_error (
        "The test page says, '$text' (should be '$should_be')."
      );
    }
  $ret = 1 if rm_test_php ('test.php', 1);
  return $ret;
}

sub get_email_string
{
  my $file = shift;
  return 't`echo${IFS}-n${IFS}est|tee${IFS}' . $file . '`@savane.test';
}

sub try_email_in_cmd
{
  my $file = shift;
  my $email = get_email_string ($file);
  print_test_log ("Trying command line with unescaped email.");
  return 1 if set_email ($agent, $email);
  return 1 if write_test_php ('test.php', $test_php);
  $agent->get (make_url ("test.php?login=$login"));
  return 1 if check_email_in_cmd_results ($agent, $file);
  return check_request_status ($agent);
}

sub load_rsa
{
  print_test_log ('Loading GnuPG key.');
  my $file = "$phpdir/testing/gpg/rsa-pub.asc";
  my $ret = `cat "$file"`;
  if ($ret eq '')
    {
      print_test_error ("Cannot load $file.");
      return undef;
    }
  print_test_result ("Loaded $file.");
  return $ret;
}

sub check_tmp_file
{
  print_test_log ('Checking temporary file contents (HCK-001).');
  my $file = shift;
  my $text = `cat $file`;
  if ($text eq '')
    {
      print_test_result ('Temporary file is empty as expected.');
      return 0;
    }
  print_test_error ("Temporary file unexpectedly contains '$text'.");
  return 1;
}

sub parse_gpg_result
{
  my $file = shift;
  print_test_log ('Checking GnuPG results.');
  return 1 if check_tmp_file ($file);
  print_test_log ('Checking GnuPG test output.');
  my $text = $agent->content (raw => 1);
  $text =~ s/^.*<h2>Listing keys for &lt;//s;
  $text =~ s/&gt;.*//s;
  my $email = get_email_string ($file);
  if ($text eq  $email)
    {
      print_test_result ("Email on the page is '$email' as expected.");
      return 0;
    }
  print_test_error ("Email on the page is '$email' ('$text' is expected).");
  save_page ($agent, 'test-gpg.html');
  return 1;
}

sub test_gpg
{
  my $filename = shift;
  print_test_log ("Clearing file $filename.");
  `cat /dev/null > $filename`;
  print_test_log ('Testing GnuPG operations.');
  my $key = load_rsa ();
  return 1 unless defined $key;
  print_test_log ('Visiting GnuPG key page.');
  $agent->get (make_url ('my/admin/change.php?item=gpgkey'));
  return 1 if check_request_status ($agent);
  return 1 unless defined find_form (
    $agent, 'GnuPG key', 'no-gpg-form.html', qw (form_id newvalue test_gpg_key)
  );
  $agent->set_fields ('newvalue' => $key);
  print_test_log ('Submitting key for test.');
  $agent->click ('test_gpg_key');
  return parse_gpg_result ($filename) unless check_request_status ($agent);
  print_test_error ('Cannot test key.');
  return 1;
}

sub list_ssh_keys_in_form
{
  my $form = shift;
  my @ret = ();
  foreach ($form->param ())
    {
      next unless $_ =~ /^form_keys\[\d+\]$/;
      my $val = $form->value ($_);
      next unless $val ne '';
      push @ret, $val;
    }
  print_test_log ("Found SSH keys:\n  ". join ("\n  ", @ret)) if @ret;
  print_test_log ('No SSH keys found.') unless @ret;
  return @ret;
}

sub empty_ssh_fields_in_form
{
  my $form = shift;
  my $ret = 0;
  foreach ($form->param ())
    {
      next unless $_ =~ /^form_keys\[\d+\]$/;
      my $val = $form->value ($_);
      $ret++ if $val eq '';
    }
  print_test_log ("$ret empty key fields found in form.");
  return $ret;
}

sub assert_no_ssh_key
{
  my ($agent, $form) = @_;
  my @keys = list_ssh_keys_in_form ($form);
  my $key_num = $#keys + 1;
  return 0 unless $key_num;
  print_test_error ("$key_num keys found in form.");
  save_page ($agent, 'nonempty-ssh-keys.html');
  return 1;
}

sub compose_ssh_keys
{
  my ($agent, $keys, $m) = @_;
  unless ($m)
    {
      print_test_error ('No empty fields found for SSH keys.');
      save_page ($agent, 'no-empty-ssh-fields.html');
      return 1;
    }
  my $n = @$keys? $#{$keys} + 1: 0;
  for (my $i = 0; $i < $m; $i++)
    {
      push @$keys, 'key' . ($i + $n);
    }
  return 0;
}

sub find_ssh_key_form
{
  return find_form (
    $agent, 'SSH key', 'no-ssh-form.html', qw (form_id form_quiet_ssh)
  );
}

sub check_key_values
{
  my ($agent, $form) = (shift, shift);
  my @keys = list_ssh_keys_in_form ($form);
  my ($ret, $kn, $an) = (0, $#keys + 1, $#_ + 1);
  if ($kn != $an)
    {
      print_test_error ("Wrong key number: submitted $an, listed $kn.");
      $ret = 1;
    }
  foreach (@keys)
    {
      my $original_key = shift;
      next if $original_key eq $_;
      print_test_error (
        "Key mismatch, submitted '$original_key', returned '$_'."
      );
      $ret = 1;
    }
  save_page ($agent, 'wrong-ssh-key-values.html') if $ret;
  return $ret;
}

sub check_modified_keys
{
  my $agent = shift;
  my $form = find_ssh_key_form ($agent);
  return 1 unless defined $form;
  my $ret = check_key_values ($agent, $form, @_);
  unless ($ret)
    {
      print_test_result ("Keys updated successfully.");
      return 0;
    }
  return 1 if $ret;
}

sub check_ssh_change_notification
{
  print_test_log ('Checking SSH key change notification.');
  my $mbox = get_mbox ();
  if ($mbox =~ /^Subject: .* SSH key changed on your account$/m
    && $mbox =~ /Someone, presumably you, has changed your SSH keys on/
  )
    {
      print_test_result ('Notification has landed in the mbox.');
      return 0;
    }
  print_test_log ("No notification found: mbox contains the next:\n$mbox");
  return 1;
}

sub submit_ssh_keys
{
  my ($agent, $keys, $skip_notif) = @_;
  my $ret = 0;
  clear_mbox (1) unless $skip_notif;
  print_test_log ('Submitting updated SSH keys.');
  $agent->click ();
  return 1 if check_request_status ($agent);
  $ret = 1 if check_modified_keys ($agent, @$keys);
  $ret = 1 if (!$skip_notif && check_ssh_change_notification ());
  return $ret;
}

sub test_adding_ssh_keys
{
  my ($agent, $form, $keys) = @_;
  print_test_log ('Adding SSH keys.');
  my $e = empty_ssh_fields_in_form ($form);
  return 1 if compose_ssh_keys ($agent, $keys, $e > 1? $e - 1: $e);
  my $i = 0;
  foreach (@$keys)
    {
      print_test_log ("Adding key $i: '$_'.");
      $form->value ("form_keys[$i]", $_);
      $i++;
    }
  if ($e > 1)
    {
      my $idx = $#{$keys} >> 1;
      my $key = $$keys[$idx];
      print_test_log ("Adding key $idx once more: '$key'." );
      $form->value ("form_keys[$i]", $key);
    }
  return submit_ssh_keys ($agent, $keys);
}

sub test_modifying_ssh_keys
{
  my ($agent, $form, $keys) = @_;
  my $idx = int ($#{$keys} * 2 / 3);
  my $key = ${$keys}[$idx];
  print_test_log ("Modifying key $idx: $key");
  $key .= ", modified";
  $form->value ("form_keys[$idx]", $key);
  ${$keys}[$idx] = $key;
  return submit_ssh_keys ($agent, $keys);
}

sub clear_key_in_form
{
  my ($form, $i, $keys) = @_;
  my $key = ${$keys}[$i];
  print_test_log ("Clearing key $i: '$key'.");
  $form->value ("form_keys[$i]", '');
  splice (@$keys, $i, 1);
}

sub test_removing_ssh_keys
{
  my ($agent,$keys) = @_;
  my $form;
  while (@$keys)
    {
      $form = find_ssh_key_form ($agent);
      my $i = int ($#{$keys} * 4 / 5);
      clear_key_in_form ($form, $i, $keys);
      my $j = $i >> 2;
      clear_key_in_form ($form, $j, $keys) if $j != $i;
      $i = $j >> 2;
      clear_key_in_form ($form, $i, $keys) if $j != $i;
      return 1 if submit_ssh_keys ($agent, $keys, 1);
    }
  return 0;
}

sub test_ssh_keys
{
  my @keys;
  print_test_log ('Visiting SSH key page.');
  $agent->get (make_url ('my/admin/editsshkeys.php'));
  return 1 if check_request_status ($agent);
  my $form = find_ssh_key_form ($agent);
  return 1 unless defined $form;
  return 1 if assert_no_ssh_key ($agent, $form);
  for (my $i = 0; $i < 7; $i++)
    {
      return 1 if test_adding_ssh_keys ($agent, $form, \@keys);
      $form = find_ssh_key_form ($agent);
    }
  my $ret = test_modifying_ssh_keys ($agent, $form, \@keys);
  $ret = 1 if test_removing_ssh_keys ($agent,\@keys);
  return $ret;
}

sub make_temp_file
{
  my ($fh, $filename) = tempfile (UNLINK => 1);
  close $fh;
  return $filename unless $filename =~ /\s/;
  print_test_error ("Internal error: space in temp filename '$filename'.");
  return undef;
}

sub run_tests
{
  my $ret = 0;
  my $filename = make_temp_file ();
  exit (1) unless defined $filename;
  my $passwd = register_user ($agent, $login, 'Test User');
  exit (1) unless defined $passwd;
  log_in ($agent, $login, $passwd);
  if (check_for_idle_warning ())
    {
      $ret = 1;
      save_page ($agent, 'idle-warning.html');
    }
  $ret = 1 if try_email_in_cmd ($filename);
  $ret = 1 if test_gpg ($filename);
  $ret = 1 if test_ssh_keys ();
  return $ret;
}

sub main
{
   my $ret = run_tests ();
   log_out ($agent);
   remove_user ($agent, $login);
   print_test_result ("Test done.") unless $ret;
   return $ret;
}

exit (main ());
