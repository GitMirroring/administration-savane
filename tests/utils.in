use strict;
use warnings;
use Savane::Version;
use Savane::Test;
use WWW::Mechanize;

PrintVersionOrHelp ("Test internal functions.");

my $unix_group_name = 'administration';
my $exit_code = 2;

my $agent = make_agent () or exit (1);

sub install_test_php
{
  my $text = `cat utils.php`;
  return unless write_test_php ('test.php', $text);
  print_test_error ("Cannot install test.php.");
  exit (1);
}

sub inspect_test_page
{
  return 1 unless $exit_code == 2;
  print_test_log ("Visiting test.php.");
  $agent->get (make_url ('test.php'));
  return 1 if check_request_status ($agent, 'utils.html');
  my $text = $agent->content (raw => 1);
  $text =~ s/\s*$//s;
  my $ret = $text =~ m/'^!'/m;
  print_test_log ("Test results follow.");
  print_test_result ("$text", $ret);
  print_test_log ("End of test results.");
  return $ret;
}

install_test_php ();
$exit_code = 1 if inspect_test_page ();
$exit_code = 0 if $exit_code == 2;
print_test_result ("Test done.") unless $exit_code;
exit ($exit_code);
