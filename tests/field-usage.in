use strict;
use warnings;
use Savane::Version;
use Savane::Test;
use WWW::Mechanize;

PrintVersionOrHelp ("Test field usage manipulation.");

my $agent = make_agent ();
my $group = 'administration';
my $have_logged_in = 0;

sub my_log_in
{
  log_in ($agent);
  $have_logged_in = 1;
}

sub my_log_out
{
  log_out ($agent);
  $have_logged_in = 0;
}

sub finalize
{
  my_log_out () if $have_logged_in;
  print_test_result ('Test done.') unless shift;
}

sub find_the_form
{
  print_test_log ('Looking for usage update form.');
  my $form = $agent->form_with_fields (
    qw (form_id group_id status post_changes field)
  );
  if (!defined ($form))
    {
      print_test_error ("Form not found.");
      exit (1);
    }
  return $form;
}

my_log_in ();
print_test_log ("Visiting field usage page.");
$agent->get (make_url ("task/admin/field_usage.php?group=$group"));
print_test_log ("Looking for originator phone link.");
my $link = $agent->find_link (text => 'Originator Phone');
if (!defined ($link))
  {
    print_test_error ("Link not found");
    exit (1);
  }
my $field_usage_url = $link->url ();
my $broken_field = 'no-such-field';
my $broken_url = $field_usage_url;
$broken_url =~ s/([?&])field=[^&]*([&]|$)/$1field=$broken_field$2/;
print_test_log ("Trying non-existing field '$broken_field'.");
check_inaccessibility (unmake_url ($broken_url), '-');
print_test_log ("Visiting field usage edit page.");
print_test_log ("Trying originator phone link.");
$agent->get ($field_usage_url);
my $form = find_the_form ();
my %form_settings = $form->form;
my $group_id = $form_settings{'group_id'};
print_test_result ('Current fields:');
print_test_result ("  $_ => " . $form_settings{$_})
  foreach (keys %form_settings);
my @modified_fields = qw (n1 n2 place);
my %saved_settings;
$saved_settings{$_} = $form_settings{$_} foreach @modified_fields;
my @checkboxes = $form->find_input (undef, 'checkbox');
my %saved_checkboxes;
foreach (@checkboxes)
  {
    $saved_checkboxes{$_->name} = $_->value;
  }
print_test_result ("Checkboxes:");
print_test_result (
  "  $_ => " . (defined ($saved_checkboxes{$_})? $saved_checkboxes{$_}: 'undef')
)
  foreach (keys %saved_checkboxes);
print_test_log ('Modifying settings.');
$form->find_input ('#status', 'checkbox')->check ();
foreach (@modified_fields)
  {
    my $input = $form->find_input ("#$_");
    $input->value ($input->value + 1);
  }
$agent->click ();
print_test_log ('Checking modified settings.');
$agent->get ($field_usage_url);
$form = find_the_form ();
%form_settings = $form->form;
my $exit_code = 0;
foreach (@modified_fields)
  {
    my $val = $form->find_input ("#$_")->value;
    my $remark = ' OK ';
    if ($val != $saved_settings{$_} + 1)
      {
        $remark = 'FAIL';
        $exit_code = 1;
      }
    print_test_result ("[$remark] $_ => $val", $remark ne ' OK ');
  }
if ($form->find_input ('#status', 'checkbox')->value)
  {
    print_test_result ('Status has been set successfully.');
  }
else
  {
    print_test_error ('Status has not been set correctly.');
    $exit_code = 1;
  }
my %other_checkboxes = %saved_checkboxes;
delete $other_checkboxes{'status'};
print_test_log ('Verifying other checkboxes:');
foreach (keys %other_checkboxes)
  {
    my $val = $form->find_input ("#$_", 'checkbox')->value;
    my $saved = $other_checkboxes{$_};
    my $pref = "  $_";
    $saved = 0 unless defined ($saved);
    $val = 0 unless defined ($val);
    if ($val == $saved)
      {
        print_test_result ("$pref OK");
        next;
      }
    print_test_error ("$pref was unintendedly modified");
    $exit_code = 1;
  }
print_test_log ('Reverting settings.');
$agent->get ($field_usage_url);
$form = find_the_form ();
foreach (keys %saved_checkboxes)
  {
    my $input = $form->find_input ("#$_", 'checkbox');
    if (defined $saved_checkboxes{$_})
      {
        $input->check ();
      }
    else
      {
        $input->value (undef);
      }
  }
foreach (@modified_fields)
  {
    my $input = $form->find_input ("#$_");
    $input->value ($saved_settings{$_});
  }
$agent->click ();
exit ($exit_code);
END { finalize ($exit_code); }
